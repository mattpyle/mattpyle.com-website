{
  "redirects": [
    { "source": "/agent-traffic", "destination": "/activity/", "permanent": false },
    { "source": "/agent-traffic/", "destination": "/activity/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/a2a+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/agent-skills/index.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/agent-skills/:skill/SKILL.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </agents.md>; rel=\"describedby\"; type=\"text/markdown\", </.well-known/agent-card.json>; rel=\"service-desc\"; type=\"application/a2a+json\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Link", "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/about/",
      "headers": [
        { "key": "Link", "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/activity",
      "headers": [
        { "key": "Link", "value": "</activity.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/activity/",
      "headers": [
        { "key": "Link", "value": "</activity.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/projects",
      "headers": [
        { "key": "Link", "value": "</projects.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/projects/",
      "headers": [
        { "key": "Link", "value": "</projects.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/scorecard",
      "headers": [
        { "key": "Link", "value": "</scorecard.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/scorecard/",
      "headers": [
        { "key": "Link", "value": "</scorecard.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/steward",
      "headers": [
        { "key": "Link", "value": "</steward.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/steward/",
      "headers": [
        { "key": "Link", "value": "</steward.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/webmcp",
      "headers": [
        { "key": "Link", "value": "</webmcp.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/webmcp/",
      "headers": [
        { "key": "Link", "value": "</webmcp.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/writing",
      "headers": [
        { "key": "Link", "value": "</writing.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/writing/",
      "headers": [
        { "key": "Link", "value": "</writing.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/changelog",
      "headers": [
        { "key": "Link", "value": "</changelog.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/changelog/",
      "headers": [
        { "key": "Link", "value": "</changelog.md>; rel=\"alternate\"; type=\"text/markdown\"" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/writing/:slug([^/.]+)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/writing/:slug([^/.]+)/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/changelog/:slug([^/.]+)",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/changelog/:slug([^/.]+)/",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}

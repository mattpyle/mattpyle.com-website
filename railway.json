{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "agents/steward/Dockerfile",
    "watchPatterns": [
      "agents/steward/**",
      "package.json",
      "package-lock.json",
      "railway.json",
      ".dockerignore"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}

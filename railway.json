{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "agents/steward/Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run worker:hosted --workspace @mattpyle/steward",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}

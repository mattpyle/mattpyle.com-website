{
  "name": "@mattpyle/steward",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "steward": "./scripts/steward.mjs"
  },
  "//exports": "One entry, and only one: the fast-tier audit the site's /mcp function serves. Steward has no build step, so this points at TypeScript source and the site's Vite build transpiles it (astro.config.mjs lists the package in ssr.noExternal). Adding an entry here is adding a public surface, and every new one is a new import graph the site's function bundle inherits — see the docblock in src/lib/agent-audit/fast.ts and tests/steward-fast-audit-packaging.test.mjs in the site repo.",
  "exports": {
    "./agent-audit/fast": {
      "types": "./src/lib/agent-audit/fast.ts",
      "default": "./src/lib/agent-audit/fast.ts"
    }
  },
  "scripts": {
    "worker": "tsx src/worker.ts",
    "steward": "tsx src/cli.ts",
    "setup:vale": "node scripts/setup-vale.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check:html-report": "tsx scripts/axe-html-report.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.3",
    "@axe-core/cli": "4.12.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@temporalio/activity": "1.20.3",
    "@temporalio/client": "1.20.3",
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "chrome-launcher": "1.2.1",
    "commander": "15.0.0",
    "cspell": "10.0.1",
    "cspell-lib": "10.0.1",
    "gray-matter": "4.0.3",
    "lighthouse": "13.4.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "undici": "^7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@temporalio/testing": "1.20.3",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}

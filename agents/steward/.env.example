# Copy to agents/steward/.env and fill in. Never commit .env.
# Phase 1a needs NONE of these — the defaults in src/config.ts are correct for
# this machine and no activity makes a network or LLM call yet. They are listed
# now so later phases have one documented place to look.

# SECRETS AS 1PASSWORD REFERENCES. Each secret line below can hold a reference instead of a value:
#   VARIABLE=op://Steward/<ITEM>/<field>
# The `steward` command finds each op:// line in this file whose variable the shell has not set,
# puts the reference into the child's environment and runs the CLI under `op run --`, so 1Password
# swaps the reference for its value. A variable already set in the shell wins over this file,
# as it does for plain values. No value sits in this file. A line with a plain value still works.
# Run Steward through `steward <verb>` (after `npm link` in agents/steward). `npx tsx` and
# `node --env-file` skip `op run`, and the process then stops with a message naming the variable.
# The secrets are: ANTHROPIC_API_KEY, STEWARD_GITHUB_APP_PRIVATE_KEY, VERCEL_AUTOMATION_BYPASS_SECRET,
# STEWARD_WEB_BOT_AUTH_KEY, TEMPORAL_API_KEY, TEMPORAL_METRICS_API_KEY, TEMPORAL_READ_ONLY_API_KEY.
# Everything else (ids, addresses, paths, switches) stays a plain value.
# The hosted worker on Railway has no `op`; it holds real values as Railway variables.

# ANTHROPIC_API_KEY=                  # op://Steward/ANTHROPIC_API_KEY/credential
# STEWARD_GITHUB_APP_ID=              # the GitHub App Steward acts as. Its installation token (one hour, minted from the
# STEWARD_GITHUB_APP_PRIVATE_KEY=     # id and key, never stored) replaces a personal token. The key is the app's PEM as
#                                     # ONE line of base64 (`[Convert]::ToBase64String([IO.File]::ReadAllBytes('key.pem'))`
#                                     # in PowerShell). Reference: op://Steward/STEWARD_GITHUB_APP_PRIVATE_KEY/credential. Install the app once, on the account that owns both repositories,
#                                     # with: Contents, Pull requests and Issues read and write; Deployments, Checks and
#                                     # Actions read. The hosted worker holds the same two values as Railway variables.
# STEWARD_GITHUB_APP_INSTALLATION_ID= # optional: only when the app is installed on more than one account. Unset, the
#                                     # app's single installation is used; with several, startup fails and lists them.
# VERCEL_AUTOMATION_BYPASS_SECRET=    # op://Steward/VERCEL_AUTOMATION_BYPASS_SECRET/credential. The site project's Protection Bypass for Automation secret: the preview test
#                                     # fetches a fix PR's Vercel preview past Vercel Authentication. The hosted worker
#                                     # needs it too: without it the lifecycle records the preview as unmeasured

# STEWARD_SITE_DIR=C:\Users\mattp\projects\mattpyle.com-website
# STEWARD_WORKTREE_DIR=C:\Users\mattp\projects\mattpyle.com-steward-worktree
# STEWARD_PROD_ORIGIN=https://www.mattpyle.com
# STEWARD_MODEL=claude-sonnet-4-6
# STEWARD_GITHUB_REPO=mattpyle/mattpyle.com-website

# STEWARD_WEB_BOT_AUTH_KEY=           # the auditor's Ed25519 signing key, one line of private JWK JSON, from
#                                     # `steward keys generate`. Set: every request SafeFetcher makes carries a
#                                     # Web Bot Auth signature. Empty: requests go unsigned, as before.
#                                     # Reference: op://Steward/STEWARD_WEB_BOT_AUTH_KEY/credential. The hosted
#                                     # worker holds the same value as a Railway variable.

# TEMPORAL_API_KEY=                   # op://Steward/TEMPORAL_API_KEY/credential
# TEMPORAL_METRICS_API_KEY=           # op://Steward/TEMPORAL_METRICS_API_KEY/credential
# TEMPORAL_READ_ONLY_API_KEY=         # op://Steward/TEMPORAL_READ_ONLY_API_KEY/credential. Optional: the read-only key kept for diagnostics; `steward up` refuses to start when TEMPORAL_API_KEY in the shell holds this same value

# SDK metrics to Grafana Cloud over OTLP/HTTP. All three set means on; any unset means off.
# STEWARD_METRICS_OTLP_URL=           # The gateway URL ending /v1/metrics, such as https://otlp-gateway-<region>.grafana.net/otlp/v1/metrics. Not the /otlp base.
# STEWARD_METRICS_OTLP_USER=          # The Grafana instance id
# STEWARD_METRICS_OTLP_TOKEN=         # op://Steward/STEWARD_METRICS_OTLP_TOKEN/credential. The hosted worker holds the same value as a Railway variable.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# STEWARD_LOG_LEVEL=info

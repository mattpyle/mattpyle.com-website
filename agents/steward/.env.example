# Copy to agents/steward/.env and fill in. Never commit .env.
# Phase 1a needs NONE of these — the defaults in src/config.ts are correct for
# this machine and no activity makes a network or LLM call yet. They are listed
# now so later phases have one documented place to look.

# ANTHROPIC_API_KEY=
# STEWARD_GITHUB_APP_ID=              # the GitHub App Steward acts as. Its installation token (one hour, minted from the
# STEWARD_GITHUB_APP_PRIVATE_KEY=     # id and key, never stored) replaces a personal token. The key is the app's PEM as
#                                     # ONE line of base64 (`[Convert]::ToBase64String([IO.File]::ReadAllBytes('key.pem'))`
#                                     # in PowerShell). Install the app once, on the account that owns both repositories,
#                                     # with: Contents, Pull requests and Issues read and write; Deployments, Checks and
#                                     # Actions read. The hosted worker holds the same two values as Railway variables.
# STEWARD_GITHUB_APP_INSTALLATION_ID= # optional: only when the app is installed on more than one account. Unset, the
#                                     # app's single installation is used; with several, startup fails and lists them.
# VERCEL_AUTOMATION_BYPASS_SECRET=    # the site project's Protection Bypass for Automation secret: the preview test
#                                     # fetches a fix PR's Vercel preview past Vercel Authentication. The hosted worker
#                                     # needs it too: without it the lifecycle records the preview as unmeasured

# STEWARD_SITE_DIR=C:\Users\mattp\projects\mattpyle.com-website
# STEWARD_WORKTREE_DIR=C:\Users\mattp\projects\mattpyle.com-steward-worktree
# STEWARD_PROD_ORIGIN=https://www.mattpyle.com
# STEWARD_MODEL=claude-sonnet-4-6
# STEWARD_GITHUB_REPO=mattpyle/mattpyle.com-website

# STEWARD_WEB_BOT_AUTH_KEY=           # the auditor's Ed25519 signing key, one line of private JWK JSON, from
#                                     # `steward keys generate`. Set: every request SafeFetcher makes carries a
#                                     # Web Bot Auth signature. Empty: requests go unsigned, as before. The hosted
#                                     # worker holds the same value as a Railway variable.

# TEMPORAL_READ_ONLY_API_KEY=         # optional: the read-only key kept for diagnostics; `steward up` refuses to start when TEMPORAL_API_KEY in the shell holds this same value
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# STEWARD_LOG_LEVEL=info

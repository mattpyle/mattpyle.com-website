# Copy to .env.local and fill in. Never commit a filled-in copy.

# The model API key the benchmark agent runs on. Set the one matching BENCHMARK_MODEL's
# provider prefix: DEEPSEEK_API_KEY for deepseek:* (the default), GOOGLE_API_KEY (or
# GEMINI_API_KEY) for google:*, ANTHROPIC_API_KEY for anthropic:*. Deepseek keys are at
# https://platform.deepseek.com; Gemini keys are free at https://aistudio.google.com.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Temporal Cloud. Set the key and the address of your namespace endpoint to run on Cloud;
# leave the key empty to use the local dev server, which is the default and the debug path.
# TEMPORAL_API_KEY=
# TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account>

# Optional. Defaults shown.
# BENCHMARK_MODEL=deepseek:deepseek-v4-flash
# Gemini instead: BENCHMARK_MODEL=google:gemini-3.5-flash
# Anthropic instead: BENCHMARK_MODEL=anthropic:claude-sonnet-5
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# Path to the frozen task pack markdown. Defaults to the copy in this repository.
# BENCHMARK_TASK_PACK=

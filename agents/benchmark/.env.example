# Copy to .env.local and fill in. Never commit a filled-in copy.

# The model API key the benchmark agent runs on. Set the one matching BENCHMARK_MODEL's
# provider prefix: ANTHROPIC_API_KEY for anthropic:*, GOOGLE_API_KEY (or GEMINI_API_KEY)
# for google:*. Gemini keys are free at https://aistudio.google.com.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional. Defaults shown.
# BENCHMARK_MODEL=anthropic:claude-sonnet-5
# Gemini instead: BENCHMARK_MODEL=google:gemini-3.5-flash
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# Path to the frozen task pack markdown. Defaults to the copy in this repository.
# BENCHMARK_TASK_PACK=

---
import Layout from '../layouts/Layout.astro';
import ScorecardHero from '../components/scorecard/ScorecardHero.astro';
import ScorecardBody from '../components/scorecard/ScorecardBody.astro';
import { SCORECARD } from '../data/scorecard';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null.
const markdownUrl = markdownSiblingFor('/scorecard/') ?? undefined;

/**
 * PRERENDERED, as of the scorecard/activity redesign.
 *
 * This page ran per request from 2026-08-06 until now, and its own docblock said why: the Agent
 * traffic section read the hit store at request time, and nothing else on the page did. That
 * section is now /activity, which takes `prerender = false` in its place, so the reason is gone
 * and the default comes back with it. Four things that had to grow an on-demand branch for this
 * page lose it again: the sitemap integration's `customPages`, scripts/validate-sitemap.mjs, the
 * markdown-sibling emit step (src/pages/scorecard.md.ts is deleted — the converter now has a built
 * HTML file to work from, like every other non-entry page), and scripts/serve-built-site.mjs.
 *
 * Every value on this page comes from committed JSON (src/data/scorecard-runs.json), so a
 * prerender is not merely allowed here, it is the honest shape: the content changes when a run
 * lands, and a run landing is a deploy.
 */
export const prerender = true;
---
<Layout
  title="Scorecard: accessibility, performance, and SEO"
  description={SCORECARD.description}
  markdownAlternate={markdownUrl}
>
  {/*
    ONE SCORECARD, styled twice. Until 2026-08-29 this page shipped its content twice — the
    redesigned tree marked `.modern-skin` and a hand-written legacy shell marked `.retro-skin`, with
    CSS choosing one per appearance. The shell and this page's whole scoped style block are deleted;
    ScorecardHero and ScorecardBody are the page in both appearances, and retro restyles them in
    place under `[data-module='scorecard-hero']` and `[data-module='scorecard-body']` in
    src/styles/retro.css.

    Retro takes the modern tree's content in the swap, which is the rule every surface in this
    conversion has followed. The visible cost here is the run-history disclosure: the legacy tree
    listed each run in a `<details>` that opened onto its scope, tools, entry and commentary, and
    ScorecardBody's flat list prints the commentary inline instead. Nothing on this page expands in
    either appearance now.
  */}
  <ScorecardHero />
  <ScorecardBody />
</Layout>


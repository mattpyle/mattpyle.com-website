---
import Layout from '../layouts/Layout.astro';
import { SCORECARD, SCORECARD_HISTORY } from '../data/scorecard';
import {
  MAX_TABLE_ROWS,
  flattenDayHashes,
  hourStart,
  readAgentTraffic,
  summarizeTraffic,
} from '../lib/agent-traffic.mjs';
// The store counts the page path a client asked for; the table shows the URL that answered, so a
// row reads as the markdown document it was. Same function the middleware derives the sibling
// with, so the two can never disagree about what /about's markdown is called.
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

/**
 * On demand, for the Agent traffic section alone.
 *
 * Everything above and below that section still renders from committed JSON (src/data/
 * scorecard-runs.json) and would prerender perfectly happily; the store read is the only reason
 * this page runs per request. The cost is paid deliberately and it is not free — a prerendered
 * /scorecard is a file the sitemap validator, the markdown-sibling emit step and every local audit
 * could all assume existed. Each of those now has an explicit on-demand branch; see
 * scripts/validate-sitemap.mjs, src/pages/scorecard.md.ts and scripts/serve-built-site.mjs.
 *
 * The resilience is the CDN, not a retry: s-maxage plus a day of stale-while-revalidate means a
 * store outage shorter than the window serves the last good numbers, and only past it does the
 * section show its unavailable state. The conformance sections render either way.
 */
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const currentPasses = SCORECARD.metrics.filter(metric => metric.status === 'Pass').length;
const historyPageSize = 20;

// One clock for the whole render, so the windows and the "rendered at" stamp cannot disagree.
const renderedAt = new Date();
const traffic = await readAgentTraffic({ now: renderedAt });
const summary = traffic.ok ? summarizeTraffic(flattenDayHashes(traffic.dayHashes), renderedAt) : null;

const counts = new Intl.NumberFormat('en-GB');

// Timestamps ship as UTC and are localised in the browser (see the script at the foot of this
// file). Without JS they read as labelled UTC, which is true rather than merely tolerable; with
// it, they read in the visitor's own zone. Either way the cached HTML is identical for everyone,
// which is what lets this page be cached at all.
const utcStamp = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
  timeZoneName: 'short',
});

// The table's own stamp, one per row: no year, because a column of them is furniture rather than
// reading and the full instant is in the `datetime` attribute regardless. The zone label stays:
// this cell says UTC before the script runs and local after it, and a reader who cannot tell
// which is looking at a number that means nothing.
const utcStampCompact = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
  timeZoneName: 'short',
});

/** The hour a bucket started, as an instant. Hour resolution is all the store keeps. */
function bucketStamp(hour: number): { iso: string; label: string } {
  const at = hourStart(hour);
  return { iso: at.toISOString(), label: utcStampCompact.format(at) };
}

const renderedStamp = { iso: renderedAt.toISOString(), label: utcStamp.format(renderedAt) };

/**
 * What the section says when it has no numbers. Three states, not two: "no store configured" and
 * "the store did not answer" are the same blank space on the page and completely different
 * findings, and only the second can happen in production. The first is what a local build looks
 * like, and saying the store failed there would be a small lie told on every preview.
 */
const emptyStateCopy = traffic.ok
  ? 'Counting is running and nothing has been counted yet. The first agent request to a discovery document fills this in.'
  : traffic.reason === 'no-store'
    ? 'No counter store is configured in this environment, so there is nothing to read. That is a local build; production reads the live store.'
    : 'Live counts are unavailable right now: the store did not answer this render. Nothing above or below this section depends on it.';

// Two families are not crawler names and read as jargon without a gloss.
const FAMILY_NOTES: Record<string, string> = {
  none: 'sent no user agent',
  other: 'unrecognised',
  'other-bot': 'says it is a bot, unnamed here',
};

const DEFAULT_CURRENT_COMMENTARY =
  'The lowest result across the tested pages is shown for each category. A pass means the ' +
  'category met its existing scorecard rule, not that the site is free of defects.';
const currentCommentary = SCORECARD.commentary?.trim() || DEFAULT_CURRENT_COMMENTARY;

function shortMetricName(name: string): string {
  if (name === 'Accessibility') return 'A11y';
  if (name === 'Agentic Browsing') return 'Agents';
  return name;
}
---

<Layout title="Scorecard" description={SCORECARD.description}>
  <div class="scorecard-shell" data-module="scorecard">
    <header class="scorecard-header">
      <p class="eyebrow">Public scorecard · live web</p>
      <h1 class="page-title">Scorecard</h1>
      <p class="description page-intro">
        The latest verified scores, followed by every live-network run we have recorded.
      </p>
    </header>

    <section class="latest-run" aria-labelledby="latest-run-title">
      <header class="run-header">
        <div>
          <p class="section-label">Latest run</p>
          <h2 id="latest-run-title">
            <time datetime={SCORECARD.verified.iso}>{SCORECARD.verified.label}</time>
          </h2>
          {SCORECARD.verified.timestamp && (
            <time class="latest-time" datetime={SCORECARD.verified.timestamp}>
              {SCORECARD.verified.timestamp}
            </time>
          )}
        </div>
        <p class="run-verdict">
          <span class="verdict-mark" aria-hidden="true"></span>
          <span><strong>{currentPasses} of {SCORECARD.metrics.length}</strong> gates passing</span>
        </p>
      </header>

      <div class="current-scores">
        {SCORECARD.metrics.map(({ name, value, maximum, status, description }) => (
          <article class={`current-score current-score--${status.toLowerCase()}`}>
            <div class="score-heading">
              <h3>{name}</h3>
              <span class={`status status--${status.toLowerCase()}`}>
                <span class="status-dot" aria-hidden="true"></span>{status}
              </span>
            </div>
            <p class="score-value">
              <span>{value}</span><small>/{maximum}</small>
            </p>
            <p class="score-description">{description}</p>
          </article>
        ))}
      </div>

      <div class="run-notes">
        <dl class="verification">
          <div>
            <dt>Scope</dt>
            <dd>{SCORECARD.scope}</dd>
          </div>
          <div>
            <dt>Tools</dt>
            <dd>{SCORECARD.tools.join(' · ')}</dd>
          </div>
          <div>
            <dt>Entry</dt>
            <dd>{SCORECARD.entry}</dd>
          </div>
        </dl>
        <p class="current-commentary">{currentCommentary}</p>
      </div>
    </section>

    <section id="agent-traffic" class="traffic" aria-labelledby="agent-traffic-title">
      <header class="traffic-header">
        <h2 id="agent-traffic-title">Agent traffic</h2>
        <p class="freshness">
          Rendered <time datetime={renderedStamp.iso} data-local-time>{renderedStamp.label}</time>
        </p>
      </header>

      {summary && summary.counted ? (
        <Fragment>
          <div class="traffic-panel">
            <div class="statrow">
              <div class="stat">
                <p class="label">Requests, last 24 hours</p>
                <p class="num">{counts.format(summary.totals.day)}</p>
              </div>
              <div class="stat">
                <p class="label">Requests, last 7 days</p>
                <p class="num">{counts.format(summary.totals.week)}</p>
              </div>
              <div class="stat">
                <p class="label">Requests, total</p>
                <p class="num">{counts.format(summary.totals.total)}</p>
              </div>
            </div>
          </div>

          <div class="subsect">
            <h3 id="traffic-surfaces-title">By surface</h3>
            {/*
              The scroll container, not `table { display: block }`: Chrome drops table semantics
              from the accessibility tree the moment a table stops being display: table, and this
              page's aria golden would be the thing that noticed. Focusable because a region that
              scrolls has to be reachable by keyboard.
            */}
            <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-surfaces-title">
            <table aria-labelledby="traffic-surfaces-title">
              <thead>
                <tr>
                  <th scope="col">Surface</th>
                  <th scope="col" class="n">7 days</th>
                  <th scope="col" class="n">30 days</th>
                  <th scope="col" class="n">Total</th>
                  <th scope="col">Last fetched</th>
                </tr>
              </thead>
              <tbody>
                {summary.surfaces.rows.map(row => (
                  <tr>
                    <td><code>{row.path}</code></td>
                    <td class="n">{counts.format(row.week)}</td>
                    <td class="n">{counts.format(row.month)}</td>
                    <td class="n">{counts.format(row.total)}</td>
                    <td>
                      <time datetime={bucketStamp(row.lastHour).iso} data-local-time="compact">
                        {bucketStamp(row.lastHour).label}
                      </time>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
            {summary.surfaces.omitted > 0 && (
              <p class="footnote">{summary.surfaces.omitted} further surface(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
            )}
          </div>

          <div class="subsect">
            <h3 id="traffic-clients-title">By client type</h3>
            <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-clients-title">
            <table aria-labelledby="traffic-clients-title">
              <thead>
                <tr>
                  <th scope="col">Client</th>
                  <th scope="col" class="n">7 days</th>
                  <th scope="col" class="n">30 days</th>
                  <th scope="col" class="n">Total</th>
                </tr>
              </thead>
              <tbody>
                {summary.clients.rows.map(row => (
                  <tr>
                    <td class="family">
                      {row.family}
                      {row.family && FAMILY_NOTES[row.family] && (
                        <span class="family-note"> ({FAMILY_NOTES[row.family]})</span>
                      )}
                    </td>
                    <td class="n">{counts.format(row.week)}</td>
                    <td class="n">{counts.format(row.month)}</td>
                    <td class="n">{counts.format(row.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
            {summary.clients.omitted > 0 && (
              <p class="footnote">{summary.clients.omitted} further client type(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
            )}
          </div>

          <div class="subsect">
            <h3 id="traffic-markdown-title">Markdown negotiation</h3>
            {summary.pages.rows.length > 0 ? (
              <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-markdown-title">
              <table aria-labelledby="traffic-markdown-title">
                <thead>
                  <tr>
                    <th scope="col">Page</th>
                    <th scope="col" class="n">7 days</th>
                    <th scope="col" class="n">30 days</th>
                    <th scope="col" class="n">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {summary.pages.rows.map(row => (
                    <tr>
                      <td><code>{markdownSiblingFor(row.path ?? '') ?? row.path}</code></td>
                      <td class="n">{counts.format(row.week)}</td>
                      <td class="n">{counts.format(row.month)}</td>
                      <td class="n">{counts.format(row.total)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
            ) : (
              <p class="traffic-empty">
                No page has been served as Markdown yet. Every page here has a Markdown
                representation and answers <code>Accept: text/markdown</code> with it; this row
                fills in the first time something asks.
              </p>
            )}
            {summary.pages.omitted > 0 && (
              <p class="footnote">{summary.pages.omitted} further page(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
            )}
          </div>
        </Fragment>
      ) : (
        <p class="traffic-unavailable">{emptyStateCopy}</p>
      )}
    </section>

    <section class="history" aria-labelledby="history-title">
      <header class="history-header">
        <div>
          <p class="section-label">Archive</p>
          <h2 id="history-title">Run history</h2>
        </div>
        <p>Newest first · {historyPageSize} runs per page</p>
      </header>

      <div class="history-columns" aria-hidden="true">
        <span>Run</span>
        {SCORECARD.metrics.map(metric => <span>{shortMetricName(metric.name)}</span>)}
        <span></span>
      </div>

      <div class="history-list">
        {SCORECARD_HISTORY.map(run => {
          const passes = run.metrics.filter(metric => metric.status === 'Pass').length;
          return (
            <details class="history-run" id={`run-${run.id}`}>
              <summary>
                {/*
                  One date per run, DD MMM YYYY. The raw ISO audit time used to render underneath
                  it, which made the one run that has a `timestamp` twice as tall as the four that
                  do not and put a machine string where a person reads. The exact instant is not
                  lost: it is the `datetime` attribute, which is where a machine looks anyway.
                */}
                <span class="history-date">
                  <time datetime={run.verified.timestamp ?? run.verified.iso}>{run.verified.label}</time>
                </span>

                {run.metrics.map(metric => (
                  <span
                    class="history-metric"
                    role="group"
                    aria-label={`${metric.name}: ${metric.value} of ${metric.maximum}, ${metric.status}`}
                  >
                    <span aria-hidden="true" class="history-metric-label">{shortMetricName(metric.name)}</span>
                    <span aria-hidden="true" class="history-number">{metric.value}<small>/{metric.maximum}</small></span>
                    <span aria-hidden="true" class={`history-status history-status--${metric.status.toLowerCase()}`}>
                      <span class="status-dot" aria-hidden="true"></span>{metric.status}
                    </span>
                  </span>
                ))}

                <span class="history-toggle">
                  <span class="history-result">{passes}/{run.metrics.length}</span>
                  <span class="chevron" aria-hidden="true"></span>
                </span>
              </summary>

              <div class="history-detail">
                <dl>
                  <div>
                    <dt>Scope</dt>
                    <dd>{run.scope}</dd>
                  </div>
                  <div>
                    <dt>Tools</dt>
                    <dd>{run.tools.join(' · ')}</dd>
                  </div>
                  <div>
                    <dt>Entry</dt>
                    <dd>{run.entry}</dd>
                  </div>
                </dl>
                <p>{run.commentary}</p>
              </div>
            </details>
          );
        })}
      </div>

      <footer class="history-footer">
        <span>Showing all {SCORECARD_HISTORY.length} previous runs</span>
        <nav aria-label="Scorecard history pagination">
          <span class="page-link page-link--disabled" aria-disabled="true">← Newer</span>
          <span class="page-number" aria-current="page">Page 1</span>
          <span class="page-link page-link--disabled" aria-disabled="true">Older →</span>
        </nav>
      </footer>
    </section>
  </div>
</Layout>

<style>
  .scorecard-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 64px var(--gutter) 88px;
  }

  .scorecard-header { max-width: 720px; }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .description {
    margin: 18px 0 40px;
  }

  .latest-run {
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-heading);
    box-shadow: 0 16px 40px rgba(35, 31, 24, .045);
  }

  .run-header,
  .history-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .run-header { padding: 24px 28px 22px; }

  .section-label {
    margin: 0 0 7px;
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .run-header h2,
  .traffic-header h2,
  .history-header h2 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -.015em;
    line-height: 1.1;
  }

  .latest-time {
    display: block;
    margin: 5px 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 8.5px;
  }

  .run-verdict {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 2px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .run-verdict strong { color: var(--color-heading); font-weight: 600; }

  .verdict-mark {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-status-green);
    box-shadow: 0 0 0 4px rgba(92, 122, 83, .12);
  }

  .current-scores {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .current-score {
    position: relative;
    min-width: 0;
    padding: 22px 20px 24px;
    border-right: 1px solid var(--color-border);
  }

  .current-score:last-child { border-right: 0; }

  .current-score::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-status-green);
    content: '';
  }

  .current-score--fail::before { background: var(--color-accent); }
  .current-score--partial::before { background: var(--color-sig-minor); }

  .score-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .score-heading h3 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .status,
  .history-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-status-green);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: .06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .history-status { color: #48623f; }

  .status--fail,
  .history-status--fail { color: var(--color-accent); }

  .status--partial,
  .history-status--partial { color: var(--color-sig-minor); }

  .status-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .score-value {
    margin: 18px 0 13px;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .85;
    white-space: nowrap;
  }

  .score-value small,
  .history-number small {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .score-description {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-system);
    font-size: 11.5px;
    line-height: 1.55;
  }

  .run-notes {
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    gap: 28px;
    padding: 22px 28px 24px;
  }

  .verification {
    display: grid;
    grid-template-columns: .8fr 1.35fr 1fr;
    gap: 20px;
    margin: 0;
  }

  .verification div,
  .history-detail dl div { min-width: 0; }

  .verification dt,
  .history-detail dt {
    margin-bottom: 6px;
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .verification dd,
  .history-detail dd {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.5;
  }

  .current-commentary {
    margin: 0;
    padding-left: 18px;
    border-left: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 12.5px;
    font-style: italic;
    line-height: 1.55;
  }

  /* ── Agent traffic ─────────────────────────────────────────────────── */

  .traffic { margin-top: 60px; }

  .traffic-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }

  .freshness {
    margin: 0 0 3px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.6;
    text-align: right;
  }

  .traffic-panel {
    overflow: hidden;
    margin-bottom: 34px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-heading);
    box-shadow: 0 16px 40px rgba(35, 31, 24, .045);
  }

  .statrow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .stat {
    min-width: 0;
    padding: 22px 20px 24px;
    border-right: 1px solid var(--color-border);
  }

  .stat:last-child { border-right: 0; }

  .stat .label {
    margin: 0 0 16px;
    color: var(--color-heading);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .stat .num {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .85;
  }

  .subsect { margin-bottom: 30px; }

  .subsect h3 {
    margin: 0 0 10px;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
  }

  /* The one place a table is allowed to be wider than the page. */
  .table-scroll { overflow-x: auto; }

  .table-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .traffic table {
    width: 100%;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-collapse: collapse;
    font-size: 13px;
  }

  .traffic thead th {
    padding: 10px 14px;
    border-bottom: 2px solid var(--color-heading);
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 400;
    letter-spacing: .12em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Shrink the numeric columns to their content so the numbers sit beside the row they belong to
     rather than drifting into the middle of a wide column. The first column takes the slack. */
  .traffic th.n,
  .traffic td.n {

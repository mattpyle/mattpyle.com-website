<script>
  /**
   * Localise the Agent traffic timestamps.
   *
   * The page is cached and served byte-identically to everyone, so the server cannot know the
   * reader's timezone and must not try: every stamp ships as UTC, labelled UTC, correct with no
   * JavaScript at all. This rewrites the visible text to the reader's own zone; the `datetime`
   * attribute, which is the machine-readable value and the one an agent reads, is never touched.
   *
   * Bound to astro:page-load rather than run once, because ClientRouter soft-navigates into this
   * page without a fresh document (see the other components in src/components).
   */
  function localiseTimes(): void {
    const base = {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
    } as const;
    // `data-local-time="compact"` drops the year, mirroring the two server-side formatters: one
    // stamp for the whole page wants it, a column of them does not.
    const local = new Intl.DateTimeFormat(undefined, { ...base, year: 'numeric' });
    const localCompact = new Intl.DateTimeFormat(undefined, base);

    for (const element of document.querySelectorAll<HTMLTimeElement>('time[data-local-time]')) {
      const iso = element.getAttribute('datetime');
      if (!iso) continue;
      const at = new Date(iso);
      if (Number.isNaN(at.getTime())) continue;
      const format = element.dataset.localTime === 'compact' ? localCompact : local;
      element.textContent = format.format(at);
    }
  }

  document.addEventListener('astro:page-load', localiseTimes);
</script>

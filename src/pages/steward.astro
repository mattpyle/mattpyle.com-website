---
/**
 * /steward — the page the auditor's User-Agent points at.
 *
 * Who this page is for, in the order they arrive: a site owner who found `steward-audit` in an
 * access log and followed the URL in the string; an agent or a person deciding whether to call the
 * public endpoint; and Matt. The first of those decides the running order — the log identity comes
 * before what Steward is, because somebody who is mid-investigation should not have to read a
 * paragraph of positioning before finding the row that says what fetched their site.
 *
 * Nothing on this page restates a number that code already holds, except where it cannot. The rate
 * limits are resolved through src/lib/mcp-rate-limit.mjs's own resolvers, so the table shows what
 * this deployment enforces rather than what the defaults say. The check list is
 * src/data/steward-audit-checks.mjs, a copy of Steward's own specs guarded by a test on the
 * workspace side; that file's docblock explains why a copy is the only option. The User-Agent is
 * the one string typed out here, for the reason its own comment gives, and it is pinned by
 * tests/steward-page.test.mjs.
 */
import Layout from '../layouts/Layout.astro';
import StewardHero from '../components/steward/StewardHero.astro';
import StewardBody from '../components/steward/StewardBody.astro';
import { STEWARD_FAST_CHECKS, STEWARD_CHECK_CATEGORIES } from '../data/steward-audit-checks.mjs';
import { readLimits, readDeepLimits } from '../lib/mcp-rate-limit.mjs';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null.
const markdownUrl = markdownSiblingFor('/steward/') ?? undefined;

/**
 * The User-Agent verbatim, character for character, including the version.
 *
 * This is the string a site owner will paste into a search box or match against a log line, so a
 * paraphrase or a stale version number here is the one error on this page that actively wastes
 * somebody's time. It cannot be imported: the constant lives in `@mattpyle/steward`, whose exports
 * map publishes exactly one entry for exactly one consumer (src/pages/mcp.ts), and a prerendered
 * page importing the workspace would put it in the static build's graph. tests/steward-page.test.mjs
 * reads both files and fails if they disagree.
 */
const USER_AGENT = 'steward-audit/0.2.0 (+https://www.mattpyle.com/steward)';
const AGENT_TOKEN = 'steward-audit';
const ENDPOINT = 'https://www.mattpyle.com/mcp';
const ISSUES_URL = 'https://github.com/mattpyle/mattpyle.com-website/issues';

/**
 * The caps this deployment actually enforces, not the compile-time defaults.
 *
 * Read through the limiter's own resolvers, so the page cannot disagree with the code that refuses
 * a caller. Production has run `MCP_DEEP_RATE_PER_CALLER=4` since 2026-08-16 while this table said
 * 2, which is the harmless direction of wrong and still the one thing the page exists to get right.
 * The page prerenders on Vercel, where the project's environment variables are set at build time; a
 * build without them renders the same defaults it always did.
 */
const fastLimits = readLimits(process.env);
const deepLimits = readDeepLimits(process.env);

const windowHours = fastLimits.windowSeconds / 3600;

const byCategory = STEWARD_CHECK_CATEGORIES.map(category => ({
  ...category,
  checks: STEWARD_FAST_CHECKS.filter(check => check.category === category.id),
}));

const windowLabel = windowHours === 1 ? 'One hour' : `${windowHours} hours`;

/**
 * The four rate-limit rows, built once so the redesigned table and the legacy one cannot disagree
 * about what this deployment enforces.
 */
const limitRows = [
  { tier: 'Fast', scope: 'Per caller', cap: `${fastLimits.perCaller}`, window: windowLabel },
  { tier: 'Fast', scope: 'Everyone together', cap: `${fastLimits.globalPerDay}`, window: 'One UTC day' },
  { tier: 'Deep', scope: 'Per caller', cap: `${deepLimits.perCaller}`, window: 'One UTC day' },
  { tier: 'Deep', scope: 'Everyone together', cap: `${deepLimits.globalPerDay}`, window: 'One UTC day' },
];

const refusalSnippet = `User-agent: ${AGENT_TOKEN}\nDisallow: /`;

const callSnippet = `curl -sS ${ENDPOINT} \\
  -H 'Content-Type: application/json' \\
  -H 'Accept: application/json, text/event-stream' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/call",
       "params":{"name":"audit_site","arguments":{"url":"example.com"}}}'`;

const deepCallSnippet = `curl -sS ${ENDPOINT} \\
  -H 'Content-Type: application/json' \\
  -H 'Accept: application/json, text/event-stream' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/call",
       "params":{"name":"deep_audit","arguments":{"url":"example.com"}}}'`;

const title = 'Steward';
const seoTitle = 'Steward, the auditor that fetched your site';
const description =
  'Steward is the agent-readiness auditor behind the steward-audit User-Agent: what it checks, ' +
  'what one audit costs your site, how to refuse it, and how to run one yourself.';

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const personId = `${new URL('/', Astro.site).toString()}#person`;

const extraJsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${canonical}#techarticle`,
    headline: seoTitle,
    name: title,
    description,
    url: canonical,
    dateModified: '2026-08-22',
    author: { '@id': personId },
    publisher: { '@id': personId },
    mainEntityOfPage: canonical,
  },
  {
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the steward-audit User-Agent?',
        acceptedAnswer: {
          '@type': 'Answer',
          text:
            `${USER_AGENT} is an agent-readiness auditor run from mattpyle.com. Somebody asked it ` +
            'for a report on one site; it is not a crawler and it does not come back on a schedule.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I block the steward-audit auditor?',
        acceptedAnswer: {
          '@type': 'Answer',
          text:
            `Add "User-agent: ${AGENT_TOKEN}" and "Disallow: /" to your robots.txt. The auditor ` +
            'checks every URL against your rules before requesting it, so one audit then costs you ' +
            'a single robots.txt fetch and nothing else.',
        },
      },
    ],
  },
];
---

<Layout
  title={title}
  seoTitle={seoTitle}
  description={description}
  extraJsonLd={extraJsonLd}
  markdownAlternate={markdownUrl}
>
  {/*
    ONE STEWARD PAGE, styled by both appearances. This page shipped its content twice until
    2026-08-29 — StewardHero and StewardBody for modern, a `.retro-skin` div holding PageHeader and
    a hand-written legacy shell for retro — and CSS chose between them. Both are deleted and
    `src/styles/retro.css` restyles the markup below under `html[data-appearance='retro']`.

    Retro took the band structure in the swap, in place of the legacy question-and-answer prose
    layout. The section order is unchanged and no claim was dropped: StewardBody was written as a
    reskin of that page and its docblock says so.

    Every derived value — the User-Agent, the check list, the resolved caps — still arrives from
    this file, so the one surviving tree cannot disagree with what the deployment enforces.
  */}
  <StewardHero endpoint={ENDPOINT} />
  <StewardBody
    userAgent={USER_AGENT}
    agentToken={AGENT_TOKEN}
    endpoint={ENDPOINT}
    issuesUrl={ISSUES_URL}
    refusalSnippet={refusalSnippet}
    callSnippet={callSnippet}
    deepCallSnippet={deepCallSnippet}
    checkCount={STEWARD_FAST_CHECKS.length}
    byCategory={byCategory}
    limitRows={limitRows}
  />
</Layout>


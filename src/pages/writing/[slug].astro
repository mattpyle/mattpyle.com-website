---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostRail from '../../components/writing/PostRail.astro';
import { showDrafts } from '../../lib/show-drafts';
import { readingTimeLabel, readingTimeISO8601 } from '../../lib/reading-time';
import { formatSiteDate } from '../../lib/format-date.mjs';
import { splitTitleFill } from '../../lib/title-fill.mjs';

export async function getStaticPaths() {
  const articles = (await getCollection('writing', ({ data }) => showDrafts || !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  // The redesigned template ends on a "next" row, which is the next post DOWN
  // the same reverse-chronological list the index shows — the one you would read
  // after this one. The oldest post has none, and then the row is not rendered
  // rather than being rendered empty.
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: { article, nextArticle: articles[index + 1] ?? null },
  }));
}

const { article, nextArticle } = Astro.props;
const { Content, headings } = await render(article);

const { title, date, updated, description, image, seoTitle, seoDescription } = article.data;
const markdownUrl = `/writing/${article.id}.md`;
const canonicalUrl = new URL(`/writing/${article.id}/`, Astro.site).toString();
const articleBody = article.body ?? '';
const readingLabel = readingTimeLabel(articleBody);

// The trailing phrase that wears the hero fill. See src/lib/title-fill.mjs for
// the rule and for why it has an upper bound.
const { head: titleHead, fill: titleFill } = splitTitleFill(title);
---

<Layout
  title={title}
  seoTitle={seoTitle}
  description={description}
  seoDescription={seoDescription}
  type="article"
  image={image ?? `/og/writing/${article.id}.png`}
  publishedTime={date}
  modifiedTime={updated}
  readingTimeISO8601={readingTimeISO8601(articleBody)}
  noindex={article.data.draft}
  markdownAlternate={markdownUrl}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Writing', url: '/writing/' },
    { name: title, url: `/writing/${article.id}/` },
  ]}
>
  {/*
    ONE POST TEMPLATE, styled by both appearances.

    The head, the rail, the prose and the next-post row below are the page's
    whole body. Retro restyles this same markup under
    `html[data-appearance='retro'] [data-module='article']` in
    src/styles/retro.css — the legacy `.retro-skin` header and footer, and the
    ArticleActions section they carried, are deleted. The rail's four actions
    (view markdown, copy markdown, ask ChatGPT, ask Claude) are the only copy of
    them on the page now, which is why it is no longer hidden in retro.

    The guards below are `html:not([data-appearance='retro'])` on rules that
    still SPLIT the two appearances — the wrapper's own width, and the
    `.post-body` grid, which retro flattens to one column because a 210px sticky
    rail beside a parchment column is a re-layout retro never had. Rules that no
    longer differ carry no guard: there is no second tree left for them to
    protect.
  */}
  <article data-module="article" class="post">

    {showDrafts && article.data.draft && (
      <p class="draft-banner" role="status">DRAFT — not published, preview only</p>
    )}

    <div class="post-head rd-section">
      <a href="/writing/" class="post-back">&larr; all writing</a>
      <h1 class="post-title">
        {titleFill ? (
          <>{titleHead}{' '}<span class="rd-fill rd-fill--writing">{titleFill}</span></>
        ) : title}
      </h1>
      <p class="post-lead">{description}</p>
    </div>

    <div class="post-body">
      <PostRail
        date={date}
        readingLabel={readingLabel}
        headings={headings}
        markdownUrl={markdownUrl}
        canonicalUrl={canonicalUrl}
      />

      <div class="prose">
        <Content />
      </div>
    </div>

    {nextArticle && (
      <div class="post-next-wrap rd-section">
        <a href={`/writing/${nextArticle.id}/`} class="post-next">
          <span class="post-next-label">next &middot; {formatSiteDate(nextArticle.data.date)}</span>
          <span class="post-next-title">{nextArticle.data.title}</span>
        </a>
      </div>
    )}

  </article>
</Layout>

<style>
  /* ── The post template ───────────────────────────────────────────────────
     docs/projects/redesign/design-export/README.md §4.

     APPEARANCE-BLIND since 2026-08-29. Every rule below used to be guarded with
     `html:not([data-appearance='retro'])` so that retro could wear a second,
     legacy tree on this same document; that tree is deleted, so there is nothing
     left for the guards to protect. Retro repaints this markup in
     src/styles/retro.css under `[data-module='article']`, which is the prefix
     that outweighs the `[data-astro-cid-…]` Astro appends to each selector here.

     The wrapper is full-bleed and each block carries the shell itself. */
  [data-module="article"] {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .draft-banner {
    max-width: var(--shell);
    margin: 24px auto 0;
    /* The shell's gutter, so the banner lines up with the headline under it. */
    margin-inline: max(calc((100% - var(--shell)) / 2 + var(--shell-gutter)), var(--shell-gutter));
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--agents);
    background: var(--tint-agents);
    border: 1px solid var(--agents);
    border-radius: var(--radius);
    padding: 10px 16px;
  }

  .post-head { padding-top: 66px; }

  .post-back {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--writing);
  }

  .post-back:hover { color: var(--writing-hover); }

  .post-title {
    margin: 26px 0 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 5.6vw, 82px);
    line-height: 1;
    letter-spacing: -.035em;
    color: var(--ink);
    text-wrap: balance;
    animation: riseIn .7s ease .05s both;
  }

  .post-lead {
    margin: 30px 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.32;
    letter-spacing: -.02em;
    color: var(--ink-3);
    text-wrap: pretty;
    animation: riseIn .7s ease .12s both;
  }

  /* The two-column body. `.rd-section` deliberately NOT on this element: the
     rail and the prose are grid items, and a wrapper class that also sets
     `max-width` and `margin` is easier to read spelled out here. Retro keeps the
     two columns and dresses the rail as a sidebar panel. */
  .post-body {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--shell-gutter);
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    margin-top: 58px;
    padding-top: 34px;
    border-top: 1px solid var(--rule);
  }

  /* ── Prose body ───────────────────────────────────────────────────────────
     Lives in src/styles/global.css (loaded on every page via Layout) so the
     changelog entry page shares the identical treatment with no extra stylesheet
     request. Edit prose there, not here. */

  .post-next-wrap { margin-top: 76px; }

  .post-next {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 56px;
    align-items: baseline;
    padding: 30px 20px 34px;
    margin: 0 -20px;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: background 240ms ease;
  }

  .post-next:hover { background: var(--tint-writing); }

  .post-next-label {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .post-next-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 34px;
    line-height: 1.14;
    letter-spacing: -.025em;
  }

  /* One column below 900px: 210px of rail plus 68ch of prose stops fitting well
     before the 720px the rest of the redesign breaks at. */
  @media (max-width: 900px) {
    .post-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      margin-top: 44px;
    }

    .post-next {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }

  @media (max-width: 720px) {
    .post-head { padding-top: 36px; }

    /* Smaller than the desktop clamp's own floor. The fill span cannot wrap —
       that is what makes it one painted block — so the H1 has to be small enough
       that its longest unbreakable phrase still fits a 320px viewport. See
       src/lib/title-fill.mjs, which caps that phrase against this number. */
    .post-title {
      font-size: clamp(34px, 9vw, 48px);
      margin-top: 18px;
      letter-spacing: -.03em;
    }

    .post-lead {
      margin-top: 20px;
      font-size: 22px;
    }

    .post-back {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
      font-size: 16px;
    }

    .post-body { padding-inline: var(--shell-gutter-mobile); }

    .post-next-wrap { margin-top: 48px; }

    .post-next {
      padding: 22px 0 24px;
      margin: 0;
    }

    .post-next-label { font-size: 16px; }

    .post-next-title {
      font-size: 27px;
      line-height: 1.18;
    }
  }
</style>

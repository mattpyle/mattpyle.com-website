---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ChangelogLedger from '../../components/ChangelogLedger.astro';
import FilterPills from '../../components/FilterPills.astro';
import ChangelogHero from '../../components/changelog/ChangelogHero.astro';
import ChangelogLog from '../../components/changelog/ChangelogLog.astro';
import { showDrafts } from '../../lib/show-drafts';
import { compareChangelogEntries } from '../../lib/changelog-order';
import { markdownSiblingFor } from '../../lib/markdown-negotiation.mjs';

export const getStaticPaths = (async ({ paginate }) => {
  // Entries per ledger page. The year grouping is the visual scaffold; this is the
  // scaling one. Page 1 lives at /changelog (the rest param is undefined there);
  // older pages are /changelog/2, /changelog/3, … Tune this one number to taste —
  // nothing else needs to change. Kept high so the archive stays a single page until
  // the log actually grows (see CLAUDE.md "The /changelog collection"). Defined inside
  // getStaticPaths because Astro runs it in an isolated scope that can't see module
  // frontmatter consts.
  const PAGE_SIZE = 20;
  const entries = (await getCollection('changelog', ({ data }) => showDrafts || !data.draft))
    .sort(compareChangelogEntries);
  return paginate(entries, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

type Entry = Awaited<ReturnType<typeof getCollection<'changelog'>>>[number];
const { page } = Astro.props as { page: Page<Entry> };

const legend = [
  { significance: 'major', label: 'MAJOR' },
  { significance: 'minor', label: 'MINOR' },
  { significance: 'patch', label: 'PATCH' },
] as const;

// Matches the `type` enum in src/content.config.ts. Fixed list (not derived from
// the current page's entries) so the filter and its definitions stay stable across
// pagination, even if a given page happens not to contain every type.
const typeDefinitions = [
  { type: 'launch',     description: 'a new page, section, or capability going live' },
  { type: 'feature',    description: 'an enhancement to something that already existed' },
  { type: 'content',    description: 'a post, page, or other written artifact' },
  { type: 'infra',      description: 'tooling, performance, or engineering-only work' },
  { type: 'experiment', description: 'a deliberate test — outcome not guaranteed' },
] as const;

const typePills = [
  { value: 'all', label: 'ALL' },
  ...typeDefinitions.map(({ type, description }) => ({
    value: type,
    label: type.toUpperCase(),
    title: description,
  })),
];

// The same filter for the redesigned tree, lower-cased. Nothing in the redesign
// is set in caps — its mono is the nav's, the dates' and the paths', all of them
// lower — so an upper-cased row of filter labels would read as the small caps
// eyebrow constraint 2 removes.
const redesignedTypePills = typePills.map(pill => ({ ...pill, label: pill.label.toLowerCase() }));

// "showing X of Y": cumulative count through the current page. page.end is a
// 0-indexed inclusive index into the full list, so +1 is the running total shown.
const shownThrough = page.end + 1;
const isFirst = page.currentPage === 1;

// The newest entry in the WHOLE log, for the redesigned hero. Page one's first
// row is that entry, and every later page is a slice of the same sorted list, so
// page one is where it can be read off without a second getCollection call.
// `page.data[0]` on /changelog/2 is the newest entry on that page, not the log's.
const latest = isFirst ? (page.data[0]?.data.date ?? null) : null;

const description = "What's shipped on this site — launches, features, and the occasional experiment.";
// Meta-only. `description` above is the visible header subtitle and stays as written;
// this is the SERP-length variant (see the seoDescription prop in Layout.astro).
const seoDescription = 'Everything shipped on this site, newest first: launches, features, infrastructure work, and the occasional experiment that did not pan out.';
const breadcrumbUrl = isFirst ? '/changelog/' : `/changelog/${page.currentPage}/`;

// The page's markdown sibling, declared in the head by Layout. Derived from this page's own
// canonical path rather than a literal, so a paginated page advertises its own sibling and not
// page one's. If a second page ever exists, scripts/validate-markdown-siblings.mjs fails the
// build unless that sibling is emitted too, so this link cannot point at a 404 quietly.
const markdownUrl = markdownSiblingFor(breadcrumbUrl) ?? undefined;
---

<Layout
  title={isFirst ? 'Changelog: what has shipped on this site' : `Changelog: what has shipped, page ${page.currentPage}`}
  description={description}
  seoDescription={seoDescription}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Changelog', url: breadcrumbUrl }]}
  markdownAlternate={markdownUrl}
>
  {/*
    TWO LEDGERS IN ONE DOCUMENT, one shown per appearance — the same
    construction src/pages/index.astro and src/pages/writing/index.astro use, and
    for the same reason: the redesign rebuilds the MODERN appearance only, retro
    is a client-side preference the server cannot read, so both trees ship and
    CSS chooses. `.modern-skin` / `.retro-skin` in src/styles/retro.css do the
    choosing.

    A hidden subtree holds no tab stops and is absent from the accessibility
    tree, so each appearance presents exactly one ledger.

    Both take the same `page.data` slice in the same order, and both paginate
    against the same `page.url`. The redesigned tree drops the significance
    legend and the tag chips, which constraints 4 and 7 rule out; it keeps the
    type filter, restyled (see ChangelogLog.astro).
  */}
  <ChangelogHero total={page.total} latest={latest} currentPage={page.currentPage} />
  <ChangelogLog entries={page.data} pills={redesignedTypePills} />

  <nav class="rd-section log-pager modern-skin" aria-label="Changelog pagination">
    <div class="pager-links">
      {page.url.prev && <a href={page.url.prev} class="pager-link">&larr; newer entries</a>}
      {page.url.next && <a href={page.url.next} class="pager-link">older entries &rarr;</a>}
    </div>
    <span class="pager-count">showing {shownThrough} of {page.total}</span>
  </nav>

  <div class="changelog-shell retro-skin">
    <header class="changelog-header">
      <p class="header-eyebrow">Changelog</p>
      <h1 class="page-title">Changelog</h1>
      <p class="header-subtitle page-intro">{description}</p>
    </header>

    {/* The key explains the sig-dot colours, which are themselves aria-hidden. Anything
        without the stylesheet gets the key but never the thing it keys, so it reads as a
        stranded "SIGNIFICANCE MAJOR MINOR PATCH" line. Hidden alongside what it explains;
        each row carries its significance as text instead (see ChangelogLedger). */}
    <div class="legend" aria-hidden="true">
      <span class="legend-label">SIGNIFICANCE</span>
      {legend.map(({ significance, label }) => (
        <span class="legend-item">
          <span class={`sig-dot sig-dot--${significance}`} aria-hidden="true"></span>{label}
        </span>
      ))}
    </div>

    <div class="type-filter">
      <FilterPills
        pills={typePills}
        groupLabel="Filter by type"
        itemSelector='[data-module="changelog-ledger"] .lg-row'
        itemDataAttr="type"
        matchMode="exact"
        noun="entry"
        nounPlural="entries"
        filterVerb="of type"
        syncUrlParam="type"
      />
    </div>

    <ChangelogLedger entries={page.data} />

    <nav class="lg-footer" aria-label="Changelog pagination">
      <div class="lg-pagelinks">
        {page.url.prev && (
          <a href={page.url.prev} class="lg-pagelink">← NEWER ENTRIES</a>
        )}
        {page.url.next && (
          <a href={page.url.next} class="lg-pagelink">LOAD OLDER ENTRIES →</a>
        )}
      </div>
      <span class="lg-count">showing {shownThrough} of {page.total}</span>
    </nav>
  </div>
</Layout>

<style>
  /* ── Redesigned (modern) pager ───────────────────────────────────────────
     The list's own hairline closes on `.rows-end`, so this row opens with no
     border of its own; it is a footer to the log rather than another row.
     Unguarded selectors are safe here because every one of them is inside a
     `.modern-skin` subtree, which retro sets to `display: none`. */
  .log-pager {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 28px;
    padding-top: 26px;
  }

  .pager-links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }

  .pager-link {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--changelog);
  }

  .pager-link:hover { color: var(--changelog-hover); }

  .pager-count {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  /* ── Legacy (retro) ledger ───────────────────────────────────────────────
     Unchanged from before the redesign. */
  .changelog-shell {
    max-width: 860px;
    margin: 0 auto;
    padding: 64px var(--gutter) 72px;
  }

  .changelog-header { margin-bottom: 22px; }

  .header-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .16em;
    color: var(--color-label);
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .page-title { margin: 0 0 14px; }
  .header-subtitle { margin: 0 0 22px; }

  /* ── Significance legend ────────────────────────────────────────────────── */
  .legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 12px 0 4px;
    border-top: 1px solid var(--color-border);
    margin-bottom: 12px;
  }

  .legend-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    color: var(--color-muted);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .08em;
    color: var(--color-muted);
  }

  .sig-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }

  .sig-dot--major { background: var(--color-sig-major); }
  .sig-dot--minor { background: var(--color-sig-minor); }
  .sig-dot--patch { background: var(--color-sig-patch); }

  /* ── Type filter + key ──────────────────────────────────────────────────── */
  .type-filter {
    margin-bottom: 12px;
  }

  /* ── Footer: pagination + count ─────────────────────────────────────────── */
  .lg-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 22px 0 0;
    margin-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .lg-pagelinks {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .lg-pagelink {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--color-accent);
  }

  .lg-pagelink:hover { color: var(--color-accent-hover); }

  .lg-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }

  @media (max-width: 600px) {
    .changelog-shell { padding: 40px var(--gutter-mobile) 56px; }
  }

  /* 720px, not 600px: the redesign's own breakpoint, which every rd- component
     shares. */
  @media (max-width: 720px) {
    .log-pager { padding-top: 20px; }

    /* 44px tap targets, per the mobile spec. */
    .pager-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
      font-size: 16px;
    }

    .pager-count { font-size: 16px; }
  }
</style>

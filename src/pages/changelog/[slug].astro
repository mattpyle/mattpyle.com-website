---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { showDrafts } from '../../lib/show-drafts';
import { compareChangelogEntries } from '../../lib/changelog-order';
import { formatSiteDate } from '../../lib/format-date.mjs';

export async function getStaticPaths() {
  const entries = (await getCollection('changelog', ({ data }) => showDrafts || !data.draft))
    .sort(compareChangelogEntries);

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Entries are sorted newest-first: "previous" moves backward in the
      // chronology (older), while "next" moves forward (newer).
      prev: entries[index + 1] ?? null,
      next: entries[index - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const { title, summary, seoTitle, seoDescription, date, publishedAt, updated, type, significance, hero, heroAlt, draft } = entry.data;
const markdownUrl = `/changelog/${entry.id}.md`;
---

<Layout
  title={title}
  seoTitle={seoTitle}
  description={summary}
  seoDescription={seoDescription}
  type="article"
  image={`/og/changelog/${entry.id}.png`}
  publishedTime={publishedAt ?? date}
  modifiedTime={updated}
  noindex={draft}
  markdownAlternate={markdownUrl}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Changelog', url: '/changelog/' },
    { name: title, url: `/changelog/${entry.id}/` },
  ]}
>
  {/*
    ONE ENTRY TEMPLATE, BOTH APPEARANCES. This page used to ship its chrome
    twice — a `.modern-skin` head and nav against a `.retro-skin` header and
    footer — with CSS choosing between them. The legacy pair is deleted and both
    appearances now style this one tree; retro's rules live under
    `[data-module='article']` in src/styles/retro.css, scoped by the `.entry-*`
    classes so the post page, which shares this module value, is untouched.

    THE ENTRY BODY WAS NEVER DUPLICATED, for the reason
    src/pages/writing/[slug].astro sets out in full: rendering <Content /> twice
    would put every heading id in the document twice, which is invalid HTML and
    gives an in-page anchor two targets. The two trees already shared this one
    `.prose` node; now they share everything around it too.

    What retro gave up to get here: the significance chip and dot, the type pill
    and the tag pills. The modern tree's content wins wherever the two disagreed.
  */}
  <article data-module="article">

    {showDrafts && draft && (
      <p class="draft-banner" role="status">DRAFT — not published, preview only</p>
    )}

    <div class="entry-head rd-section">
      <a href="/changelog/" class="entry-back">&larr; all changelog</a>
      <h1 class="entry-title">{title}</h1>
      <p class="entry-lead">{summary}</p>
      {/* Date, type and significance as plain mono words. The deleted legacy
          header carried the same three as a time, a pill and a coloured dot;
          constraints 4 and 7 rule both of those out. */}
      <p class="entry-meta">
        <time datetime={date.toISOString()}>{formatSiteDate(date)}</time>
        <span class="entry-type">{type}</span>
        <span class="entry-sig">{significance}</span>
      </p>
    </div>

    {hero && (
      <figure class="hero">
        <Image src={hero} alt={heroAlt ?? ''} loading="eager" />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {(prev || next) && (
      <nav class="entry-nav rd-section" aria-label="Changelog entry navigation">
        {/* Newer first, then older: the log reads newest-first, so this is the
            same direction the index runs in. `next` is the newer entry and
            `prev` the older one — the names come from the chronology, not from
            where they sit on the page (see getStaticPaths above). */}
        {next && (
          <a href={`/changelog/${next.id}/`} class="entry-step">
            <span class="entry-step-label">newer &middot; {formatSiteDate(next.data.date)}</span>
            <span class="entry-step-title">{next.data.title}</span>
          </a>
        )}
        {prev && (
          <a href={`/changelog/${prev.id}/`} class="entry-step">
            <span class="entry-step-label">older &middot; {formatSiteDate(prev.data.date)}</span>
            <span class="entry-step-title">{prev.data.title}</span>
          </a>
        )}
      </nav>
    )}

  </article>
</Layout>

<style>
  /* ── The entry template ──────────────────────────────────────────────────
     The post page's chrome at the changelog's scale and in its colour
     (src/pages/writing/[slug].astro, whose comments carry the reasoning). No
     rail: an entry is a paragraph or two and has no headings to build contents
     from, so the two-column body would be a 210px empty column.

     APPEARANCE-BLIND, with no `html:not([data-appearance='retro'])` guards. The
     guards existed only to keep these rules off the legacy `.retro-skin` tree
     while it shared this document; that tree is deleted, and retro now restyles
     this markup from src/styles/retro.css. */
  [data-module="article"] {
    padding: 0 0 80px;
  }

  .draft-banner {
    max-width: var(--shell);
    /* The shell's gutter, so the banner lines up with the headline under it. */
    margin: 24px auto 0;
    margin-inline: max(calc((100% - var(--shell)) / 2 + var(--shell-gutter)), var(--shell-gutter));
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--agents);
    background: var(--tint-agents);
    border: 1px solid var(--agents);
    border-radius: var(--radius);
    padding: 10px 16px;
  }

  .entry-head { padding-top: 66px; }

  .entry-back {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--changelog);
  }

  .entry-back:hover { color: var(--changelog-hover); }

  .entry-title {
    margin: 26px 0 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 5.6vw, 82px);
    line-height: 1;
    letter-spacing: -.035em;
    color: var(--ink);
    text-wrap: balance;
    animation: riseIn .7s ease .05s both;
  }

  .entry-lead {
    margin: 30px 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.32;
    letter-spacing: -.02em;
    color: var(--ink-3);
    text-wrap: pretty;
    animation: riseIn .7s ease .12s both;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 22px;
    row-gap: 6px;
    margin: 26px 0 0;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .entry-type { color: var(--changelog); }

  /* `.prose` and `.hero` are placed rather than sized. The 68ch measure comes
     from the redesign prose block in global.css and these rules deliberately set
     no `max-width` on `.prose`, because the two ways of restoring the measure
     after widening to the shell both fail: a `.prose > *` rule is Astro-SCOPED,
     and the children here are rendered from markdown so they carry no
     `data-astro-cid` attribute and the selector matches nothing (measured — the
     paragraphs ran the full 1180px). The margin below is the shell's left gutter
     as a length rather than `auto`, so the 68ch column starts where the headline
     above it starts. Same call, and same reason, as `.post-body` on the post
     page. */
  .prose,
  .hero {
    margin-inline: max(calc((100% - var(--shell)) / 2 + var(--shell-gutter)), var(--shell-gutter));
  }

  .prose { margin-top: 56px; }

  /* Sizing and the image treatment moved to the "Article hero" block in
     src/styles/global.css on 2026-09-02, when the post page gained the same
     figure. Only the placement above is this page's. */

  /* The prose overlay in global.css paints links and the blockquote rule in
     WRITING blue, because it was written for the post page and a link inside a
     post belongs to that section. Constraint 7 makes the colour a statement
     about the section, so on this page it is the changelog's.

     `:global(a)` because these nodes come from markdown and carry no
     `data-astro-cid` attribute — a bare `.prose a` here compiles to
     `a[data-astro-cid-…]` and matches nothing, the same trap the `.prose`
     comment above records. The underline stays: inside a paragraph, colour
     alone does not distinguish a link (WCAG 1.4.1). */
  .prose :global(a) { color: var(--changelog); }
  .prose :global(a:hover) { color: var(--changelog-hover); }
  .prose :global(blockquote) { border-left-color: var(--changelog); }

  .entry-nav { margin-top: 76px; }

  .entry-step {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 56px;
    align-items: baseline;
    padding: 30px 20px 34px;
    margin: 0 -20px;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: background 240ms ease;
  }

  .entry-step:hover { background: var(--tint-writing); }

  .entry-step-label {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .entry-step-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.16;
    letter-spacing: -.025em;
    max-width: 26ch;
  }

  @media (max-width: 720px) {
    [data-module="article"] { padding: 0 0 56px; }

    .draft-banner { margin-inline: var(--shell-gutter-mobile); }

    .entry-head { padding-top: 34px; }

    .entry-title {
      margin-top: 20px;
      font-size: 40px;
      letter-spacing: -.03em;
    }

    .entry-lead {
      margin-top: 22px;
      font-size: 22px;
    }

    .entry-meta {
      margin-top: 20px;
      font-size: 16px;
    }

    .prose,
    .hero { margin-inline: var(--shell-gutter-mobile); }

    .prose { margin-top: 36px; }

    .entry-nav { margin-top: 48px; }

    .entry-step {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 22px 0 24px;
      margin: 0;
    }

    .entry-step-label { font-size: 16px; }

    .entry-step-title { font-size: 25px; }
  }
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BuildsGrid from '../../components/BuildsGrid.astro';
import { markdownSiblingFor } from '../../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null.
const markdownUrl = markdownSiblingFor('/builds/') ?? undefined;

const allBuilds = await getCollection('builds');

const builds = allBuilds.sort((a, b) => {
  const order = { live: 0, 'in-progress': 1, archived: 2 };
  const diff = order[a.data.status] - order[b.data.status];
  return diff !== 0 ? diff : b.data.date.getTime() - a.data.date.getTime();
});
---

<Layout
  title="Builds: side projects and software experiments"
  description="Side projects and software experiments, some built on Temporal and some not. Hobby builds from a growth marketer, not a corporate portfolio."
  markdownAlternate={markdownUrl}
>
  <PageHeader
    eyebrow="Side projects"
    title="Builds"
    subtitle="Software experiments — some built on Temporal, some not. Hobby builds, not a portfolio."
  />
  <BuildsGrid builds={builds} />
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import ProjectsHero from '../../components/projects/ProjectsHero.astro';
import ProjectsBoard from '../../components/projects/ProjectsBoard.astro';
import { markdownSiblingFor } from '../../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null.
const markdownUrl = markdownSiblingFor('/projects/') ?? undefined;

const allProjects = await getCollection('projects');

const projects = allProjects.sort((a, b) => {
  const order = { live: 0, 'in-progress': 1, archived: 2 };
  const diff = order[a.data.status] - order[b.data.status];
  return diff !== 0 ? diff : b.data.date.getTime() - a.data.date.getTime();
});
---

<Layout
  title="Projects: side projects and software experiments"
  description="Side projects and software experiments, some built on Temporal and some not. Hobby projects from a growth marketer, not a corporate portfolio."
  markdownAlternate={markdownUrl}
>
  {/*
    TWO GRIDS IN ONE DOCUMENT, one shown per appearance — the same construction
    src/pages/index.astro and src/pages/writing/index.astro use, and for the same
    reason: the redesign rebuilds the MODERN appearance only, retro is a
    client-side preference the server cannot read, so both trees ship and CSS
    chooses. `.modern-skin` / `.retro-skin` in src/styles/retro.css do the
    choosing.

    A hidden subtree holds no tab stops and is absent from the accessibility
    tree, so each appearance presents exactly one grid.

    Both take the same `projects` array in the same status-then-date order. The
    redesigned tree drops the status FilterPills and the tag chips, which
    constraint 4 bans; they belong to the legacy tree only.
  */}
  <ProjectsHero />
  <ProjectsBoard projects={projects} />

  <div class="retro-skin">
    <PageHeader
      eyebrow="Side projects"
      title="Projects"
      subtitle="Software experiments — some built on Temporal, some not. Hobby projects, not a portfolio."
    />
    <ProjectsGrid projects={projects} />
  </div>
</Layout>

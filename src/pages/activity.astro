---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ActivityHero from '../components/activity/ActivityHero.astro';
import ActivityBody from '../components/activity/ActivityBody.astro';
import { buildActivity, FAMILY_NOTES } from '../lib/activity-summary.mjs';
import { flattenTraffic, readAgentTraffic, MAX_TABLE_ROWS } from '../lib/agent-traffic.mjs';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve cannot
// drift; the map returns null for a path it does not negotiate, and Layout wants the prop absent
// rather than null. /activity.md is a CURATED sibling (src/pages/activity.md.ts) rather than a
// converted one, for the same reason /scorecard.md used to be: this page renders per request, so
// the emit step has no built HTML file to convert.
const markdownUrl = markdownSiblingFor('/activity/') ?? undefined;

/**
 * ON DEMAND, because the numbers on this page are a live store read.
 *
 * /scorecard held this cost from 2026-08-06 until the two pages split; it goes back to prerendered
 * in the same change and this page takes the cost on. That is the right place for it: everything
 * here is the store and nothing here is committed JSON, so a prerendered /activity would be a page
 * whose entire subject was frozen at deploy time.
 *
 * The resilience is the CDN, not a retry: s-maxage plus a day of stale-while-revalidate means a
 * store outage shorter than the window serves the last good numbers, and only past it does the
 * page show its unavailable state.
 *
 * Four things assume a page has a file in dist/client, and each has an on-demand branch this route
 * now uses: the sitemap integration's `customPages` (fed from ON_DEMAND_PAGES in
 * src/data/sitemap-lastmod.mjs), scripts/validate-sitemap.mjs, the markdown-sibling emit step, and
 * scripts/serve-built-site.mjs.
 */
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

// One clock for the whole render, so every window, the chart's 24 buckets and the "rendered at"
// stamp cannot disagree about what "now" is.
const renderedAt = new Date();
const traffic = await readAgentTraffic({ now: renderedAt });
const activity = traffic.ok ? buildActivity(flattenTraffic(traffic), renderedAt) : null;

/**
 * What the page says when it has no numbers. Three states, not two: "no store configured" and "the
 * store did not answer" are the same blank space and completely different findings, and only the
 * second can happen in production. The first is what a local build looks like, and saying the
 * store failed there would be a small lie told on every preview.
 */
const emptyStateCopy = traffic.ok
  ? 'Counting is running and nothing has been counted yet. The first agent request to a discovery document fills this in.'
  : traffic.reason === 'no-store'
    ? 'No counter store is configured in this environment, so there is nothing to read. That is a local build; production reads the live store.'
    : 'Live counts are unavailable right now: the store did not answer this render.';

const counts = new Intl.NumberFormat('en-GB');

// The legacy tree's timestamps ship as UTC and are localised in the browser (see the script at the
// foot of this file), exactly as they did on /scorecard. The redesigned tree above deliberately
// does not localise: its stamp is labelled UTC and the whole page is framed in UTC hours.
const utcStamp = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
  timeZoneName: 'short',
});

const renderedStamp = { iso: renderedAt.toISOString(), label: utcStamp.format(renderedAt) };

/** A client family with its gloss. The same two families need one here as in the modern tree. */
function familyNote(family: string): string | undefined {
  return FAMILY_NOTES[family as keyof typeof FAMILY_NOTES];
}
---

<Layout
  title="Activity"
  fullTitle="Activity: agent traffic to mattpyle.com"
  description="Requests to this site's agent surfaces and pages served as Markdown: the last 24 hours hour by hour, by surface, by client, and by page."
  markdownAlternate={markdownUrl}
>
  {/*
    TWO ACTIVITY PAGES IN ONE DOCUMENT, one shown per appearance — the same construction
    src/pages/about.astro and index.astro use, and for the same reason: the redesign rebuilds the
    MODERN appearance only, retro is a client-side preference the server cannot read, so both trees
    ship and CSS chooses.

    THIS PAGE HAS NO LEGACY COUNTERPART — it is new — so its `.retro-skin` tree is built from the
    legacy components and the legacy markup the Agent traffic block on /scorecard used to carry,
    which is what lets retro.css style it with a zero-byte diff. The block moved here whole; it did
    not move for the modern appearance and get dropped for the other one.

    A hidden subtree holds no tab stops and is absent from the accessibility tree, so each
    appearance presents exactly one page, with exactly one h1.
  */}
  <ActivityHero renderedAt={renderedAt} />
  <ActivityBody activity={activity} emptyStateCopy={emptyStateCopy} />

  <div class="retro-skin">
    <PageHeader
      eyebrow="Agent traffic · live counts"
      title="Activity"
      subtitle="Requests to this site's agent surfaces, and pages served as Markdown to clients that asked for them."
    />

    <div class="activity-shell" data-module="activity">
      <section id="agent-traffic" class="traffic" aria-labelledby="agent-traffic-title">
        <header class="traffic-header">
          <h2 id="agent-traffic-title">Agent traffic</h2>
          <p class="freshness">
            Rendered <time datetime={renderedStamp.iso} data-local-time>{renderedStamp.label}</time>
          </p>
        </header>

        {activity && activity.counted ? (
          <Fragment>
            <div class="traffic-panel">
              <div class="statrow">
                <div class="stat">
                  <p class="label">Requests, last 24 hours</p>
                  <p class="num">{counts.format(activity.totals.day)}</p>
                </div>
                <div class="stat">
                  <p class="label">Requests, last 7 days</p>
                  <p class="num">{counts.format(activity.totals.week)}</p>
                </div>
                <div class="stat">
                  <p class="label">Requests recorded</p>
                  <p class="num">{counts.format(activity.totals.total)}</p>
                </div>
              </div>
            </div>

            <div class="subsect">
              <h3 id="traffic-surfaces-title">By surface</h3>
              {/*
                The scroll container, not `table { display: block }`: Chrome drops table semantics
                from the accessibility tree the moment a table stops being display: table, and this
                page's aria golden would be the thing that noticed. Focusable because a region that
                scrolls has to be reachable by keyboard.
              */}
              <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-surfaces-title">
              <table aria-labelledby="traffic-surfaces-title">
                <thead>
                  <tr>
                    <th scope="col">Surface</th>
                    <th scope="col" class="n">7 days</th>
                    <th scope="col" class="n">30 days</th>
                    <th scope="col" class="n">Recorded</th>
                  </tr>
                </thead>
                <tbody>
                  {activity.surfaces.rows.map(row => (
                    <tr>
                      <td><code>{row.path}</code></td>
                      <td class="n">{counts.format(row.week)}</td>
                      <td class="n">{counts.format(row.month)}</td>
                      <td class="n">{counts.format(row.total)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
              {activity.surfaces.omitted > 0 && (
                <p class="footnote">{activity.surfaces.omitted} further surface(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
              )}
            </div>

            <div class="subsect">
              <h3 id="traffic-clients-title">By client type</h3>
              <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-clients-title">
              <table aria-labelledby="traffic-clients-title">
                <thead>
                  <tr>
                    <th scope="col">Client</th>
                    <th scope="col" class="n">7 days</th>
                    <th scope="col" class="n">30 days</th>
                    <th scope="col" class="n">Recorded</th>
                  </tr>
                </thead>
                <tbody>
                  {activity.clients.rows.map(row => (
                    <tr>
                      <td class="family">
                        {row.family}
                        {familyNote(row.family ?? '') && (
                          <span class="family-note"> ({familyNote(row.family ?? '')})</span>
                        )}
                      </td>
                      <td class="n">{counts.format(row.week)}</td>
                      <td class="n">{counts.format(row.month)}</td>
                      <td class="n">{counts.format(row.total)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
              {activity.clients.omitted > 0 && (
                <p class="footnote">{activity.clients.omitted} further client type(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
              )}
            </div>

            <div class="subsect">
              <h3 id="traffic-markdown-title">Markdown negotiation</h3>
              {activity.pages.rows.length > 0 ? (
                <div class="table-scroll" role="region" tabindex="0" aria-labelledby="traffic-markdown-title">
                <table aria-labelledby="traffic-markdown-title">
                  <thead>
                    <tr>
                      <th scope="col">Page</th>
                      <th scope="col" class="n">7 days</th>
                      <th scope="col" class="n">30 days</th>
                      <th scope="col" class="n">Recorded</th>
                    </tr>
                  </thead>
                  <tbody>
                    {activity.pages.rows.map(row => (
                      <tr>
                        <td><code>{markdownSiblingFor(row.path ?? '') ?? row.path}</code></td>
                        <td class="n">{counts.format(row.week)}</td>
                        <td class="n">{counts.format(row.month)}</td>
                        <td class="n">{counts.format(row.total)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                </div>
              ) : (
                <p class="traffic-empty">
                  No page has been served as Markdown yet. Every page here has a Markdown
                  representation and answers <code>Accept: text/markdown</code> with it; this row
                  fills in the first time something asks.
                </p>
              )}
              {activity.pages.omitted > 0 && (
                <p class="footnote">{activity.pages.omitted} further page(s) below the top {MAX_TABLE_ROWS} are not shown.</p>
              )}
            </div>
          </Fragment>
        ) : (
          <p class="traffic-unavailable">{emptyStateCopy}</p>
        )}
      </section>
    </div>
  </div>
  <script>
    /**
     * Localise the legacy tree's timestamp.
     *
     * The page is cached and served byte-identically to everyone, so the server cannot know the
     * reader's timezone and must not try: the stamp ships as UTC, labelled UTC, correct with no
     * JavaScript at all. This rewrites the visible text to the reader's own zone; the `datetime`
     * attribute, which is the machine-readable value and the one an agent reads, is never touched.
     *
     * It reaches the RETRO tree only. The redesigned tree above ships no JavaScript at all and its
     * stamp stays UTC on purpose — every other number on that page is framed in UTC hours, so a
     * localised stamp beside them would be the one figure in a different frame.
     *
     * Bound to astro:page-load rather than run once, because ClientRouter soft-navigates into this
     * page without a fresh document (see the other components in src/components).
     */
    function localiseTimes(): void {
      const local = new Intl.DateTimeFormat(undefined, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZoneName: 'short',
      });

      for (const element of document.querySelectorAll<HTMLTimeElement>('time[data-local-time]')) {
        const iso = element.getAttribute('datetime');
        if (!iso) continue;
        const at = new Date(iso);
        if (Number.isNaN(at.getTime())) continue;
        element.textContent = local.format(at);
      }
    }

    document.addEventListener('astro:page-load', localiseTimes);
  </script>
</Layout>

<style>
  /* The legacy appearance's rules, carried over with the block they style. They are scoped to this
     page's retro tree and reach nothing else; the redesigned tree's styles live in its two
     components. retro.css is untouched by this build. */
  .activity-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 var(--gutter) 88px;
  }

  .traffic-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .traffic-header h2 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -.015em;
    line-height: 1.1;
  }

  .freshness {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-align: right;
  }

  .traffic-panel {
    margin-top: 18px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-heading);
  }

  .statrow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .stat {
    padding: 20px 22px 22px;
    border-right: 1px solid var(--color-border);
  }

  .stat:last-child { border-right: 0; }

  .stat .label {
    margin: 0 0 10px;
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .stat .num {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1;
  }

  .subsect { margin-bottom: 30px; }

  .subsect h3 {
    margin: 30px 0 12px;
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
  }

  .table-scroll { overflow-x: auto; }

  .table-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .traffic table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }

  .traffic thead th {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: .12em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .traffic th.n,
  .traffic td.n {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .traffic thead th:first-child { width: 100%; }

  .traffic tbody td {
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-border);
    font-size: 13px;
  }

  .traffic tbody tr:last-child td { border-bottom: 0; }
  .traffic tbody tr:hover { background: var(--color-accent-wash); }

  .traffic td code,
  .traffic td.family {
    font-family: var(--font-mono);
    font-size: 11.5px;
    overflow-wrap: anywhere;
  }

  .family-note { color: var(--color-muted); }

  .footnote {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .traffic-empty,
  .traffic-unavailable {
    margin: 18px 0 0;
    padding: 20px 22px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    /* Same top rule as .traffic-panel: this is the panel, in the state where it has nothing to
       show. */
    border-top: 3px solid var(--color-heading);
    color: var(--color-muted);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .traffic-empty code,
  .traffic-unavailable code {
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  @media (max-width: 820px) {
    .stat { padding: 16px 12px 18px; }
    .stat .num { font-size: 32px; }
    .stat .label { font-size: 8.5px; }
  }

  @media (max-width: 650px) {
    .activity-shell { padding: 0 var(--gutter-mobile) 60px; }

    .traffic-header { align-items: flex-start; flex-direction: column; gap: 8px; }
    .freshness { text-align: left; }
    .stat { padding: 18px 16px 20px; }
  }

  @media (max-width: 410px) {
    /* Three 38px numbers do not fit 320px; stacking beats a table that scrolls sideways for the
       one row a reader most wants to read at a glance. */
    .statrow { grid-template-columns: 1fr; }
    .stat { border-right: 0; border-bottom: 1px solid var(--color-border); }
    .stat:last-child { border-bottom: 0; }
  }
</style>

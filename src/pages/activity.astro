---
import Layout from '../layouts/Layout.astro';
import ActivityHero from '../components/activity/ActivityHero.astro';
import ActivityBody from '../components/activity/ActivityBody.astro';
import { buildActivity } from '../lib/activity-summary.mjs';
import { flattenTraffic, readAgentTraffic } from '../lib/agent-traffic.mjs';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve cannot
// drift; the map returns null for a path it does not negotiate, and Layout wants the prop absent
// rather than null. /activity.md is a CURATED sibling (src/pages/activity.md.ts) rather than a
// converted one, for the same reason /scorecard.md used to be: this page renders per request, so
// the emit step has no built HTML file to convert.
const markdownUrl = markdownSiblingFor('/activity/') ?? undefined;

/**
 * ON DEMAND, because the numbers on this page are a live store read.
 *
 * /scorecard held this cost from 2026-08-06 until the two pages split; it goes back to prerendered
 * in the same change and this page takes the cost on. That is the right place for it: everything
 * here is the store and nothing here is committed JSON, so a prerendered /activity would be a page
 * whose entire subject was frozen at deploy time.
 *
 * The resilience is the CDN, not a retry: s-maxage plus a day of stale-while-revalidate means a
 * store outage shorter than the window serves the last good numbers, and only past it does the
 * page show its unavailable state.
 *
 * Four things assume a page has a file in dist/client, and each has an on-demand branch this route
 * now uses: the sitemap integration's `customPages` (fed from ON_DEMAND_PAGES in
 * src/data/sitemap-lastmod.mjs), scripts/validate-sitemap.mjs, the markdown-sibling emit step, and
 * scripts/serve-built-site.mjs.
 */
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

// One clock for the whole render, so every window, the chart's 24 buckets and the "rendered at"
// stamp cannot disagree about what "now" is.
const renderedAt = new Date();
const traffic = await readAgentTraffic({ now: renderedAt });
const activity = traffic.ok ? buildActivity(flattenTraffic(traffic), renderedAt) : null;

/**
 * What the page says when it has no numbers. Three states, not two: "no store configured" and "the
 * store did not answer" are the same blank space and completely different findings, and only the
 * second can happen in production. The first is what a local build looks like, and saying the
 * store failed there would be a small lie told on every preview.
 */
const emptyStateCopy = traffic.ok
  ? 'Counting is running and nothing has been counted yet. The first agent request to a discovery document fills this in.'
  : traffic.reason === 'no-store'
    ? 'No counter store is configured in this environment, so there is nothing to read. That is a local build; production reads the live store.'
    : 'Live counts are unavailable right now: the store did not answer this render.';
---

<Layout
  title="Activity"
  fullTitle="Activity: agent traffic to mattpyle.com"
  description="Requests to this site's agent surfaces, pages served as Markdown, and pages read by named bots: the last 24 hours hour by hour, by surface, by client, and by page."
  markdownAlternate={markdownUrl}
>
  {/*
    ONE ACTIVITY PAGE, styled twice. Until 2026-08-29 this page shipped its content twice — the
    redesigned tree marked `.modern-skin` and, marked `.retro-skin`, a copy of the legacy Agent
    traffic block this page inherited from /scorecard, kept so retro.css could style it unchanged.
    That tree, this page's whole scoped style block and its timestamp-localising script are all
    deleted; ActivityHero and ActivityBody are the page in both appearances, and retro restyles them
    in place under `[data-module='activity-hero']` and `[data-module='activity-body']` in
    src/styles/retro.css.

    Retro takes the modern tree's content in the swap, which is the rule every surface in this
    conversion has followed: the four legacy tables become ActivityBody's six bands, including the
    24-bucket chart and the last-hour table the legacy block never had. The rendered stamp stays
    UTC in both appearances now — the script that rewrote it to the reader's zone reached the
    legacy tree only, and the rest of this page is framed in UTC hours, so a localised stamp beside
    them would be the one figure in a different frame.
  */}
  <ActivityHero renderedAt={renderedAt} />
  <ActivityBody activity={activity} emptyStateCopy={emptyStateCopy} />
</Layout>


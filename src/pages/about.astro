---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutBody from '../components/about/AboutBody.astro';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null. The portrait rail links the same value for the same reason.
const markdownUrl = markdownSiblingFor('/about/') ?? undefined;
---

<Layout
  title="About"
  fullTitle="About Matt Pyle — growth marketer and hobbyist builder"
  description="Matt Pyle is Director of Growth at Temporal Technologies: growth marketer, hobbyist builder, and a curious person who ships things in public."
  markdownAlternate={markdownUrl}
>
  {/*
    ONE ABOUT PAGE, styled by both appearances. This page shipped its content
    twice until 2026-08-29 — AboutHero and AboutBody for modern, a `.retro-skin`
    div holding PageHeader and AboutGrid for retro — and CSS chose between them.
    Both legacy pieces are deleted and `src/styles/retro.css` restyles the markup
    below under `html[data-appearance='retro']`.

    What retro gave up in the swap, so the diff is not mistaken for a loss: the
    bio-and-links grid and its identity card are gone, retro takes the prose-led
    page with the portrait rail, and the h1 reads "About" in both appearances
    rather than "Matt Pyle" in retro. The redesigned tree's content won, which is
    the rule every surface in this conversion has followed.
  */}
  <AboutHero />
  <AboutBody markdownUrl={markdownUrl} />
</Layout>

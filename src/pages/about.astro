---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AboutGrid from '../components/AboutGrid.astro';
import { markdownSiblingFor } from '../lib/markdown-negotiation.mjs';

// The page's markdown sibling, declared in the head by Layout. Derived from the negotiation map
// rather than written out, so this link and the sibling the middleware would actually serve
// cannot drift; the map returns null for a path it does not negotiate, and Layout wants the prop
// absent rather than null.
const markdownUrl = markdownSiblingFor('/about/') ?? undefined;
---

<Layout
  title="About"
  fullTitle="About Matt Pyle — growth marketer and hobbyist builder"
  description="Matt Pyle is Director of Growth at Temporal Technologies: growth marketer, hobbyist builder, and a curious person who ships things in public."
  markdownAlternate={markdownUrl}
>
  <PageHeader
    eyebrow="About"
    title="Matt Pyle"
    subtitle="Director of Growth at Temporal Technologies."
  />
  <AboutGrid />
</Layout>

---
/**
 * One fix on its own URL, in the manner of a changelog entry (src/pages/changelog/[slug].astro):
 * a back link, the title as the page's h1, a one-sentence lead, the body, and the newer and
 * older fixes at the foot. It shares the entry's `data-module="article"` and `.entry-*`
 * class names for the head and the foot, so retro dresses them from the rules it already has.
 *
 * What a fix adds to a changelog entry:
 * 1. A rail beside the story with the named before-and-after measures, before left and after
 *    right, and the pull requests that made the change. Position and the names tell before
 *    from after, never colour.
 * 2. Under the story, at full width, the changed text as it was and as it is, where the entry
 *    holds it.
 *
 * Times show in America/Vancouver. `found` is a UTC calendar date and is not shown here.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FixText from '../../components/fix-log/FixText.astro';
import { FIX_LOG, TYPE_LABEL, compareFixes, fixDate, fixUrl, prUrl } from '../../lib/fix-log';

export async function getStaticPaths() {
  const fixes = (await getCollection('fixes')).sort(compareFixes);
  return fixes.map((fix, index) => ({
    params: { slug: fix.data.slug },
    // Newest first: `newer` sits before an entry in the list and `older` after it.
    props: { fix, newer: fixes[index - 1] ?? null, older: fixes[index + 1] ?? null },
  }));
}

const { fix, newer, older } = Astro.props;
const { Content } = await render(fix);
const { title, lead, type, status, verified, measures, changes, text } = fix.data;
const path = fixUrl(fix);
---

<Layout
  title={title}
  description={lead}
  type="article"
  publishedTime={verified}
  markdownAlternate={`${path.slice(0, -1)}.md`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: FIX_LOG.name, url: FIX_LOG.path },
    { name: title, url: path },
  ]}
>
  <article data-module="article">
    <div class="entry-head rd-section">
      <a href={FIX_LOG.path} class="entry-back">&larr; all fixes</a>
      <h1 class="entry-title">{title}</h1>
      <p class="entry-lead">{lead}</p>
    </div>

    <div class="rd-section">
      <div class="fix-body">
        <p class="fix-meta">
          <time datetime={verified.toISOString()} class="fix-meta-date">{fixDate(verified)}</time>
          <span>{TYPE_LABEL[type]}</span>
          {status === 'reopened' && <span class="fix-meta-open">still open</span>}
        </p>

        <div class="fix-story"><Content /></div>

        <aside class="fix-rail" aria-label="The fix in numbers">
          {measures.map((m) => {
            const sides = m.sides ?? ['Before', 'After'];
            return (
              <section class="fix-measure">
                <h2 class="fix-measure-name">{m.label}</h2>
                <div class="fix-measure-pair">
                  {[m.before, m.after].map((value, i) => (
                    <p>
                      <span class="fix-side">{sides[i]}</span>
                      <span class:list={['fix-value', m.quoted && 'fix-value--quoted']}>{m.quoted ? `“${value}”` : value}</span>
                    </p>
                  ))}
                </div>
              </section>
            );
          })}
          <section class="fix-measure">
            <h2 class="fix-measure-name">{changes.length === 1 ? 'The change' : 'The changes'}</h2>
            <p class="fix-changes">
              {changes.map((c) => <a href={prUrl(c.number)}>{c.title}</a>)}
            </p>
          </section>
        </aside>
      </div>
    </div>

    {text && (
      <div class="rd-section fix-band">
        <FixText specimen={text.before} name="Before" />
        <FixText specimen={text.after} name="After" />
      </div>
    )}

    {(newer || older) && (
      <nav class="entry-nav rd-section" aria-label="Other fixes">
        {newer && (
          <a href={fixUrl(newer)} class="entry-step">
            <span class="entry-step-label">newer &middot; {fixDate(newer.data.verified)}</span>
            <span class="entry-step-title">{newer.data.title}</span>
          </a>
        )}
        {older && (
          <a href={fixUrl(older)} class="entry-step">
            <span class="entry-step-label">older &middot; {fixDate(older.data.verified)}</span>
            <span class="entry-step-title">{older.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>

<style>
  [data-module="article"] { padding: 0 0 80px; }

  /* ── The head: the changelog entry's ── */
  .entry-head { padding-top: 66px; }

  .entry-back { font-family: var(--font-mono-plex); font-size: 17px; color: var(--ink-5); }
  .entry-back:hover { color: var(--ink); }

  .entry-title {
    margin: 26px 0 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 5.6vw, 82px);
    line-height: 1;
    letter-spacing: -.035em;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .entry-lead {
    margin: 30px 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.32;
    letter-spacing: -.02em;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  /* The post rail's meta block (PostRail.astro .rail-meta): one fact per line, the first in
     ink, the rest grey, in a 210px column beside the body. */
  .fix-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .fix-meta-date, .fix-meta-open { color: var(--ink); }

  /* ── The body: the story beside the rail ── */
  .fix-body {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) minmax(0, 300px);
    gap: 48px;
    align-items: start;
    margin-top: 58px;
    padding-top: 34px;
    border-top: 1px solid var(--rule);
  }

  .fix-story :global(p) {
    margin: 0 0 1.05em;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .fix-story :global(p:last-child) { margin-bottom: 0; }

  .fix-rail { display: flex; flex-direction: column; gap: 30px; min-width: 0; }

  .fix-measure { padding-top: 14px; border-top: 1px solid var(--ink); }

  .fix-measure-name {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .fix-measure-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .fix-measure-pair p { display: flex; flex-direction: column; gap: 4px; margin: 0; min-width: 0; }
  .fix-measure-pair p + p { padding-left: 16px; border-left: 1px solid var(--rule); }

  .fix-side { font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--ink-5); }

  .fix-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 48px;
    line-height: 1;
    letter-spacing: -.035em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Words, not a number: set smaller so a quotation wraps inside its half of the rail. */
  .fix-value--quoted { font-weight: 600; font-size: 24px; line-height: 1.2; letter-spacing: -.015em; }

  .fix-changes { display: flex; flex-direction: column; gap: 10px; margin: 0; font-size: 17px; line-height: 1.4; }

  .fix-changes a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--ink-6);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .fix-changes a:hover { text-decoration-color: var(--ink); }

  /* ── The band: the changed text, full width ── */
  .fix-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    margin-top: 56px;
  }

  /* ── Newer and older: the changelog entry's foot ── */
  .entry-nav { margin-top: 76px; }

  .entry-step {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 56px;
    align-items: baseline;
    padding: 30px 20px 34px;
    margin: 0 -20px;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: background 240ms ease;
  }

  .entry-step:hover { background: var(--tint-writing); }

  .entry-step-label { font-family: var(--font-mono-plex); font-size: 17px; color: var(--ink-6); }

  .entry-step-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.16;
    letter-spacing: -.025em;
    max-width: 26ch;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1080px) {
    .fix-body { grid-template-columns: 210px minmax(0, 1fr); }
    .fix-rail { grid-column: 2; }
  }

  @media (max-width: 860px) {
    .fix-body { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .fix-rail { grid-column: auto; }
    .fix-meta { flex-direction: row; flex-wrap: wrap; column-gap: 22px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
    .fix-band { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 720px) {
    .entry-head { padding-top: 34px; }
    .entry-title { margin-top: 20px; font-size: 40px; letter-spacing: -.03em; }
    .entry-lead { margin-top: 22px; font-size: 22px; }
    .fix-meta { font-size: 16px; }
    .fix-story :global(p) { font-size: 18px; }
    .fix-value { font-size: 40px; }
    .fix-value--quoted { font-size: 21px; }
    .fix-band { margin-top: 40px; gap: 18px; }
    .entry-nav { margin-top: 56px; }
    .entry-step { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 22px 0; margin: 0; }
    .entry-step-title { font-size: 24px; }
    .fix-changes a, .entry-back { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

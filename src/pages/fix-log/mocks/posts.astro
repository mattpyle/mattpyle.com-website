---
/**
 * Fix-log mock, round two: Posts. Between Specimen and Front page.
 *
 * A stream of short entries in one reading column, like a changelog: the date, the
 * title, the before and after, the change. A fix that earns more opens into an
 * article of its own (MP-48 here, at posts/mp-48/), which is where the story and the
 * big screenshots live. No rail: the screenshots get the full column.
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import Glance from '../../../components/fix-log-mocks/Glance.astro';
import ShotSlot from '../../../components/fix-log-mocks/ShotSlot.astro';
import { ENTRIES_NEWEST, HOW_MADE, fixDate, prUrl } from '../../../data/fix-log-sample';

const articleUrl = (key: string) => `/fix-log/mocks/posts/${key.toLowerCase()}/`;
---

<Layout title="Fix log: Posts mock" description="Design mock: each fix as a short post, and one as an article." noindex>
  <MockBar slug="posts" />

  <div class="column">
    <header class="head">
      <h1 class="title">Fixed</h1>
      <p class="how">{HOW_MADE}</p>
    </header>

    {ENTRIES_NEWEST.map((e) => (
      <article class:list={['post', e.article && 'post--article']} aria-labelledby={`p-${e.key}`}>
        <time class="date" datetime={e.times.verified}>{fixDate(e.times.verified)}</time>
        <h2 class="post-title" id={`p-${e.key}`}>
          {e.article ? <a href={articleUrl(e.key)}>{e.title}</a> : e.title}
        </h2>
        <Glance before={e.glance.before} after={e.glance.after} label={e.glance.label} quoted={e.glance.quoted} size="md" />
        {e.visual && !e.article && <div class="shots"><ShotSlot shape={e.screen === 'phone' ? 'tall' : 'wide'} /></div>}
        <p class="links">
          {e.article && <a href={articleUrl(e.key)} class="story">Read the story</a>}
          <a href={prUrl(e.pr.number)} class="change">See the change</a>
          {e.status === 'reopened' && <span class="open">Still open</span>}
        </p>
      </article>
    ))}
  </div>
</Layout>

<style>
  .column {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 20px 96px;
  }

  .head { padding: 56px 0 8px; }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--ink);
  }

  .how { margin: 14px 0 0; font-size: 17px; line-height: 1.5; color: var(--ink-5); }

  .post {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 44px 0;
    border-bottom: 1px solid var(--rule);
  }

  .date { font-size: 15px; color: var(--ink-6); }

  .post-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -.025em;
    color: var(--ink);
  }

  .post-title a { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--rule); }
  .post-title a:hover { text-decoration-color: var(--ink); }

  .shots { margin-top: 4px; }

  .links { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 2px 0 0; font-size: 17px; }

  .story { font-weight: 700; color: var(--ink); }
  .story::after, .change::after { content: ' →'; }
  .change { color: var(--writing); }
  .change:hover { color: var(--writing-hover); }

  .open { font-weight: 700; color: oklch(0.46 0.13 40); }

  @media (max-width: 720px) {
    .head { padding-top: 32px; }
    .title { font-size: 48px; }
    .post { padding: 34px 0; }
    .post-title { font-size: 24px; }
    .links a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

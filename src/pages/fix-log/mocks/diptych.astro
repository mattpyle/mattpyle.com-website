---
/**
 * Fix-log mock, round two: Diptych. Picture first.
 *
 * Every fix is two big panels side by side, before and after. Where something
 * visible changed, the panels are the screenshots, at a size that shows the page.
 * Where nothing visible changed, the panels carry the number or the words, set large
 * on the before and after grounds. A title and a link sit above; nothing else.
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import ShotSlot from '../../../components/fix-log-mocks/ShotSlot.astro';
import { ENTRIES_NEWEST, HOW_MADE, prUrl } from '../../../data/fix-log-sample';

const show = (v: string, quoted?: boolean) => (quoted ? `“${v}”` : v);
---

<Layout title="Fix log: Diptych mock" description="Design mock: each fix as two big panels, before and after." noindex>
  <MockBar slug="diptych" />

  <header class="rd-section head">
    <h1 class="title">Fixed</h1>
    <p class="how">{HOW_MADE}</p>
  </header>

  <div class="rd-section fixes">
    {ENTRIES_NEWEST.map((e) => (
      <article class="fix" aria-labelledby={`d-${e.key}`}>
        <header class="fix-head">
          <h2 class="fix-title" id={`d-${e.key}`}>
            {e.article ? <a href={`/fix-log/mocks/posts/${e.key.toLowerCase()}/`}>{e.title}</a> : e.title}
          </h2>
          <a href={prUrl(e.pr.number)} class="change">See the change</a>
        </header>

        <div class:list={['panels', e.screen === 'phone' && 'panels--phone']}>
          {(['before', 'after'] as const).map((side) => (
            <div class:list={['panel', `panel--${side}`, e.visual && 'panel--shot']}>
              <span class="panel-tag">{side === 'before' ? 'Before' : 'After'}</span>
              {e.visual ? (
                <ShotSlot side={side} shape={e.screen === 'phone' ? 'tall' : 'wide'} />
              ) : (
                <span class:list={['panel-value', e.glance.quoted && 'panel-value--quoted']}>
                  {show(side === 'before' ? e.glance.before : e.glance.after, e.glance.quoted)}
                </span>
              )}
            </div>
          ))}
        </div>
        <p class="fix-label">
          {e.visual ? <>{e.glance.label}: {e.glance.before} before, {e.glance.after} after.</> : e.glance.label}
          {e.status === 'reopened' && <span class="open"> Still open.</span>}
        </p>
      </article>
    ))}
  </div>
</Layout>

<style>
  .head { padding-top: 56px; padding-bottom: 24px; }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--ink);
  }

  .how { margin: 14px 0 0; max-width: 60ch; font-size: 17px; line-height: 1.5; color: var(--ink-5); }

  .fixes { padding-bottom: 96px; }

  .fix { padding-top: 64px; }

  .fix-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    margin-bottom: 18px;
  }

  .fix-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -.025em;
    color: var(--ink);
  }

  .fix-title a { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--rule); }

  .change { font-size: 17px; color: var(--writing); white-space: nowrap; }
  .change:hover { color: var(--writing-hover); }
  .change::after { content: ' →'; }

  .panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* A phone fix keeps its screenshots phone-shaped, centred, rather than stretched. */
  .panels--phone { grid-template-columns: minmax(0, 320px) minmax(0, 320px); justify-content: center; }

  .panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    padding: 24px;
    border-radius: 14px;
    min-width: 0;
  }

  .panel--before { background: oklch(0.955 0.022 45); }
  .panel--after { background: oklch(0.955 0.035 150); }

  .panel--shot { aspect-ratio: auto; display: block; padding: 44px 12px 12px; }

  .panel-tag {
    position: absolute;
    top: 16px;
    left: 20px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .panel--before .panel-tag { color: oklch(0.46 0.13 40); }
  .panel--after .panel-tag { color: oklch(0.42 0.11 150); }

  .panel-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(72px, 11vw, 168px);
    line-height: .9;
    letter-spacing: -.045em;
    text-align: center;
    color: var(--ink);
  }

  .panel--before .panel-value { color: oklch(0.36 0.03 40); }

  .panel-value--quoted {
    font-weight: 600;
    font-size: clamp(26px, 3.6vw, 48px);
    line-height: 1.1;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .fix-label { margin: 12px 0 0; font-size: 16px; color: var(--ink-6); text-align: center; }

  .open { font-weight: 700; color: oklch(0.46 0.13 40); }

  @media (max-width: 720px) {
    .head { padding-top: 32px; }
    .title { font-size: 48px; }
    .fix { padding-top: 48px; }
    .fix-title { font-size: 23px; }
    .panels { gap: 8px; }
    .panel { aspect-ratio: 4 / 5; padding: 14px; }
    .panel--shot { aspect-ratio: auto; padding: 40px 8px 8px; }
    .panel-tag { top: 12px; left: 12px; }
    .panel-value { font-size: 64px; }
    .panel-value--quoted { font-size: 21px; }
    .change { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

---
/**
 * Fix-log mock 3, Front page (adventurous). An editor's page, not a database.
 *
 * Curation answers sameness: one fix told as a story because it teaches the most
 * (MP-48, the loop's own mistake), two told as short features because each shows one
 * thing (a fix that waited in a queue, and one an agent needed), and the rest in a
 * dense list. At 75 entries the list grows and the stories rotate; picking them is an
 * editorial act, which is the cost of this direction.
 *
 * The prose is written for this mock from the finding, the pull requests and cards
 * MPW-538 and MPW-540. Times are Vancouver time.
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import ShotSlot from '../../../components/fix-log-mocks/ShotSlot.astro';
import {
  ENTRIES_NEWEST, FIX_ENTRIES, HOW_MADE, TYPE_LABEL, fixDate, fixSpan, fixTime, formatSpan, prUrl,
} from '../../../data/fix-log-sample';

const byKey = (k: string) => FIX_ENTRIES.find((e) => e.key === k)!;
const lead = byKey('MP-48');
const slow = byKey('MP-31');
const agentFeed = byKey('MP-136');
const rest = ENTRIES_NEWEST.filter((e) => ![lead.key, slow.key, agentFeed.key].includes(e.key));
---

<Layout title="Fix log: Front page mock" description="Design mock: the fix log as an editor's front page." noindex>
  <MockBar slug="front-page" />

  <header class="rd-section mast">
    <p class="mast-line">
      <span>Fix log</span>
      <span>{fixDate(ENTRIES_NEWEST[0].times.verified)}</span>
    </p>
    <p class="mast-how">{HOW_MADE}</p>
  </header>

  <article class="rd-section lead" aria-labelledby="lead-title">
    <h1 class="lead-title" id="lead-title">The fix that helped one post in three, and made the page jump</h1>
    <p class="lead-deck">An automated fix for phone readers half worked, and broke something nobody had measured. This is how the loop found out.</p>
    <p class="kicker-line">{lead.key}, {TYPE_LABEL[lead.type]}, reopened</p>

    <div class="lead-grid">
      <div class="lead-body">
        <p>On a phone, a post made a newcomer scroll past nearly two screens of links and buttons before the first sentence. On the WebMCP post, that sentence started 1,594px down.</p>
        <p>Matt approved the finding on {fixDate(lead.times.approved)}. On {fixDate(lead.times.prOpened)} the fixer opened a pull request. It collapsed the “On this page” list on phones and laid the action buttons in a row. It merged 31 minutes later.</p>
        <p>Five minutes after the merge, the same check ran on the live site. One post of three now started on the first screen. Two still did not, so the finding went back to open.</p>
        <p>The fix also did something nobody checked for. The list was drawn open and a script closed it. On a slow phone the script ran after the page had drawn, and the rail and the hero image jumped. The layout shift measured 0.107 to 0.147, and the nightly Scorecard named three posts for it.</p>
        <p>A second pull request, made outside the loop, serves the list already closed. In 18 test loads on a slowed phone, 15 read 0.0000 and the worst read 0.0083.</p>
        <p>The phone layout of a post is now being designed, not patched. The finding stays open until it is.</p>
        <p class="lead-links">
          <a href={prUrl(lead.pr.number)}>{lead.pr.title}</a>
          <a href={prUrl(lead.followUp!.number)}>{lead.followUp!.title}</a>
        </p>
      </div>

      <aside class="lead-figures" aria-label="Before and after">
        <div class="fig">
          <span class="fig-label">before</span>
          <span class="fig-num fig-num--before">1,594px</span>
          <span class="fig-cap">from the top of the WebMCP post to its first sentence, on a phone</span>
        </div>
        <div class="fig">
          <span class="fig-label">after the fix</span>
          <span class="fig-num">1 of 3</span>
          <span class="fig-cap">posts start on the first screen</span>
        </div>
        <div class="fig">
          <span class="fig-label">what the fix broke</span>
          <span class="fig-num fig-num--before">0.147</span>
          <span class="fig-cap">worst layout shift as the list closed</span>
        </div>
        <div class="fig">
          <span class="fig-label">after the repair</span>
          <span class="fig-num">0.0083</span>
          <span class="fig-cap">worst of 18 loads</span>
        </div>
        <ShotSlot layout="stack" />
      </aside>
    </div>
  </article>

  <div class="rd-section features">
    <article class="feature" aria-labelledby="f-slow">
      <h2 class="feature-title" id="f-slow">25 days waiting, 37 minutes working</h2>
      <p class="kicker-line">{slow.key}, {TYPE_LABEL[slow.type]}</p>
      <div class="feature-pair">
        <p><span class="pair-label">before</span> A visitor who finished the oldest post found nothing more to read: the post ended, then the footer.</p>
        <p><span class="pair-label">after</span> Every post ends with a newer and an older link. The oldest post points to “Hello, World!”.</p>
      </div>
      <p class="feature-body">Matt approved the fix on {fixDate(slow.times.approved)}. It then sat in a queue for 25 days before a pull request opened. From there it took 37 minutes to merge and check on the live site. The wait was the queue, not the work.</p>
      <p class="feature-link"><a href={prUrl(slow.pr.number)}>{slow.pr.title}</a></p>
    </article>

    <article class="feature" aria-labelledby="f-feed">
      <h2 class="feature-title" id="f-feed">An agent looked for the feed and found none</h2>
      <p class="kicker-line">{agentFeed.key}, {TYPE_LABEL[agentFeed.type]}</p>
      <div class="feature-pair">
        <p><span class="pair-label">before</span> llms.txt listed 15 machine-readable resources and neither RSS feed.</p>
        <p><span class="pair-label">after</span> Both feeds are listed, one line each.</p>
      </div>
      <p class="feature-body">People now ask an assistant to follow a writer for them. The assistant starts at llms.txt, which this site points agents to first. Approved at {fixTime(agentFeed.times.approved)}, live and checked at {fixTime(agentFeed.times.verified)} the same evening.</p>
      <p class="feature-link"><a href={prUrl(agentFeed.pr.number)}>{agentFeed.pr.title}</a></p>
    </article>
  </div>

  <section class="rd-section more" aria-labelledby="more-title">
    <h2 class="more-title" id="more-title">Also fixed</h2>
    <ul class="more-list">
      {rest.map((e) => (
        <li class="more-row">
          <div class="more-head">
            <h3 class="more-name">{e.title}</h3>
            <span class="more-kind">{TYPE_LABEL[e.type]}</span>
          </div>
          <p class="more-side"><span class="pair-label">before</span> {e.before.text}</p>
          <p class="more-side"><span class="pair-label">after</span> {e.after.text}</p>
          <p class="more-foot">
            <a href={prUrl(e.pr.number)}>PR {e.pr.number}</a>
            <span>{e.confirmedBy === 'deploy' ? 'confirmed by its deploy' : 'verified live'} {formatSpan(fixSpan(e))} after approval</span>
          </p>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .mast {
    padding-top: 40px;
    padding-bottom: 8px;
  }

  .mast-line {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .mast-line span:last-child { font-family: var(--font-mono-plex); font-weight: 400; font-size: 17px; color: var(--ink-5); }

  .mast-how {
    margin: 12px 0 0;
    max-width: 90ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-6);
  }

  .kicker-line {
    margin: 14px 0 0;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .lead { padding-top: 56px; }

  .lead-title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 6.4vw, 84px);
    line-height: .98;
    letter-spacing: -.04em;
    color: var(--ink);
    text-wrap: balance;
  }

  .lead-deck {
    margin: 24px 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.3;
    letter-spacing: -.015em;
    color: var(--ink-3);
  }

  .lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 56px;
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .lead-body p {
    margin: 0 0 1.1em;
    max-width: 62ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .lead-body p:first-child::first-line { font-weight: 600; }

  .lead-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lead-links a,
  .feature-link a,
  .more-foot a {
    color: var(--writing);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .lead-links a:hover,
  .feature-link a:hover,
  .more-foot a:hover { color: var(--writing-hover); }

  .lead-figures {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-left: 32px;
    border-left: 1px solid var(--rule);
  }

  .fig { display: flex; flex-direction: column; gap: 4px; }

  .fig-label,
  .pair-label {
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .fig-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -.04em;
    color: var(--ink);
  }

  .fig-num--before { color: var(--ink-6); }

  .fig-cap { font-size: 15px; line-height: 1.45; color: var(--ink-5); }

  .features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 72px;
  }

  .feature {
    padding: 36px 40px 0 0;
    border-top: 3px solid var(--ink);
  }

  .feature + .feature { padding: 36px 0 0 40px; border-left: 1px solid var(--rule); }

  .feature-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: -.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .feature-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 22px 0;
  }

  .feature-pair p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .feature-pair p + p { padding-left: 20px; border-left: 1px solid var(--rule); }

  .feature-body {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-5);
  }

  .feature-link { margin: 16px 0 0; font-size: 17px; }

  .more { padding-top: 88px; padding-bottom: 96px; }

  .more-title {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 32px;
  }

  .more-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }

  .more-head { display: flex; flex-direction: column; gap: 4px; }

  .more-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -.015em;
    color: var(--ink);
  }

  .more-kind { font-family: var(--font-mono-plex); font-size: 15px; color: var(--ink-6); }

  .more-side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-4);
  }

  .more-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: auto 0 0;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  @media (max-width: 960px) {
    .more-list { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 720px) {
    .lead { padding-top: 36px; }
    .lead-deck { font-size: 21px; }
    .lead-grid { grid-template-columns: 1fr; gap: 32px; }
    .lead-body p { font-size: 18px; }
    .lead-figures { padding-left: 0; border-left: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px 16px; }
    .lead-figures :global(.shots) { grid-column: 1 / -1; }
    .fig-num { font-size: 40px; }
    .features { grid-template-columns: 1fr; margin-top: 48px; }
    .feature, .feature + .feature { padding: 28px 0 36px; border-left: 0; }
    .feature-title { font-size: 30px; }
    .feature-pair { grid-template-columns: 1fr; gap: 14px; }
    .feature-pair p + p { padding-left: 0; border-left: 0; }
    .more { padding-top: 48px; }
    .more-list { grid-template-columns: 1fr; }
    .lead-links a, .feature-link a, .more-foot a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

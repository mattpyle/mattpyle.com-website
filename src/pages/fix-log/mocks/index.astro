---
/**
 * Fix log index, design mock round four (MPW-543). Taken from what the site has:
 * the /changelog hero (ChangelogHero.astro) and its year-grouped rows
 * (ChangelogLog.astro). Each row is a date, a title and its one-sentence lead, and
 * the fix's kind at the end, where the changelog puts an entry's type. Each row opens
 * the fix's own page.
 *
 * Built in the site's own colours; the H1 fill is ink until the page ships with a
 * section colour. noindex, out of the sitemap, llms.txt and the nav.
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import { ENTRIES_NEWEST, TYPE_LABEL, fixDate } from '../../../data/fix-log-sample';

const groups: { year: string; items: typeof ENTRIES_NEWEST }[] = [];
for (const e of ENTRIES_NEWEST) {
  const year = fixDate(e.times.verified).slice(-4);
  const g = groups.at(-1);
  if (g && g.year === year) g.items.push(e);
  else groups.push({ year, items: [e] });
}
const latest = fixDate(ENTRIES_NEWEST[0].times.verified);
---

<Layout title="Fix log: design mock" description="Design mock: problems on this site that its agents found, and the fixes they made." noindex>
  <MockBar />

  <div class="rd-section rd-hero fixlog-hero">
    <h1><span class="rd-fill rd-fill--ink">Fix log</span></h1>
    <div class="hero-row">
      <p class="hero-statement">Problems on this site that its agents found, and the fixes they made.</p>
      <div class="hero-aside facts">
        <span>{ENTRIES_NEWEST.length} fixes, latest {latest}.</span>
      </div>
    </div>
  </div>

  <section class="rd-section log" aria-labelledby="log-title">
    <h2 id="log-title" class="sr-only">All fixes</h2>
    {groups.map((g) => (
      <div class="year-group">
        <div class="year">{g.year}</div>
        {g.items.map((e) => (
          <a href={`/fix-log/mocks/${e.slug}/`} class="row">
            <time datetime={e.times.verified} class="row-date">{fixDate(e.times.verified)}</time>
            <span class="row-body">
              <span class="row-title">{e.title}</span>
              <span class="row-summary">{e.dek}</span>
            </span>
            <span class="row-kind">
              <span>{TYPE_LABEL[e.type]}</span>
              {e.status === 'reopened' && <span class="row-open">still open</span>}
            </span>
          </a>
        ))}
        <div class="rows-end"></div>
      </div>
    ))}
  </section>
</Layout>

<style>
  /* ── The changelog hero ── */
  .fixlog-hero { padding-top: 78px; }

  .facts { font-size: 17px; color: var(--ink-5); }

  /* ── The changelog's rows ── */
  .log { padding-top: 56px; padding-bottom: 96px; }

  .year-group + .year-group { margin-top: 56px; }

  .year {
    padding-bottom: 8px;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) max-content;
    gap: 36px;
    align-items: start;
    padding: 28px 20px;
    margin: 0 -20px;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: background 240ms ease;
  }

  .row:hover { background: var(--tint-writing); }

  .rows-end { border-top: 1px solid var(--rule); }

  .row-date {
    padding-top: 7px;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .row-body { display: flex; flex-direction: column; gap: 10px; }

  .row-title {
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.16;
    letter-spacing: -.025em;
  }

  .row-summary {
    max-width: 64ch;
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--ink-5);
    text-wrap: pretty;
  }

  .row-kind {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 7px;
    text-align: right;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
    white-space: nowrap;
  }

  .row-open { color: var(--ink); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .fixlog-hero { padding-top: 40px; }
    .log { padding-top: 40px; }

    .row {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 22px 0;
      margin: 0;
    }

    .row-date { padding-top: 0; font-size: 16px; }
    .row-title { font-size: 25px; line-height: 1.2; }
    .row-summary { font-size: 17px; }
    .row-kind { flex-direction: row; gap: 14px; padding-top: 0; text-align: left; font-size: 16px; }
  }
</style>

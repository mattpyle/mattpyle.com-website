---
/**
 * Fix-log mock, round two: the article a fix earns (Posts direction).
 *
 * MP-48, the loop's own mistake. The numbers lead: two before-and-after pairs, then
 * the screenshots at phone shape and full size, then the story in a few short
 * paragraphs. No rail, so nothing caps the screenshots' size.
 *
 * Facts from the finding, pull requests 572 and 641, and cards MPW-538 and MPW-540.
 */
import Layout from '../../../../layouts/Layout.astro';
import MockBar from '../../../../components/fix-log-mocks/MockBar.astro';
import Glance from '../../../../components/fix-log-mocks/Glance.astro';
import ShotSlot from '../../../../components/fix-log-mocks/ShotSlot.astro';
import { FIX_ENTRIES, fixDate, prUrl } from '../../../../data/fix-log-sample';

const e = FIX_ENTRIES.find((x) => x.key === 'MP-48')!;
---

<Layout title="Fix log: MP-48 article mock" description="Design mock: one fix told as an article." noindex>
  <MockBar slug="posts" />

  <article class="article" aria-labelledby="a-title">
    <header class="head">
      <a href="/fix-log/mocks/posts/" class="back">← All fixes</a>
      <time class="date" datetime={e.times.verified}>{fixDate(e.times.verified)}</time>
      <h1 class="title" id="a-title">{e.title}</h1>
      <p class="dek">An automated fix half worked, and made the page jump. It is still open.</p>
    </header>

    <div class="pairs">
      <Glance before={e.glance.before} after={e.glance.after} label={e.glance.label} size="lg" />
      <Glance before="0.147" after="0.0083" label="worst layout shift on a slow phone, caused by the fix and then repaired" size="lg" />
    </div>

    <div class="shots">
      <ShotSlot shape="tall" />
    </div>

    <div class="story">
      <p>On a phone, a post opened with nearly two screens of links and buttons before its first sentence.</p>
      <p>The fix collapsed the contents list and put the buttons in a row. One post of three then started on the first screen. Two still did not, so the finding reopened.</p>
      <p>The collapse also ran after the page had drawn, so the page jumped. A second change served the list already closed, and the jump went away.</p>
      <p>The phone layout of a post is now being designed properly.</p>
    </div>

    <p class="links">
      <a href={prUrl(e.pr.number)}>See the fix</a>
      <a href={prUrl(e.followUp!.number)}>See the repair</a>
    </p>
  </article>
</Layout>

<style>
  .article { padding: 0 20px 96px; }

  .head, .story, .links { max-width: 720px; margin-left: auto; margin-right: auto; }

  .head { padding-top: 40px; }

  .back { display: inline-block; margin-bottom: 28px; font-size: 16px; color: var(--writing); }

  .date { display: block; font-size: 15px; color: var(--ink-6); }

  .title {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -.035em;
    color: var(--ink);
    text-wrap: balance;
  }

  .dek { margin: 14px 0 0; font-size: 20px; line-height: 1.45; color: var(--ink-4); }

  .pairs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    max-width: 760px;
    margin: 44px auto 0;
  }

  .shots { max-width: 760px; margin: 48px auto 0; }

  .story { margin-top: 48px; }

  .story p { margin: 0 0 1em; font-size: 19px; line-height: 1.6; color: var(--ink-2); }

  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 17px; }
  .links a { color: var(--writing); }
  .links a::after { content: ' →'; }

  @media (max-width: 720px) {
    .title { font-size: 34px; }
    .dek { font-size: 18px; }
    .pairs { grid-template-columns: 1fr; gap: 20px; margin-top: 32px; }
    .story p { font-size: 18px; }
    .links a, .back { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

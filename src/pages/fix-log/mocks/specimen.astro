---
/**
 * Fix-log mock 2, Specimen (conservative). Show the thing, not a description of it.
 *
 * Each fix is a band with two panes. The before pane is a ghost: a dashed outline on
 * the page ground, the artefact in muted ink. The after pane is solid: white surface,
 * full ink. The artefact is the changed thing itself: a count set at the size of the
 * Scorecard's numbers, the lines of llms.txt, the words a screen reader spoke. The
 * sentence of explanation sits under each artefact, smaller, so the eye meets the
 * evidence first.
 *
 * Where something visible changed, the screenshot pair takes the panes' place later;
 * the placeholder sits under the panes until then.
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import ShotSlot from '../../../components/fix-log-mocks/ShotSlot.astro';
import SpecimenView from '../../../components/fix-log-mocks/SpecimenView.astro';
import {
  ENTRIES_NEWEST, HOW_MADE, TYPE_LABEL, fixDate, fixSpan, formatSpan, prUrl,
} from '../../../data/fix-log-sample';
---

<Layout title="Fix log: Specimen mock" description="Design mock: each fix shown as the thing that changed." noindex>
  <MockBar slug="specimen" />

  <div class="rd-section rd-hero spec-hero">
    <h1><span class="rd-fill rd-fill--ink">Fixed</span></h1>
    <div class="hero-row">
      <p class="hero-statement">Each fix on this site, shown as the thing that changed.</p>
      <p class="hero-aside spec-how">{HOW_MADE}</p>
    </div>
  </div>

  <div class="rd-section bands">
    {ENTRIES_NEWEST.map((e) => (
      <article class="band" aria-labelledby={`s-${e.key}`}>
        <header class="band-head">
          <h2 class="band-title" id={`s-${e.key}`}>{e.title}</h2>
          <p class="band-who">{e.who}.</p>
          <p class="band-meta">
            <span>{e.key}</span>
            <span>{TYPE_LABEL[e.type]}</span>
            {e.status === 'reopened' && <span class="meta-open">reopened</span>}
          </p>
        </header>

        <div class="panes">
          <section class="pane pane--before" aria-label="Before">
            <p class="pane-label">before <span class="pane-when">until {fixDate(e.times.merged)}</span></p>
            <SpecimenView specimen={e.before.specimen} side="before" />
            <p class="pane-text">{e.before.text}</p>
          </section>
          <section class="pane pane--after" aria-label="After">
            <p class="pane-label">after <span class="pane-when">since {fixDate(e.times.merged)}</span></p>
            <SpecimenView specimen={e.after.specimen} side="after" />
            <p class="pane-text">{e.after.text}</p>
          </section>
        </div>

        {e.visual && <div class="band-shots"><ShotSlot /></div>}

        <footer class="band-foot">
          <a href={prUrl(e.pr.number)} class="band-pr">{e.pr.title}</a>
          {e.followUp && <a href={prUrl(e.followUp.number)} class="band-pr">{e.followUp.title}</a>}
          <span class="band-time">
            {e.confirmedBy === 'deploy'
              ? `confirmed by its deploy, ${formatSpan(fixSpan(e))} after approval`
              : e.status === 'reopened'
                ? `checked ${formatSpan(fixSpan(e))} after approval, and reopened`
                : `verified live ${formatSpan(fixSpan(e))} after approval`}
          </span>
        </footer>
      </article>
    ))}
  </div>
</Layout>

<style>
  .spec-hero { padding-top: 64px; }

  .spec-how {
    margin: 0;
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-5);
  }

  .bands { padding-top: 48px; padding-bottom: 96px; }

  .band {
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }

  .band:last-child { border-bottom: 1px solid var(--rule); }

  .band-head { max-width: 760px; }

  .band-meta {
    display: flex;
    gap: 16px;
    margin: 12px 0 0;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .meta-open { color: var(--status-fail); }

  .band-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .band-who {
    margin: 14px 0 0;
    font-size: 17px;
    color: var(--ink-5);
  }

  .panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: 26px 28px 28px;
    border-radius: var(--radius);
  }

  /* The before is a ghost of the thing: an outline on the page, nothing filled. */
  .pane--before { border: 1px dashed var(--ink-6); }

  /* The after is the thing as it stands: a solid white surface. */
  .pane--after {
    background: var(--surface);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 0 var(--rule-2), 0 12px 32px -24px oklch(0.21 0.012 265 / .35);
  }

  .pane-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink);
  }

  .pane-when { color: var(--ink-6); }

  .pane-text {
    margin: auto 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-5);
    text-wrap: pretty;
  }

  .pane--after .pane-text { color: var(--ink-3); }

  .band-shots { margin-top: 20px; }

  .band-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
    margin-top: 24px;
    font-size: 17px;
  }

  .band-pr {
    color: var(--writing);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .band-pr:hover { color: var(--writing-hover); }

  .band-time {
    margin-left: auto;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  @media (max-width: 720px) {
    .spec-hero { padding-top: 40px; }
    .bands { padding-top: 24px; }
    .band { padding: 44px 0; }
    .band-title { font-size: 32px; }
    .panes { grid-template-columns: 1fr; gap: 14px; margin-top: 26px; }
    .pane { padding: 20px; }
    .band-time { margin-left: 0; }
    .band-pr { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

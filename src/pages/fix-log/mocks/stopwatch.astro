---
/**
 * Fix-log mock 4, Stopwatch (adventurous). Time is the story.
 *
 * Every fix is one track on a shared axis. The spine in the middle is the moment Matt
 * said yes. To the left, a dashed line runs back to the day the problem was found:
 * the wait for a decision. To the right, a solid line runs on to the check on the live
 * site, with marks where the pull request opened and merged. Both halves use the same
 * logarithmic scale, so 18 minutes and 25 days fit on one page and still read as
 * different.
 *
 * The before text sits under the left half, the past, and the after under the right,
 * the present. So the time axis is also the before-and-after axis.
 *
 * Drawn in SVG with percentage coordinates and no viewBox, so it stretches to any
 * width without scaling its strokes or its 15px labels, and needs no inline style
 * (the CSP refuses one).
 */
import Layout from '../../../layouts/Layout.astro';
import MockBar from '../../../components/fix-log-mocks/MockBar.astro';
import ShotSlot from '../../../components/fix-log-mocks/ShotSlot.astro';
import {
  FIX_ENTRIES, HOW_MADE, TYPE_LABEL, fixSpan, formatSpan, minutesBetween, prUrl,
} from '../../../data/fix-log-sample';

const MIN = 5;              // 5 minutes at the spine
const MAX = 60 * 24 * 45;   // 45 days at the edge
const L0 = Math.log10(MIN);
const L1 = Math.log10(MAX);
const reach = (minutes: number) => {
  const m = Math.min(Math.max(minutes, MIN), MAX);
  return ((Math.log10(m) - L0) / (L1 - L0)) * 48; // percent of the full width, per half
};
const right = (minutes: number) => `${(50 + reach(minutes)).toFixed(2)}%`;
const left = (minutes: number) => `${(50 - reach(minutes)).toFixed(2)}%`;

// `wide` labels are hidden on a phone, where only 1 hour and 1 day fit.
const TICKS = [
  { m: 15, label: '15 min', wide: true },
  { m: 60, label: '1 hour', wide: false },
  { m: 60 * 24, label: '1 day', wide: false },
  { m: 60 * 24 * 7, label: '1 week', wide: true },
  { m: 60 * 24 * 30, label: '1 month', wide: true },
];

const entries = [...FIX_ENTRIES].sort((a, b) => fixSpan(a) - fixSpan(b));
const tracks = entries.map((e) => {
  const t = e.times;
  const waited = minutesBetween(t.found, t.approved);
  return {
    e,
    waited,
    fixing: fixSpan(e),
    toPr: minutesBetween(t.approved, t.prOpened),
    toMerge: minutesBetween(t.approved, t.merged),
  };
});

const fastest = formatSpan(fixSpan(entries[0]));
const slowest = formatSpan(fixSpan(entries.at(-1)!));
---

<Layout title="Fix log: Stopwatch mock" description="Design mock: every fix drawn to scale in time." noindex>
  <MockBar slug="stopwatch" />

  <div class="rd-section rd-hero sw-hero">
    <h1><span class="rd-fill rd-fill--ink">Fixes</span></h1>
    <div class="hero-row">
      <p class="hero-statement">How long each fix on this site took, from the day it was found to the minute it held.</p>
      <div class="hero-aside sw-aside">
        <span><span class="aside-num">{fastest}</span> the fastest</span>
        <span><span class="aside-num">{slowest}</span> the slowest</span>
      </div>
    </div>
    <p class="how">{HOW_MADE}</p>
  </div>

  <section class="rd-section chart" aria-labelledby="chart-title">
    <h2 id="chart-title" class="chart-title">Every fix, fastest first</h2>

    <div class="key" aria-hidden="true">
      <span class="key-left">← waiting for a yes</span>
      <span class="key-mid">approved</span>
      <span class="key-right">fixing, until it held →</span>
    </div>

    <svg class="axis" width="100%" height="28" aria-hidden="true" focusable="false">
      {TICKS.map((t) => (
        <>
          <text x={left(t.m)} y="18" text-anchor="middle" class:list={['tick-label', t.wide && 'tick-wide']}>{t.label}</text>
          <text x={right(t.m)} y="18" text-anchor="middle" class:list={['tick-label', t.wide && 'tick-wide']}>{t.label}</text>
        </>
      ))}
    </svg>

    <ol class="tracks">
      {tracks.map(({ e, waited, fixing, toPr, toMerge }) => (
        <li class="track">
          <div class="track-head">
            <h3 class="track-title">{e.title}</h3>
            <span class="track-span">{formatSpan(fixing)}{e.status === 'reopened' ? ', reopened' : ''}</span>
          </div>

          <svg class="line" width="100%" height="34" role="img"
            aria-label={`Waited ${formatSpan(waited)} for approval, then ${formatSpan(fixing)} from approval to ${e.status === 'reopened' ? 'the check that reopened it' : 'verified'}.`}>
            {TICKS.map((t) => (
              <>
                <line x1={left(t.m)} x2={left(t.m)} y1="0" y2="34" class="grid" />
                <line x1={right(t.m)} x2={right(t.m)} y1="0" y2="34" class="grid" />
              </>
            ))}
            <line x1={left(waited)} x2="50%" y1="17" y2="17" class="wait" />
            <circle cx={left(waited)} cy="17" r="4" class="dot-found" />
            <line x1="50%" x2="50%" y1="2" y2="32" class="spine" />
            <line x1="50%" x2={right(fixing)} y1="17" y2="17" class:list={['fix', e.status === 'reopened' && 'fix--open']} />
            <line x1={right(toPr)} x2={right(toPr)} y1="10" y2="24" class="mark" />
            <line x1={right(toMerge)} x2={right(toMerge)} y1="10" y2="24" class="mark" />
            <circle cx={right(fixing)} cy="17" r="6" class:list={['dot-done', e.status === 'reopened' && 'dot-open']} />
          </svg>

          <div class="track-facts" aria-hidden="true">
            <span>found, then {formatSpan(waited)} to a yes</span>
            <span>pull request in {formatSpan(toPr)}, merged at {formatSpan(toMerge)}</span>
          </div>

          <div class="track-pair">
            <p class="track-before"><span class="pair-label">before</span> {e.before.text}</p>
            <p class="track-after"><span class="pair-label">after</span> {e.after.text}</p>
          </div>

          {e.visual && <div class="track-shots"><ShotSlot /></div>}

          <p class="track-foot">
            <a href={prUrl(e.pr.number)}>{e.pr.title}</a>
            <span>{e.key}, {TYPE_LABEL[e.type]}</span>
          </p>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .sw-hero { padding-top: 64px; }

  .sw-aside { gap: 8px; font-size: 17px; color: var(--ink-5); }

  .aside-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -.03em;
    color: var(--ink);
    margin-right: 6px;
  }

  .how {
    margin: 36px 0 0;
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-5);
  }

  .chart { padding-top: 64px; padding-bottom: 96px; }

  .chart-title {
    margin: 0 0 28px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -.02em;
  }

  .key {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .key-left { text-align: right; }
  .key-mid { color: var(--ink); }

  .axis { display: block; margin-top: 6px; overflow: visible; }

  .tick-label {
    font-family: var(--font-mono-plex);
    font-size: 15px;
    fill: var(--ink-6);
  }

  .tracks { list-style: none; margin: 0; padding: 0; }

  .track {
    padding: 30px 0 34px;
    border-top: 1px solid var(--rule);
  }

  .track:last-child { border-bottom: 1px solid var(--rule); }

  .track-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
  }

  .track-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -.025em;
    color: var(--ink);
  }

  .track-span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .line { display: block; margin-top: 16px; overflow: visible; }

  .grid { stroke: var(--rule-2); stroke-width: 1; }

  .wait {
    stroke: var(--ink-6);
    stroke-width: 2;
    stroke-dasharray: 3 5;
  }

  .spine { stroke: var(--ink); stroke-width: 2; }

  .fix { stroke: var(--ink); stroke-width: 6; stroke-linecap: round; }
  .fix--open { stroke: var(--status-fail); }

  .mark { stroke: var(--paper); stroke-width: 2; }

  .dot-found { fill: var(--bg); stroke: var(--ink-6); stroke-width: 2; }
  .dot-done { fill: var(--ink); }
  .dot-open { fill: var(--paper); stroke: var(--status-fail); stroke-width: 3; }

  .track-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 8px;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .track-facts span:first-child { text-align: right; }

  /* Before under the past, after under the present: the halves of the axis. */
  .track-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 18px;
  }

  .track-pair p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .track-before { color: var(--ink-5); text-align: right; align-items: flex-end; }
  .track-after { color: var(--ink-2); }

  .pair-label { font-family: var(--font-mono-plex); font-size: 15px; color: var(--ink-6); }

  .track-shots { max-width: 560px; margin: 20px auto 0; }

  .track-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 20px;
    margin: 18px 0 0;
    font-size: 16px;
  }

  .track-foot a {
    color: var(--writing);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .track-foot a:hover { color: var(--writing-hover); }

  .track-foot span { font-family: var(--font-mono-plex); font-size: 15px; color: var(--ink-6); }

  @media (max-width: 720px) {
    .sw-hero { padding-top: 40px; }
    .chart { padding-top: 40px; }
    .tick-wide { display: none; }
    .track-title, .track-span { font-size: 23px; }
    .key { font-size: 15px; grid-template-columns: 1fr; text-align: center; }
    .key-left { text-align: center; }
    .track-facts, .track-pair { grid-template-columns: 1fr; gap: 10px; }
    .track-facts span:first-child { text-align: left; }
    .track-before { text-align: left; align-items: flex-start; }
    .track-foot { justify-content: flex-start; }
    .track-foot a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>

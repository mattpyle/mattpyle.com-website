---
import '../styles/global.css';
import '../styles/retro.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import WebMCP from '../components/WebMCP.astro';
import AppearanceBanner from '../components/AppearanceBanner.astro';
import AppearanceUI from '../components/AppearanceUI.astro';
import { PRE_PAINT_APPEARANCE_SCRIPT } from '../lib/pre-paint-appearance.mjs';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  /** Used verbatim as the <title>/og:title/twitter:title, skipping the "— Matt Pyle" suffix. For pages (e.g. the homepage) whose title already is the full entity-disambiguating string. */
  fullTitle?: string;
  /** Short override for <title>/og:title/twitter:title only — `title` still feeds the JSON-LD headline. Use when the on-page title is too long for SERPs (~60 chars incl. " — Matt Pyle"). */
  seoTitle?: string;
  description?: string;
  /** Short override for <meta description>/og/twitter descriptions only — `description` still feeds the visible dek and JSON-LD. Use when the on-page description exceeds ~155 chars. */
  seoDescription?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  /** Path to this page's raw-markdown variant (e.g. `/writing/<slug>.md`) — see src/pages/writing/[slug].md.ts. */
  markdownAlternate?: string;
  /** ISO 8601 duration (e.g. "PT6M") for the BlogPosting `timeRequired` field — see src/lib/reading-time.ts. Article pages only. */
  readingTimeISO8601?: string;
  /**
   * Page-specific JSON-LD nodes merged into this layout's existing `@graph` — one `ld+json`
   * script for the whole document rather than a second tag, so there is no new CSP surface and
   * the nodes can reference `#person` / `#website` by `@id`. Give every node a unique `@id`.
   */
  extraJsonLd?: Record<string, unknown>[];
}

const {
  title = 'Matt Pyle',
  fullTitle,
  seoTitle,
  description = 'Growth marketer and hobbyist builder. Director of Growth at Temporal Technologies.',
  seoDescription,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  breadcrumbs,
  noindex = false,
  markdownAlternate,
  readingTimeISO8601,
  extraJsonLd,
} = Astro.props;

const headTitleBase = seoTitle ?? title;
const pageTitle = fullTitle ?? (headTitleBase === 'Matt Pyle' ? headTitleBase : `${headTitleBase} — Matt Pyle`);
const metaDescription = seoDescription ?? description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL('/', Astro.site).toString();
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;

// Route-derived default so every new section page (and any subdirectory under it)
// gets a correct BreadcrumbList for free — no per-page wiring required. Detail
// pages that need a human title instead of a raw slug (e.g. /writing/[slug]) pass
// an explicit `breadcrumbs` prop, which overrides this entirely. The homepage
// (empty path) intentionally gets no trail — it's the root, not a hierarchy leaf.
function humanizeSegment(segment: string): string {
  return segment
    .split(/[-_]/)
    .filter(Boolean)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function defaultBreadcrumbs(pathname: string): Breadcrumb[] | undefined {
  const segments = pathname.split('/').filter(Boolean);
  if (segments.length === 0) return undefined;

  const crumbs: Breadcrumb[] = [{ name: 'Home', url: '/' }];
  let path = '';
  for (const segment of segments) {
    path += `/${segment}`;
    crumbs.push({ name: humanizeSegment(segment), url: `${path}/` });
  }
  return crumbs;
}

const resolvedBreadcrumbs = breadcrumbs ?? defaultBreadcrumbs(Astro.url.pathname);

// Per-post `image` (see writing/[slug].astro) falls back to this sitewide 1200x630 share card.
const ogImageURL = new URL(image ?? '/og-fallback.png', Astro.site);
// Twitter's own crop (1200x675, 16:9) — only the sitewide default needs a distinct asset;
// per-post images are already sized right for both tags.
const twitterImageURL = new URL(image ?? '/og-fallback-twitter.png', Astro.site);
// Every page now has a real large share image, so this is always the large card.
const twitterCard = 'summary_large_image';

// Person + WebSite ship on every page so the entity resolves the same way everywhere.
// sameAs is GitHub + LinkedIn only, and deliberately no X/Twitter (see CLAUDE.md: that is an
// entity statement, not an omission). It is NOT a mirror of any link list on the site:
// SiteFooter.astro also links Bluesky, and /about's reach grid in AboutBody.astro links Bluesky
// and the feed. Adding a profile to one of those lists is not a reason to add it here.
// (It named AboutGrid.astro until 2026-08-29; that component is deleted.)
const jsonLdGraph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Matt Pyle',
    url: siteURL,
    jobTitle: 'Director of Growth',
    worksFor: { '@type': 'Organization', name: 'Temporal Technologies' },
    sameAs: ['https://github.com/mattpyle', 'https://linkedin.com/in/matt-pyle'],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: siteURL,
    name: 'Matt Pyle',
    description: 'Growth marketer and hobbyist builder. Director of Growth at Temporal Technologies.',
    publisher: { '@id': personId },
  },
];

if (type === 'article' && publishedTime) {
  jsonLdGraph.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalURL}#article`,
    headline: title,
    description,
    image: ogImageURL.toString(),
    url: canonicalURL.toString(),
    datePublished: publishedTime.toISOString(),
    dateModified: (modifiedTime ?? publishedTime).toISOString(),
    author: { '@id': personId },
    publisher: { '@id': personId },
    mainEntityOfPage: canonicalURL.toString(),
    ...(readingTimeISO8601 ? { timeRequired: readingTimeISO8601 } : {}),
  });
}

if (extraJsonLd) {
  jsonLdGraph.push(...extraJsonLd);
}

if (resolvedBreadcrumbs && resolvedBreadcrumbs.length > 0) {
  jsonLdGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: resolvedBreadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.url, Astro.site).toString(),
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': jsonLdGraph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Pre-paint appearance apply — a genuine inline (not module, not deferred)
      script so it runs synchronously, before the render-blocking stylesheets
      below are applied, and before first paint. This is what stops a returning
      retro visitor from seeing a flash of modern. is:inline keeps it literally
      inline (not bundled to an external file).

      security.csp does NOT hash this. Astro hashes the scripts it bundles, and
      is:inline scripts, in <head> or in <body>, are by definition not bundled.
      astro.config.mjs adds the hash itself, computed from the same constant
      rendered here, so the two cannot drift. Never paste the script text back
      into this file: that breaks the derivation, and the CSP then refuses the
      script in production, silently, as it did from 0b9832a to 2026-08-01.
    */}
    <script is:inline set:html={PRE_PAINT_APPEARANCE_SCRIPT} />
    {/*
      Chrome WebMCP origin trial — bound to https://www.mattpyle.com (the canonical host; the apex
      308s to it) and EXPIRES 2026-11-17, after which Chrome ignores it and the tools in
      src/components/WebMCP.astro simply stop registering. That is a silent, harmless degradation —
      the site is unaffected either way — so nothing here needs guarding. Delete this line to end the
      trial early. Not a secret: origin-trial tokens are public by design.
    */}
    <meta http-equiv="origin-trial" content="Av/hVYhbhRGKIRl8KYjJftHmGKj2yeR3JjDgVDdWBIBPOSUM3H+VkG1Ad+18IHvy80DVhk8b/cMXtqL2wk4u6gsAAABQeyJvcmlnaW4iOiJodHRwczovL3d3dy5tYXR0cHlsZS5jb206NDQzIiwiZmVhdHVyZSI6IldlYk1DUCIsImV4cGlyeSI6MTc5NDg3MzYwMH0=" />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* The browser-chrome tint matches the page's own background. */}
    <meta name="theme-color" content="#f2f3f7" />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {/* Hardcoded, not derived: the fallback and every generated per-post image are always 1200x630. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Matt Pyle" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={twitterImageURL} />
    <link rel="alternate" type="application/rss+xml" title="Matt Pyle — Writing" href={new URL('/rss.xml', Astro.site)} />
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" href={new URL(markdownAlternate, Astro.site)} />
    )}
    {/*
      llms.txt v2 (llmstxt.org, modified 2026-08-10) recommends advertising the file through the
      `alternate` and `describedby` link relations, as `<link>` elements or an HTTP `Link:` header.
      The `alternate` above is per-page and points at that page's own markdown sibling; this one is
      the site-wide index, and it is on every page rather than the homepage alone so an agent that
      arrives on a post finds it without going back to `/`.

      The edge `Link:` header on `/` in vercel.json says the same thing at the header level, and
      the two are kept consistent by hand: both name /llms.txt as `describedby`. They are not
      redundant — this element is on every page and the header is on `/` alone — but they are one
      claim in two places, and a change to either is a change to both. The header also has
      middleware.ts to keep in sync (CLAUDE.md), which this element does not.
    */}
    <link rel="describedby" type="text/markdown" href={new URL('/llms.txt', Astro.site)} />
    {/*
      Agentic Resource Discovery (agenticresourcediscovery.org, spec v0.91) §5.1: a consumer
      resolving this domain's entries MUST fetch /.well-known/ard.json and MUST honour a
      rel="ard" link. The well-known path is the primary source and this element is the second
      of the two mechanisms a consumer is required to obey, so it is the one cheap aid worth
      emitting; the two together are the whole advertisement. The spec's third mechanism, its
      robots.txt directive, is not published (src/pages/robots.txt.ts says why), and DNS records
      are deliberately not published either. It is site-wide for the same reason the describedby above is: an agent
      that arrives on a post should find the catalogue without going back to `/`.
    */}
    <link rel="ard" href={new URL('/.well-known/ard.json', Astro.site)} />
    {/*
      The same catalogue under ARD's predecessor names, for consumers that have not caught up with
      v0.91. Measured on 2026-08-27 (docs/work/ai-catalog-alias-path.md): `hf discover navigate`
      fetched /.well-known/ai-catalog.json, took the 404, and stopped without ever trying ard.json
      or this document's rel="ard" element; isitagentready.com reads rel="ai-catalog". The URL is a
      vercel.json rewrite onto ard.json, never a second file, so there is one catalogue with two
      names and nothing to drift.
    */}
    <link rel="ai-catalog" href={new URL('/.well-known/ai-catalog.json', Astro.site)} />
    {/*
      The latin subset of each face the page paints in the default appearance,
      and no more. JetBrains Mono and Source Serif 4 are retro's faces and are
      not preloaded: retro is a persisted client-side preference, so preloading
      them would put ~50KB of unused font on every route's critical path for
      every visitor who has not chosen it. The latin-ext subsets are deliberately
      not preloaded either: unicode-range means they are fetched only if the page
      contains a character that needs them.
    */}
    <link rel="preload" href="/fonts/bricolage-grotesque-opsz96-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="skin-redesign">
    <a href="#main" class="skip-link">Skip to content</a>
    <AppearanceBanner />
    {/*
      One header and one footer per route, in both appearances. Retro restyles
      this same markup through `html[data-appearance='retro'] [data-module='site-header']`
      / `[data-module='site-footer']` in retro.css; nothing is injected, removed
      or re-rendered when the appearance toggles.
    */}
    <SiteHeader />
    <main class="site-main" id="main">
      <slot />
    </main>
    <SiteFooter />
    <AppearanceUI />
    {/*
      MUST stay in <body>. This renders a <vercel-speed-insights> custom element, and a custom
      element inside <head> makes the HTML parser close the head early — which pushed Astro's
      generated CSP <meta> into the body, where Chrome ignores it ("delivered via a <meta> element
      outside the document's <head>"). That silently disabled script-src sitewide in production.
      Anything non-head-legal (custom elements, divs) belongs here, not up there.
    */}
    <SpeedInsights />
    <WebMCP />
  </body>
</html>

<style>
  .site-main { flex: 1; }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 12px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    transition: top .15s ease;
  }

  .skip-link:focus {
    top: 72px;
  }
</style>

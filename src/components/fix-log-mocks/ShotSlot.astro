---
/**
 * The reserved space for a before and after screenshot pair. No capture exists yet,
 * so each is a placeholder at the size a real capture would take.
 *
 * Before sits left and after right, each named above its frame. Both frames are the
 * same: position and the name tell them apart, not colour.
 *
 * `shape` follows the screen the fix is about: `tall` for a phone, `wide` for a
 * desktop page.
 */
interface Props {
  shape?: 'wide' | 'tall';
}
const { shape = 'wide' } = Astro.props;
---

<div class:list={['shots', `shots--${shape}`]}>
  {(['Before', 'After'] as const).map((side) => (
    <figure class="shot">
      <figcaption class="shot-name">{side}</figcaption>
      <div class="shot-frame" role="img" aria-label={`${side}: screenshot not yet captured`}>
        <span class="shot-text">screenshot to come</span>
      </div>
    </figure>
  ))}
</div>

<style>
  .shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .shots--tall {
    grid-template-columns: minmax(0, 360px) minmax(0, 360px);
    justify-content: center;
    gap: 40px;
  }

  .shot { margin: 0; min-width: 0; }

  .shot-name {
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .shot-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: repeating-linear-gradient(-45deg, var(--track) 0 8px, var(--paper) 8px 18px);
  }

  .shots--wide .shot-frame { aspect-ratio: 16 / 10; }
  .shots--tall .shot-frame { aspect-ratio: 9 / 19.5; }

  .shot-text { font-size: 15px; color: var(--ink-6); }

  @media (max-width: 720px) {
    .shots, .shots--tall { gap: 12px; grid-template-columns: 1fr 1fr; }
    .shot-name { font-size: 16px; margin-bottom: 6px; }
  }
</style>

---
/**
 * A fix's before and after, to take in at a glance: two boxes, each a tag and a value.
 *
 * Three text tiers and no more: the tag (small, bold, coloured), the value (large),
 * and the label naming what the pair counts (muted, once, under both boxes). The
 * before is a warm ground, the after a green one, so the pair reads before a word of
 * it is read. Nothing is struck through.
 *
 * Round two of the mocks is not held to the site's palette (Matt, 2026-11-11), so
 * these two grounds are new colours, local to the mocks.
 */
interface Props {
  before: string;
  after: string;
  label?: string;
  quoted?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { before, after, label, quoted = false, size = 'md' } = Astro.props;
const show = (v: string) => (quoted ? `“${v}”` : v);
---

<figure class:list={['glance', `glance--${size}`, quoted && 'glance--quoted']}>
  <div class="boxes">
    <p class="box box--before"><span class="tag">Before</span><span class="value">{show(before)}</span></p>
    <p class="box box--after"><span class="tag">After</span><span class="value">{show(after)}</span></p>
  </div>
  {label && <figcaption class="label">{label}</figcaption>}
</figure>

<style>
  .glance {
    --before-bg: oklch(0.955 0.022 45);
    --before-ink: oklch(0.46 0.13 40);
    --after-bg: oklch(0.955 0.035 150);
    --after-ink: oklch(0.42 0.11 150);
    margin: 0;
    min-width: 0;
  }

  .boxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .box {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    margin: 0;
    padding: 14px 16px 16px;
    border-radius: 8px;
    min-width: 0;
  }

  .box--before { background: var(--before-bg); }
  .box--after { background: var(--after-bg); }

  .tag {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .box--before .tag { color: var(--before-ink); }
  .box--after .tag { color: var(--after-ink); }

  .value {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: .95;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .box--before .value { color: oklch(0.36 0.03 40); }

  .glance--sm .value { font-size: 36px; }
  .glance--md .value { font-size: 56px; }
  .glance--lg .value { font-size: clamp(56px, 7vw, 96px); }

  /* Words are longer than numbers: a quote steps down a size and keeps its weight. */
  .glance--quoted .value { font-weight: 600; letter-spacing: -.02em; line-height: 1.1; }
  .glance--quoted.glance--sm .value { font-size: 21px; }
  .glance--quoted.glance--md .value { font-size: 28px; }
  .glance--quoted.glance--lg .value { font-size: clamp(32px, 4.5vw, 52px); }

  .label {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-6);
  }

  .glance--lg .box { padding: 20px 24px 26px; border-radius: 12px; }
  .glance--lg .boxes { gap: 10px; }
  .glance--lg .label { font-size: 17px; }

  @media (max-width: 720px) {
    .glance--md .value { font-size: 44px; }
    .glance--sm .value { font-size: 30px; }
    .glance--quoted.glance--md .value { font-size: 22px; }
    .glance--quoted.glance--sm .value { font-size: 18px; }
    .box { padding: 12px 12px 14px; }
  }
</style>

---
/**
 * One side of a fix, shown as the thing itself: a count, the changed lines, the words
 * a screen reader spoke, or the space where something was missing.
 *
 * `side` only sets the tone: the before reads muted, the after reads in full ink.
 * A removed line is struck through on the before side and an added line is marked on
 * the after side, so each side stands alone and neither is a merged diff.
 */
import type { Specimen } from '../../data/fix-log-sample';

interface Props {
  specimen: Specimen;
  side: 'before' | 'after';
  size?: 'large' | 'small';
}

const { specimen, side, size = 'large' } = Astro.props;
---

<div class:list={['spec', `spec--${side}`, `spec--${size}`, `spec--${specimen.kind}`]}>
  {specimen.kind === 'figure' && (
    <>
      <span class="spec-figure">{specimen.value}</span>
      <span class="spec-caption">{specimen.caption}</span>
    </>
  )}
  {specimen.kind === 'lines' && (
    <>
      <span class="spec-label">{specimen.label}</span>
      <pre class="spec-lines"><code>{specimen.lines.map((line) => (
        <span class:list={['spec-line', line.mark && `spec-line--${line.mark}`]}>{line.text}</span>
      ))}</code></pre>
    </>
  )}
  {specimen.kind === 'spoken' && (
    <>
      <span class="spec-label">{specimen.label}</span>
      <p class="spec-spoken">{specimen.words.map((w, i) => (
        <span class="spec-word">“{w}”{i < specimen.words.length - 1 ? ',' : ''}</span>
      ))}</p>
    </>
  )}
  {specimen.kind === 'missing' && (
    <>
      <span class="spec-label">{specimen.label}</span>
      <p class="spec-missing">{specimen.text}</p>
    </>
  )}
</div>

<style>
  .spec {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .spec-label,
  .spec-caption {
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .spec-figure {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: .9;
    color: var(--ink);
  }

  .spec--large .spec-figure { font-size: clamp(64px, 9vw, 120px); }
  .spec--small .spec-figure { font-size: 44px; }

  .spec--before .spec-figure { color: var(--ink-6); }

  .spec-lines {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-family: var(--font-mono-plex);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-4);
  }

  .spec-lines code {
    display: flex;
    flex-direction: column;
    font: inherit;
  }

  .spec-line { white-space: pre-wrap; overflow-wrap: anywhere; }

  /* A removed line is only ever shown on the before side, struck through. */
  .spec-line--removed {
    color: var(--ink-6);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* An added line only on the after side: ink, with an ink rule in the margin. Not green: green means projects on this site. */
  .spec-line--added {
    color: var(--ink);
    box-shadow: inset 3px 0 0 var(--ink);
    padding-left: 10px;
    margin-left: -10px;
  }

  .spec-spoken {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -.015em;
    line-height: 1.25;
  }

  .spec--large .spec-spoken { font-size: 26px; }
  .spec--small .spec-spoken { font-size: 18px; }
  .spec--before .spec-spoken { color: var(--ink-6); }
  .spec--after .spec-spoken { color: var(--ink); }

  .spec-missing {
    margin: 0;
    padding: 20px 16px;
    border: 1px dashed var(--ink-6);
    border-radius: var(--radius);
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
    text-align: center;
  }
</style>

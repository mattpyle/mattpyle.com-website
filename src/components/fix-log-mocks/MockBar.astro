---
/**
 * The strip across the top of each fix-log design mock: which direction this is,
 * its one-sentence idea, and links to the others. Mock furniture only. It goes when
 * a direction is chosen and built.
 */
import { DIRECTIONS } from '../../data/fix-log-sample';

interface Props {
  slug: (typeof DIRECTIONS)[number]['slug'];
}

const { slug } = Astro.props;
const index = DIRECTIONS.findIndex((d) => d.slug === slug);
const current = DIRECTIONS[index];
---

<aside class="rd-section mock-bar" aria-label="Design mock">
  <p class="mock-what">
    <span class="mock-count">mock {index + 1} of {DIRECTIONS.length}, {current.temperament}</span>
    <strong class="mock-name">{current.name}.</strong> {current.idea}
  </p>
  <nav class="mock-links" aria-label="Other directions">
    <a href="/fix-log/mocks/">all directions</a>
    {DIRECTIONS.map((d) => (
      d.slug === slug
        ? <span aria-current="page" class="mock-here">{d.name.toLowerCase()}</span>
        : <a href={`/fix-log/mocks/${d.slug}/`}>{d.name.toLowerCase()}</a>
    ))}
  </nav>
</aside>

<style>
  .mock-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom: 1px dashed var(--rule);
  }

  .mock-what {
    margin: 0;
    max-width: 72ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-5);
  }

  .mock-count {
    display: block;
    font-family: var(--font-mono-plex);
    color: var(--ink-6);
  }

  .mock-name { color: var(--ink); font-weight: 600; }

  .mock-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-family: var(--font-mono-plex);
    font-size: 15px;
  }

  .mock-links a { color: var(--agents); }
  .mock-links a:hover { color: var(--agents-hover); }

  .mock-here {
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }

  @media (max-width: 720px) {
    .mock-links a, .mock-here {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

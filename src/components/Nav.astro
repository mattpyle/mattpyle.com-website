---
const path = Astro.url.pathname;

function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path.startsWith(href);
}

const NAV_LINKS = [
  { label: 'Writing',   href: '/writing'   },
  { label: 'Builds',    href: '/builds'    },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Scorecard', href: '/scorecard' },
  { label: 'About',     href: '/about'     },
] as const;
---

<header data-module="nav">
  <div class="nav-inner">
    <a href="/" aria-label="Matt Pyle — home" class="nav-logo">MATT PYLE</a>
    <span class="nav-flourish" aria-hidden="true"><span class="nav-flourish-arm"
      >&cedil;,&oslash;&curren;&ordm;&deg;`&deg;&ordm;&curren;&oslash;,&cedil;</span><span
      class="nav-flourish-word">welcome</span><span class="nav-flourish-arm"
      >&cedil;,&oslash;&curren;&ordm;&deg;`&deg;&ordm;&curren;&oslash;,&cedil;</span></span>
    <nav aria-label="Main navigation">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class:list={['nav-link', { 'is-active': isActive(href) }]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  [data-module="nav"] {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(250, 247, 240, .92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    height: 60px;
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .08em;
    color: var(--color-heading);
    text-decoration: none;
  }

  .nav-logo:hover {
    color: var(--color-heading);
  }

  nav {
    display: flex;
    gap: 26px;
  }

  .nav-link {
    font-family: var(--font-system);
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link.is-active {
    color: var(--color-heading);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .nav-inner { padding: 0 var(--gutter-mobile); }
    nav { gap: 16px; }
  }

  /* WCAG 1.4.10 reflow: the single non-wrapping row needs 352px, so below that
     the header wraps instead of scrolling the page sideways. The wordmark takes
     its own row (flex-basis 100%) and the links follow, wrapping among
     themselves as needed — retro restyles this same markup in wider faces
     (Comic Sans wordmark, bold Verdana links) and must fit too, so nothing here
     assumes the modern fonts' metrics. Scoped below 360px, so 375 and up keep
     the single 60px row. */
  @media (max-width: 359.98px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: 10px;
      row-gap: 8px;
    }

    .nav-logo { flex: 0 0 100%; }

    nav {
      flex: 0 0 100%;
      flex-wrap: wrap;
      gap: 8px 12px;
    }
  }
</style>

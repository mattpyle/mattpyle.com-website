---
// Normalised to the trailing-slash canonical before comparing, because the hrefs below
// now carry it. Production always serves the slash form (the 308 in middleware.ts),
// but the dev server and the a11y suite's local server both answer a slash-less URL
// directly, and an un-normalised path would silently drop the active state there.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path.startsWith(href);
}


/**
 * `retro-skin` is hardcoded on the header below rather than passed in. This
 * component is the RETRO half of a pair on every route: SiteHeader.astro renders
 * beside it and retro.css shows exactly one of the two. It was a `skin` prop
 * while the redesign converted the site one route at a time and unconverted
 * pages had to render this nav unskinned; every route is converted now.
 */

const NAV_LINKS = [
  { label: 'Writing',   href: '/writing/'   },
  { label: 'Projects',  href: '/projects/'  },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Scorecard', href: '/scorecard/' },
  { label: 'About',     href: '/about/'     },
] as const;
---

<header data-module="nav" class="retro-skin">
  <div class="nav-inner">
    <a href="/" aria-label="Matt Pyle — home" class="nav-logo">MATT PYLE</a>
    <span class="nav-flourish" aria-hidden="true"><span class="nav-flourish-arm"
      >&cedil;,&oslash;&curren;&ordm;&deg;`&deg;&ordm;&curren;&oslash;,&cedil;</span><span
      class="nav-flourish-word">welcome</span><span class="nav-flourish-arm"
      >&cedil;,&oslash;&curren;&ordm;&deg;`&deg;&ordm;&curren;&oslash;,&cedil;</span></span>
    <nav aria-label="Main navigation">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class:list={['nav-link', { 'is-active': isActive(href) }]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  [data-module="nav"] {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: rgba(250, 247, 240, .92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    height: 60px;
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .08em;
    color: var(--color-heading);
    text-decoration: none;
  }

  .nav-logo:hover {
    color: var(--color-heading);
  }

  nav {
    display: flex;
    gap: 26px;
  }

  .nav-link {
    font-family: var(--font-system);
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link.is-active {
    color: var(--color-heading);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .nav-inner { padding: 0 var(--gutter-mobile); }
    nav { gap: 16px; }
  }

  /* WCAG 1.4.10 reflow: the single non-wrapping row needs 363px, so below that
     the header wraps instead of scrolling the page sideways. The wordmark takes
     its own row (flex-basis 100%) and the links follow, wrapping among
     themselves as needed. Retro restyles this same markup in wider faces
     (Comic Sans wordmark, bold Verdana links) and needs the same wrap further
     up, at 456px, which retro.css layers on top; nothing here assumes either
     mode's font metrics. Scoped below 375px, so 375 and up keep the single
     60px row.

     The measurement is per label set, not per link count: renaming Builds to
     Projects on 2026-08-20 widened the row from 352 to 363 and put 360–362 into
     overflow, which nothing caught because the modern rows only ran at 320. A
     modern row at 375 in tests/a11y/reflow.spec.ts is the guard now. */
  @media (max-width: 374.98px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      padding-block: 10px;
      row-gap: 8px;
    }

    .nav-logo { flex: 0 0 100%; }

    nav {
      flex: 0 0 100%;
      flex-wrap: wrap;
      gap: 8px 12px;
    }
  }
</style>

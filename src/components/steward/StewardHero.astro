---
/**
 * The /steward headline
 * (docs/projects/redesign/design-export-remaining/design_handoff_steward).
 *
 * The site's hero shape — H1, then a statement beside a bordered right-hand block
 * — with the fill left on its default `--agents`, because Steward is an agent
 * surface. No fill variant class is added for that reason.
 *
 * The right-hand block is the audit endpoint, which is the one thing a reader who
 * arrived from a log line might want to call rather than read about. It takes its
 * URL from the page rather than writing one out: the page already holds the
 * endpoint the rest of its copy quotes.
 *
 * THE HERO'S TYPE AND LAYOUT ARE `.rd-hero` IN global.css: the H1, the 32ch lede,
 * the row, the right block's hairline shell and the 720px collapse. The endpoint
 * block sat in a 320px grid column beside the lede until 2026-09-05, and stacked
 * at 1000px with this page's body bands; it now sits on the shell's right edge and
 * stacks with every other hero. The bands keep their own 1000px rule — the hero is
 * one row of two things, and it is legible in two columns at widths where a band
 * of cards is not.
 *
 * IT CARRIES `data-module='steward-hero'` AND NO `.modern-skin`, since 2026-08-29:
 * this is the only /steward hero in the document and retro restyles it in place,
 * under that module prefix in src/styles/retro.css.
 */
interface Props {
  /** The MCP endpoint, from the page. */
  endpoint: string;
}

const { endpoint } = Astro.props;

/** The endpoint without its scheme, which is how the mockup prints it. */
const endpointLabel = endpoint.replace(/^https?:\/\//, '');
---

{/*
  A div, not a section — the same call WritingHero.astro and ProjectsHero.astro
  made: `npm run validate:html` names an h1 inside sectioning content, and an
  unnamed <section> is not exposed as a region anyway.
*/}
<div class="rd-section rd-hero steward-hero" data-module="steward-hero">
  <h1><span class="rd-fill">Steward</span></h1>

  <div class="hero-row">
    <p class="hero-statement">
      The auditor behind the steward-audit User-Agent, and the agent that publishes this site.
    </p>
    <div class="hero-aside hero-endpoint">
      <span class="hero-endpoint-label">Audit endpoint</span>
      <a class="hero-endpoint-link" href={endpoint}>{endpointLabel}</a>
    </div>
  </div>
</div>

<style>
  .steward-hero { padding-top: 72px; }

  .hero-endpoint { gap: 10px; }

  .hero-endpoint-label {
    font-size: 18px;
    color: var(--ink-6);
  }

  .hero-endpoint-link {
    font-family: var(--font-mono-plex);
    font-size: 19px;
    color: var(--agents);
    overflow-wrap: anywhere;
  }

  .hero-endpoint-link:hover { color: var(--agents-hover); }

  @media (max-width: 720px) {
    .steward-hero { padding-top: 40px; }

    /* 44px tap target, per the mobile spec. */
    .hero-endpoint-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
      font-size: 18px;
    }
  }
</style>

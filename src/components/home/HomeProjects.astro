---
/**
 * The Projects section (docs/projects/redesign/design-export/README.md §1, "Projects").
 *
 * Rendered from the real `projects` collection, which holds one entry today
 * (Matt, 2026-08-20). The design's two cards — Steward and WebMCP experiments —
 * are not in the collection, and constraint 10 says leave a placeholder rather
 * than invent a number or a label; inventing two content entries to fill a grid
 * would have been the same mistake one level up. The grid stays two columns, so
 * the section grows into the design as entries land.
 *
 * The card top is the project's own screenshot when its frontmatter carries an
 * `image`, and the placeholder hatch alone when it does not: the design would
 * rather show an honest empty frame than a decorative one. The slot stays
 * aria-hidden either way — the card's accessible name is the project title, so
 * the image is decorative by construction and renders `alt=""`.
 *
 * RETRO RESTYLES THIS SAME MARKUP under
 * `html[data-appearance='retro'] [data-module='home-projects']` in retro.css. The
 * module prefix there is what buys those rules the one extra attribute they
 * need to outweigh the Astro-scoped selectors below, whose
 * `[data-astro-cid-…]` counts as a class. Nothing here is appearance-aware.
 */
import { Image } from 'astro:assets';

interface Project {
  id: string;
  data: {
    title: string;
    description: string;
    github?: string;
    live?: string;
    image?: ImageMetadata;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const SITE_ORIGIN = Astro.site ? new URL(Astro.site).origin : 'https://www.mattpyle.com';

/**
 * Where a card goes. There are no per-project detail pages, so the useful
 * destination is the project itself: its live URL, or its repository when the
 * live URL is this very site. /projects is the fallback, never a dead card.
 */
function cardHref(project: Project): { href: string; external: boolean } {
  const { live, github } = project.data;
  if (live && new URL(live).origin !== SITE_ORIGIN) return { href: live, external: true };
  if (github) return { href: github, external: true };
  return { href: '/projects/', external: false };
}
---

<section class="rd-section projects" data-module="home-projects" aria-labelledby="home-projects-title">
  <div class="rd-heading-row">
    <h2 id="home-projects-title">Projects</h2>
    <a href="/projects/" class="rd-all-link">all projects &rarr;</a>
  </div>

  <div class="grid">
    {projects.map(project => {
      const { href, external } = cardHref(project);
      return (
        <a
          href={href}
          class="card"
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <span class="card-image" aria-hidden="true">
            {project.data.image && (
              <Image src={project.data.image} alt="" widths={[400, 800, 1200]} sizes="(max-width: 720px) 100vw, 50vw" />
            )}
          </span>
          <span class="card-body">
            <span class="card-name">{project.data.title}</span>
            <span class="card-blurb">{project.data.description}</span>
            {external && <span class="sr-only"> (opens in a new tab)</span>}
          </span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .projects { padding-top: 84px; }

  .rd-heading-row { padding-bottom: 26px; }
  .rd-heading-row h2 { color: var(--projects); }
  .rd-all-link { color: var(--projects); }
  .rd-all-link:hover { color: var(--projects-hover); }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--ink);
    transition: border-color 240ms ease, transform 240ms ease;
  }

  .card:hover {
    border-color: var(--projects);
    transform: translateY(-3px);
  }

  .card-image {
    display: block;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--rule);
    background-image: repeating-linear-gradient(
      -45deg,
      var(--hatch-projects-a) 0 8px,
      var(--hatch-projects-b) 8px 16px
    );
  }

  /* The image fills the slot edge to edge, so the hatch below it only shows for
     a project that has no screenshot yet. `object-fit: cover` handles a source
     whose ratio is not the slot's; the 16:9 crop means it has little to do. */
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 26px 26px;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 25px;
    letter-spacing: -.02em;
  }

  .card-blurb {
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink-5);
    text-wrap: pretty;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .projects { padding-top: 52px; }

    .rd-heading-row { padding-bottom: 20px; }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .card-image { aspect-ratio: 16 / 10; }

    .card-body { padding: 20px 20px 22px; }

    .card-name { font-size: 24px; }

    .card-blurb { font-size: 17px; }
  }
</style>

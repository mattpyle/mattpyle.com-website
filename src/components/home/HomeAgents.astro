---
/**
 * The Agent surfaces section (docs/projects/redesign/design-export/README.md §1,
 * "Agent surfaces"): the live conformance scorecard beside the three surfaces an
 * agent can actually fetch.
 *
 * Every number here comes from src/data/scorecard-runs.json through the same
 * SCORECARD derivation /scorecard renders, so the panel and the page can never
 * disagree about the latest run. Nothing is hardcoded — the mockup's numbers
 * happen to match the run of 20 Aug 2026 because that is the run it was drawn
 * against, not because they were copied.
 *
 * RETRO RESTYLES THIS SAME MARKUP under
 * `html[data-appearance='retro'] [data-module='home-agents']` in retro.css. The
 * module prefix there is what buys those rules the one extra attribute they
 * need to outweigh the Astro-scoped selectors below, whose
 * `[data-astro-cid-…]` counts as a class. Nothing here is appearance-aware.
 */
import { SCORECARD, passingGates, scorecardGates } from '../../data/scorecard';
import { formatIsoDate } from '../../lib/format-date.mjs';

// The gate derivation and the pass count are shared with /scorecard rather than kept here: the
// page is the expansion of this panel, and the two must not be able to disagree about a run. Both
// live in src/data/scorecard.ts, next to the run-log they derive from.
const gates = scorecardGates();
const passing = passingGates();
const verifiedDate = formatIsoDate(SCORECARD.verified.iso);

/**
 * The three surfaces, in the design's order and with its copy. Real routes: the
 * llms.txt and agents.md files are generated/served at the site root and /webmcp
 * is a page.
 */
const SURFACES = [
  {
    path: 'llms.txt',
    href: '/llms.txt',
    description: 'The map of this site, written for machines and readable by anyone.',
  },
  {
    path: '/webmcp',
    href: '/webmcp/',
    description: 'Tool definitions agents can call to search the writing and read the projects.',
  },
  {
    path: 'agents.md',
    href: '/agents.md',
    description: 'How to use this site as an agent, including what not to assume.',
  },
] as const;
---

<section class="rd-section agents" data-module="home-agents" aria-labelledby="home-agents-title">
  <div class="rd-heading-row">
    <h2 id="home-agents-title">Agent surfaces</h2>
    {/*
      The pointer to /activity, which is off the header nav on purpose (the nav is
      full — Matt, 2026-08-21) and reaches readers from here, the footer and a
      cross-link on /scorecard instead. `.rd-all-link` is the shell's existing
      right-margin section link, so this row matches the writing, projects and
      changelog rows above it rather than inventing a third kind of link.
    */}
    <a href="/activity/" class="rd-all-link">agent traffic &rarr;</a>
  </div>

  <div class="grid">
    <div class="panel">
      <div class="panel-head">
        <span class="panel-title">Conformance scorecard</span>
        <a href="/scorecard/" class="panel-link">full results &rarr;</a>
      </div>

      <p class="headline">
        <span class="headline-number">{passing} of {SCORECARD.metrics.length}</span>
        <span class="headline-caption">gates passing &middot; {verifiedDate}</span>
      </p>

      {/*
        ONE grid for all four rows, with the three spans of each row as direct
        grid children. Per-row grids made the bars incomparable: each row sized
        its own track, so a 99 and a 100 could draw the same length. This is the
        whole point of the panel, so it is worth the flatter markup.
      */}
      <div class="gates">
        {gates.map(gate => (
          <>
            <span class="gate-name">{gate.name}</span>
            {/*
              A real <progress>, not a div with a width: this site's CSP declares
              style-src 'self' with no 'unsafe-inline', so an inline style
              attribute — which is what a computed bar width and Astro's
              define:vars both come out as — is refused in production. An element
              whose length is driven by its own value/max attributes needs no
              inline style at all.

              aria-hidden because the score is printed beside it in text. Left
              audible it would announce the same number twice, once as "99" and
              once as "99 percent".
            */}
            <progress class="gate-bar" max={gate.maximum} value={gate.value} aria-hidden="true"
            ></progress>
            <span class="gate-score">{gate.score}</span>
          </>
        ))}
      </div>
    </div>

    <div class="surfaces">
      {SURFACES.map(surface => (
        <a href={surface.href} class="surface">
          <span class="surface-path">{surface.path}</span>
          <span class="surface-desc">{surface.description}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .agents { padding-top: 84px; }

  .rd-heading-row { padding-bottom: 26px; }
  .rd-heading-row h2 { color: var(--agents); }
  .rd-heading-row .rd-all-link { color: var(--agents); }
  .rd-heading-row .rd-all-link:hover { color: var(--agents-hover); }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .panel {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 26px 28px 28px;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .panel-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -.02em;
  }

  .panel-link {
    font-family: var(--font-mono-plex);
    font-size: 16px;
    color: var(--agents);
    white-space: nowrap;
  }

  .panel-link:hover { color: var(--agents-hover); }

  .headline {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 18px 0 6px;
  }

  .headline-number {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 58px;
    line-height: .9;
    letter-spacing: -.04em;
    white-space: nowrap;
    color: var(--agents);
  }

  .headline-caption {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .gates {
    display: grid;
    grid-template-columns: max-content minmax(90px, 1fr) 44px;
    column-gap: 18px;
    row-gap: 16px;
    align-items: center;
    margin-top: 18px;
    border-top: 1px solid var(--rule-2);
    padding-top: 22px;
  }

  .gate-name {
    font-family: var(--font-mono-plex);
    font-size: 16px;
    color: var(--ink-3);
  }

  /* The two engines expose a progress bar through different pseudo-elements and
     neither tolerates the other in a selector list — one unknown pseudo drops the
     whole rule — so the fill is declared twice on purpose. */
  .gate-bar {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    height: 6px;
    border: 0;
    border-radius: 999px;
    background: var(--track);
    overflow: hidden;
  }

  .gate-bar::-webkit-progress-bar {
    background: var(--track);
    border-radius: 999px;
  }

  /* One-shot on mount, never looping. `both` holds the end state. */
  .gate-bar::-webkit-progress-value {
    background: var(--agents);
    border-radius: 999px;
    transform-origin: left;
    animation: barGrow 900ms cubic-bezier(.2, .8, .2, 1) both;
  }

  .gate-bar::-moz-progress-bar {
    background: var(--agents);
    border-radius: 999px;
    transform-origin: left;
    animation: barGrow 900ms cubic-bezier(.2, .8, .2, 1) both;
  }

  /* The blanket prefers-reduced-motion rule in global.css reaches `*`,
     `*::before` and `*::after` — and a progress bar's fill is none of the three.
     Without these two rules the bar would keep growing for 900ms under a
     preference that asks it not to, and no row in tests/a11y would see it: the
     reduced-motion spec reads computed style on the same three pseudo-elements. */
  @media (prefers-reduced-motion: reduce) {
    .gate-bar::-webkit-progress-value { animation: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-bar::-moz-progress-bar { animation: none; }
  }

  .gate-score {
    font-family: var(--font-mono-plex);
    font-size: 16px;
    color: var(--ink-6);
    text-align: right;
  }

  .surfaces {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* A fixed first column, not max-content: the three descriptions have to align
     down the stack, and a shared grid cannot do it across three separate cards. */
  .surface {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 20px 22px;
    color: var(--ink);
    transition: border-color 220ms ease, background 220ms ease;
  }

  .surface:hover {
    border-color: var(--agents);
    background: var(--tint-agents);
  }

  .surface-path {
    font-family: var(--font-mono-plex);
    font-size: 16.5px;
    color: var(--agents);
  }

  .surface-desc {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 720px) {
    .agents { padding-top: 52px; }

    .rd-heading-row { padding-bottom: 20px; }

    .panel { padding: 22px 20px 24px; }

    .panel-head { flex-wrap: wrap; }

    .panel-title { font-size: 21px; }

    .panel-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
    }

    .headline { gap: 6px; margin: 16px 0 4px; }

    .headline-number { font-size: 52px; }

    .headline-caption { font-size: 16px; }

    /* minmax(0, max-content), not max-content: a bare max-content track never
       shrinks below the longest label, and "agentic browsing" plus a 60px track
       plus the score column ran 36px past the panel at 320px. Letting the label
       wrap keeps all four bars on one shared track, which is the entire point of
       the panel — a per-row grid would fit, and would make a 99 and a 100 draw
       the same length. */
    .gates {
      grid-template-columns: minmax(0, max-content) minmax(40px, 1fr) max-content;
      column-gap: 12px;
      row-gap: 14px;
      margin-top: 18px;
      padding-top: 18px;
    }

    .gate-name,
    .gate-score { font-size: 15px; }

    .surfaces { margin-top: 16px; }

    .surface {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 18px 20px;
    }

    .surface-path { font-size: 17px; }
  }
</style>

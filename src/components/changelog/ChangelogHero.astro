---
/**
 * The /changelog headline.
 *
 * No mockup covers this page (Matt, 2026-08-21); it dresses like the writing
 * index, so this is the site's hero shape with the fill in CHANGELOG AMBER.
 *
 * The right-hand block reports what the ledger holds — a real count off the
 * collection, not an invented one — and links the machine-readable form of the
 * same log. Both are live endpoints.
 *
 * A paginated page says which page it is, in place of the count: page 2 showing
 * "37 entries" would be reporting the whole log while listing twenty of it.
 *
 * THE HERO'S TYPE AND LAYOUT ARE `.rd-hero` IN global.css: the H1, the 32ch
 * lede, the row, the right block's hairline shell and the 720px collapse. This
 * page keeps ONE type override, the mobile H1 below, and it is measured.
 */
import { formatSiteDate } from '../../lib/format-date.mjs';

interface Props {
  /** Entries in the whole collection, not on this page. */
  total: number;
  /** The newest entry's date, or null when the log is empty. */
  latest: Date | null;
  /** 1 on /changelog, 2 on /changelog/2, and so on. */
  currentPage: number;
}

const { total, latest, currentPage } = Astro.props;

const countLabel = `${total} ${total === 1 ? 'entry' : 'entries'}`;
---

{/*
  A div, not a section — the same call WritingHero.astro made: `npm run
  validate:html` names an h1 inside sectioning content, and an unnamed <section>
  is not exposed as a region anyway.
*/}
<div class="rd-section rd-hero changelog-hero" data-module="changelog-hero">
  <h1><span class="rd-fill rd-fill--changelog">Changelog</span></h1>

  <div class="hero-row">
    <p class="hero-statement">
      What has shipped on this site — launches, features, and the occasional experiment.
    </p>
    <div class="hero-aside hero-facts">
      <span class="hero-facts-copy">
        {currentPage === 1 ? countLabel : `Page ${currentPage} of ${countLabel}`}{
          latest && <>, latest <time datetime={latest.toISOString()}>{formatSiteDate(latest)}</time></>
        }.
      </span>
      <span class="hero-facts-links">
        <a href="/changelog.md" class="link-agents">changelog.md</a>
      </span>
    </div>
  </div>
</div>

<style>
  .changelog-hero { padding-top: 78px; }

  .hero-facts { gap: 10px; }

  .hero-facts-copy {
    font-size: 17px;
    color: var(--ink-5);
  }

  .hero-facts-links {
    display: flex;
    column-gap: 20px;
    font-family: var(--font-mono-plex);
    font-size: 19px;
  }

  .link-agents { color: var(--agents); }
  .link-agents:hover { color: var(--agents-hover); }

  @media (max-width: 720px) {
    .changelog-hero { padding-top: 40px; }

    /* The one page that does not take the shared 68px. One word, and a long
       one: 68px overflows a 320px viewport where "Writing" and "Projects" fit.
       Measured, not guessed.

       IT CARRIES THE RETRO GUARD, in `:global()` because Astro would otherwise
       append its scoping attribute to `html` and the selector would never
       match. Without the guard this rule outranks retro's own 44px H1 and
       repaints it; with it, it only ever applies in modern, where it beats the
       shared `.rd-hero` rule the way that rule's `:where()` guard intends. */
    :global(html:not([data-appearance='retro'])) .changelog-hero h1 {
      font-size: 52px;
      line-height: .96;
    }
  }
</style>

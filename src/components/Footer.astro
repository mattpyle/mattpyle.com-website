---
const year = new Date().getFullYear();

/**
 * Appearance-skin class, set by Layout.astro on a route the redesign has
 * rebuilt. On such a route this component is the RETRO half of a pair — the
 * redesigned chrome renders beside it and retro.css shows exactly one of the
 * two. Absent everywhere else, which keeps every unconverted page's markup
 * byte-identical to what it was before the redesign branch.
 */
interface Props {
  skin?: string;
}

const { skin } = Astro.props;

---

<footer data-module="footer" class:list={[skin]}>
  <nav aria-label="Social links">
    <a href="/rss.xml" class="rss-link" aria-label="RSS feed for Writing">
      <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M4 11a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 4 13.5V11zm0 6.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4 4a16 16 0 0 1 16 16h-2.5A13.5 13.5 0 0 0 4 6.5V4z"/>
      </svg>
      RSS
    </a>
    {/*
      The two links that leave the site say so. WCAG 3.2.5 is advisory, but the announcement is
      free: same visually-hidden suffix ArticleActions uses on its "Ask ChatGPT"/"Ask Claude"
      links, so the whole site announces a new tab the same way. A sighted reader gets no visual
      arrow here on purpose — the footer is five items on one line and an arrow on two of them
      reads as decoration rather than warning.
    */}
    <a href="https://github.com/mattpyle" target="_blank" rel="noopener noreferrer">
      GitHub<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href="https://linkedin.com/in/matt-pyle" target="_blank" rel="noopener noreferrer">
      LinkedIn<span class="sr-only"> (opens in a new tab)</span>
    </a>
    {/* Footer only — the header nav deliberately stays at five links. */}
    <a href="/webmcp/">WebMCP</a>
    <button type="button" class="appearance-toggle" data-appearance-toggle aria-label="Switch to retro mode">
      Retro mode
    </button>
  </nav>
  <p class="retro-footer-badges" aria-hidden="true">
    <span>[ Handcrafted ]</span>
    <span>[ No framework ]</span>
    <span>[ Human + agent readable ]</span>
  </p>
  <p>© {year} Matt Pyle</p>
</footer>

<style>
  [data-module="footer"] {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px var(--gutter);
    border-top: 1px solid var(--color-border);
    width: 100%;
    max-width: var(--width-shell);
    margin: 0 auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  nav a {
    font-size: 11px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  nav a:hover { color: var(--color-accent); }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .appearance-toggle {
    font-family: inherit;
    font-size: 11px;
    color: var(--color-muted);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 10px;
    cursor: pointer;
    transition: color .15s ease, border-color .15s ease;
  }

  .appearance-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  p {
    font-size: 11px;
    color: var(--color-label);
    margin: 0;
  }

  @media (max-width: 600px) {
    [data-module="footer"] {
      padding: 16px var(--gutter-mobile);
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>

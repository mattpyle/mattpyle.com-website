---
/**
 * The /about body: the reading column and the sticky portrait rail
 * (docs/projects/redesign/design-export-remaining/design_handoff_about_page).
 *
 * It shares the hero's grid — `minmax(0, 68ch) 300px`, 72px gap — so the page has
 * one right edge from the H1 down to the last fact row.
 *
 * The prose sections wear the existing `.prose` overlay from global.css for their
 * type scale, and override exactly one thing: link colour. The overlay paints
 * links in WRITING blue because it was written for the post page, and the
 * redesign's rule is that a link's colour names the section it belongs to. /about
 * is an agents surface, so its prose links are magenta. The underline stays —
 * inside a paragraph, colour alone does not distinguish a link (WCAG 1.4.1).
 *
 * The four reach icons are VENDORED, one path each. The mockup pulled three from
 * cdn.simpleicons.org and masked the fourth from a jsdelivr copy of
 * bootstrap-icons; a CDN request would be a third-party dependency on the
 * critical path and a CSP entry, for four 20px glyphs. They are `aria-hidden`
 * because the label beside each one is the accessible name.
 */
interface Props {
  /** The page's markdown sibling, derived by the page from the negotiation map. */
  markdownUrl?: string;
}

const { markdownUrl } = Astro.props;

/**
 * Reach destinations, in the mockup's reading order.
 *
 * All four wear the SAME colour and the same hover tint, including RSS. Elsewhere
 * on the site the feed is a writing surface and takes writing blue; on a contact
 * list a single differently-coloured row reads as a mistake rather than as a
 * signal, which is the one deliberate departure the bundle names.
 *
 * `viewBox` differs per icon because the sources do (Simple Icons draws on a
 * 24-unit grid, the LinkedIn mark on a 16-unit one). The rendered box is 20px
 * either way. The RSS path is the one already in Footer.astro, so the site has
 * one RSS glyph rather than two that can drift.
 */
const REACH = [
  {
    label: 'bluesky',
    detail: '@mattpyle.com',
    href: 'https://bsky.app/profile/mattpyle.com',
    external: true,
    viewBox: '0 0 24 24',
    path: 'M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026',
  },
  {
    label: 'github',
    detail: 'mattpyle',
    href: 'https://github.com/mattpyle',
    external: true,
    viewBox: '0 0 24 24',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'linkedin',
    detail: 'matt-pyle',
    href: 'https://linkedin.com/in/matt-pyle',
    external: true,
    viewBox: '0 0 16 16',
    path: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z',
  },
  {
    label: 'rss',
    detail: 'rss.xml',
    href: '/rss.xml',
    external: false,
    viewBox: '0 0 24 24',
    path: 'M4 11a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 4 13.5V11zm0 6.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM4 4a16 16 0 0 1 16 16h-2.5A13.5 13.5 0 0 0 4 6.5V4z',
  },
];
---

<div class="rd-section about-body modern-skin">
  <div class="reading">
    <div class="prose">
      <p>
        I am Matt Pyle. I do growth for a living — product-led growth, SaaS marketing strategy, and
        what AI is doing to the way marketing teams work. I build software as a hobby, and the two
        keep meeting in the middle.
      </p>
      <p>
        I am not a professional engineer. I write real, working code with Claude Code as a
        collaborator, and most of what comes out is small and questionably useful. Occasionally one
        escapes into the wild. The building is still the useful part: marketing something you have
        never tried to build is guesswork with a nicer deck.
      </p>
    </div>

    <section class="about-section" aria-labelledby="about-experiment">
      <h2 id="about-experiment">This site is an experiment</h2>
      <div class="prose">
        <p>
          Agents are becoming first-class readers of the web. Not crawlers indexing it for somebody
          else — readers, arriving with a question and leaving with an answer. Most of the web was
          not written for them, and the conventions that would fix that are being drafted right now.
        </p>
        <p>
          {/*
            NO LINE BREAK MAY TOUCH AN INLINE TAG. Astro's `compressHTML` drops the
            whitespace either side of an element boundary when it contains a
            newline, so a source line starting with `<a>` renders glued to the word
            before it ("reports back.llms.txt"). Measured on the built page. Every
            break in this paragraph falls between two plain words.
          */}
          So this site implements them and reports back. <a href="/llms.txt">llms.txt</a>, <a href="/agents.md">agents.md</a>, a
          WebMCP surface with tools an agent can actually call, markdown at every URL for anything
          that asks for it, and a <a href="/scorecard/">scorecard</a> that publishes the audit
          numbers whether or not they are flattering. When a check fails, the scorecard says so.
        </p>
      </div>
    </section>

    {/*
      The `.prose blockquote` shape with its left border swapped to the agents
      magenta. One sentence, no attribution — it states the site's position rather
      than quoting anybody.
    */}
    <blockquote class="about-aside">
      An agent reading this page is a visitor, not traffic. It gets the same content, in a format it
      can use, at the same URL.
    </blockquote>

    <section class="about-section" aria-labelledby="about-open">
      <h2 id="about-open">Everything here is built in the open</h2>
      <div class="prose">
        <p>
          The code is public, the <a href="/changelog/">changelog</a> explains every change in plain
          English, and the posts include the parts I got wrong. I write the words; the agents I
          build with help me ship them, and the site says so.
        </p>
        <p>
          The day job is growth at <strong>Temporal Technologies</strong>, which is where durable
          execution and a human in the loop stopped being abstractions to me. That belief is
          load-bearing in what runs here: <a href="/steward/">the agent that reviews and publishes
          this site</a> waits for me to approve a draft before anything ships.
        </p>
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-true">
      <h2 id="about-true">Some things that are true</h2>
      <div class="prose">
        <ul>
          <li>I am not a professional engineer, and nothing here pretends otherwise.</li>
          <li>Good coffee, taken seriously.</li>
          <li>The question behind most of this is “why does this actually work?”</li>
        </ul>
      </div>
    </section>

    <hr class="about-divider" />

    <section class="about-section about-section--hello" aria-labelledby="about-hello">
      <h2 id="about-hello">Say hello</h2>
      {/*
        The 2px gap over a rule-coloured ground draws the hairlines between the
        cards, so there is one border rather than four that have to line up.
      */}
      <div class="reach">
        {REACH.map(item => (
          <a
            class="reach-card"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <svg class="reach-icon" viewBox={item.viewBox} aria-hidden="true" focusable="false">
              <path fill="currentColor" d={item.path} />
            </svg>
            <span class="reach-text">
              <span class="reach-label">{item.label}</span>
              <span class="reach-detail">{item.detail}</span>
            </span>
            {item.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </div>
      <p class="reach-note">
        No newsletter, no calendar link, nothing for sale. If you write to me about the site I will
        probably write back about the site.
      </p>
    </section>
  </div>

  <aside class="rail" aria-label="Matt Pyle at a glance">
    <img
      class="rail-photo"
      src="/matt-pyle-headshot.jpg"
      alt="Matt Pyle"
      width="520"
      height="650"
      loading="eager"
    />
    <p class="rail-caption">Growth by trade. Hobbyist builder otherwise.</p>
    <hr class="rail-divider" />
    <div class="rail-facts">
      <div class="rail-fact">
        <span class="rail-label">day job</span>
        <span class="rail-value">Director of Growth, Temporal Technologies</span>
      </div>
      <div class="rail-fact">
        <span class="rail-label">writing here since</span>
        <span class="rail-value">July 2026</span>
      </div>
      {markdownUrl && (
        <div class="rail-fact">
          <span class="rail-label">this page as data</span>
          <a class="rail-md" href={markdownUrl}>about.md</a>
        </div>
      )}
    </div>
  </aside>
</div>

<style>
  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 68ch) 300px;
    gap: 72px;
    align-items: start;
    padding-block: 64px 0;
  }

  .reading {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-section--hello { gap: 22px; }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -.025em;
    color: var(--ink);
    scroll-margin-top: 110px;
  }

  /* The `.prose` overlay in global.css paints links in WRITING blue, because it
     was written for the post page. The full guard is repeated here for the same
     reason the changelog entry page repeats it: the overlay's selector is
     (0,3,2), and anything shorter loses to it silently. */
  html:not([data-appearance='retro']) body.skin-redesign .prose :global(a) {
    color: var(--agents);
    text-decoration-color: var(--rule);
  }

  html:not([data-appearance='retro']) body.skin-redesign .prose :global(a:hover) {
    color: var(--agents-hover);
    text-decoration-color: currentColor;
  }

  .about-aside {
    margin: 0;
    padding: 22px 26px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--agents);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 21px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about-divider {
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--rule);
  }

  .reach {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .reach-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 22px;
    background: var(--surface);
    transition: background 240ms ease;
  }

  .reach-card:hover { background: var(--tint-agents); }

  .reach-icon {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--agents);
  }

  .reach-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .reach-label {
    font-family: var(--font-mono-plex);
    font-size: 19px;
    color: var(--agents);
  }

  .reach-detail {
    font-size: 17px;
    color: var(--ink-6);
  }

  .reach-note {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-6);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 40px;
  }

  .rail-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 15%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .rail-caption {
    margin: 0;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-6);
  }

  .rail-divider {
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--rule);
  }

  .rail-facts {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rail-fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rail-label {
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-6);
  }

  .rail-value {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
  }

  .rail-md {
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--agents);
  }

  .rail-md:hover { color: var(--agents-hover); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The rail un-sticks and moves below the reading column at the same width the
     hero row collapses, so the two bands never disagree about how many columns
     the page has. */
  @media (max-width: 1000px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-block: 48px 0;
    }

    .rail {
      position: static;
      max-width: 300px;
    }
  }

  @media (max-width: 720px) {
    .about-body { padding-block: 36px 0; }

    h2 { font-size: 26px; }

    .about-aside {
      padding: 18px 20px;
      font-size: 19px;
    }

    .reach { grid-template-columns: 1fr; }

    /* 44px tap targets, per the mobile spec. The cards already clear it; the
       rail's one link does not. */
    .rail-md {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
    }
  }
</style>

---
interface Entry {
  id: string;
  data: {
    title: string;
    summary: string;
    date: Date;
    type: string;
    significance: 'major' | 'minor' | 'patch';
    tags: string[];
  };
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

// The sig-dot is a colour-only signal and stays aria-hidden, so every consumer without the
// stylesheet — screen readers, the markdown rendering — gets the significance as text on the
// row instead. Same wording as ActivityLog on the homepage, which solved this first.
function significanceLabel(significance: Entry['data']['significance']): string {
  return `${significance[0].toUpperCase()}${significance.slice(1)} significance.`;
}

function formatDate(date: Date): string {
  const d = date.getUTCDate().toString().padStart(2, '0');
  const m = date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
  const y = date.getUTCFullYear();
  return `${d} ${m} ${y}`;
}

// Entries arrive newest-first (already sliced to the current page); group them by
// year, preserving that order. A year that spans a page boundary simply repeats its
// rule on the next page — expected.
const groups: { year: number; items: Entry[] }[] = [];
for (const entry of entries) {
  const year = entry.data.date.getUTCFullYear();
  const group = groups.at(-1);
  if (group && group.year === year) group.items.push(entry);
  else groups.push({ year, items: [entry] });
}
---

<div data-module="changelog-ledger">
  {groups.length === 0 ? (
    <p class="empty-state">No changelog entries yet.</p>
  ) : (
    groups.map(group => (
      <>
        <div class="year-rule">
          <span class="year-label">{group.year}</span>
          <span class="year-line" aria-hidden="true"></span>
        </div>
        {group.items.map(entry => (
          <a href={`/changelog/${entry.id}/`} class="lg-row" data-type={entry.data.type}>
            <div class="lg-when">
              <span class={`sig-dot sig-dot--${entry.data.significance}`} aria-hidden="true"></span>
              <span class="lg-date">{formatDate(entry.data.date)}</span>
              <span class="sr-only">{significanceLabel(entry.data.significance)}</span>
            </div>
            <div class="lg-main">
              <h2 class="lg-title">{entry.data.title}</h2>
              <p class="lg-summary">{entry.data.summary}</p>
            </div>
            {/* One copy, placed by CSS: third grid column on desktop, trailing child of the
                stack on mobile. Two copies differing only by a display rule read as duplicate
                tag rows to anything without the stylesheet. The pills are bare words out of
                context ("feature agents webmcp"), so each run gets a visually hidden label. */}
            <div class="lg-tags">
              <span class="sr-only">Type:</span>
              <span class="type-pill">{entry.data.type}</span>
              {entry.data.tags.length > 0 && <span class="sr-only">Tags:</span>}
              {entry.data.tags.map(tag => <span class="tag-pill">{tag}</span>)}
            </div>
          </a>
        ))}
      </>
    ))
  )}
</div>

<script>
  // Filtering the type FilterPills on the changelog page hides individual .lg-row
  // entries; without this, a year whose entries are all filtered out would leave a
  // bare year-rule divider with nothing under it. Listens generically for the event
  // FilterPills.astro dispatches rather than FilterPills knowing about year groups.
  document.addEventListener('astro:page-load', () => {
    const ledger = document.querySelector('[data-module="changelog-ledger"]');
    if (!ledger) return;

    document.addEventListener('filterchange', ((e: CustomEvent<{ itemSelector: string }>) => {
      if (e.detail.itemSelector !== '[data-module="changelog-ledger"] .lg-row') return;
      ledger.querySelectorAll<HTMLElement>('.year-rule').forEach(rule => {
        let node = rule.nextElementSibling;
        let hasVisibleRow = false;
        while (node && !node.classList.contains('year-rule')) {
          if (node.classList.contains('lg-row') && !(node as HTMLElement).hidden) hasVisibleRow = true;
          node = node.nextElementSibling;
        }
        rule.hidden = !hasVisibleRow;
      });
    }) as EventListener);
  });
</script>

<style>
  /* ── Year rule ──────────────────────────────────────────────────────────── */
  .year-rule {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0 8px;
  }

  .year-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .14em;
    font-weight: 600;
    color: var(--color-heading);
  }

  .year-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Row ────────────────────────────────────────────────────────────────── */
  .lg-row {
    display: grid;
    grid-template-columns: 132px 1fr auto;
    gap: 0 20px;
    align-items: start;
    padding: 13px 12px;
    margin: 0 -12px;
    border-radius: 6px;
    text-decoration: none;
    transition: background .12s ease;
  }

  /* The explicit `display: grid` above otherwise beats the browser's [hidden]
     UA rule at equal specificity, since author styles always win over UA
     styles — without this, FilterPills setting .hidden on a row wouldn't
     actually hide it. */
  .lg-row[hidden] {
    display: none;
  }

  .lg-row:hover { background: var(--color-accent-wash); }
  .lg-row:hover .lg-title { color: var(--color-accent); }

  .lg-when {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 3px;
  }

  .sig-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }

  .sig-dot--major { background: var(--color-sig-major); }
  .sig-dot--minor { background: var(--color-sig-minor); }
  .sig-dot--patch { background: var(--color-sig-patch); }

  .lg-date {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .06em;
    color: var(--color-label);
    white-space: nowrap;
  }

  .lg-main { min-width: 0; }

  .lg-title {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-heading);
    transition: color .12s ease;
    margin: 0;
  }

  .empty-state {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--color-muted);
    margin: 0;
    padding: 24px 0;
  }

  .lg-summary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 3px 0 0;
  }

  /* ── Tag cluster ────────────────────────────────────────────────────────── */
  /* Desktop: the row's third grid column, right-aligned against the gutter. */
  .lg-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
    max-width: 220px;
    padding-top: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .type-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-tint);
    border: 1px solid rgba(122, 46, 46, .25);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-label);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* ── Mobile: 3-col grid → stacked flex ──────────────────────────────────── */
  @media (max-width: 600px) {
    /* The stack spaces its children with margins rather than a row `gap` because the
       tag cluster sits closer to the summary (2px) than the summary block does to the
       date (9px) — the spacing the two-copy layout got from the cluster living inside
       .lg-main. */
    .lg-row {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 15px 12px;
    }

    .lg-when { padding-top: 0; }
    .lg-main { margin-top: 9px; }

    .lg-tags {
      justify-content: flex-start;
      max-width: none;
      padding-top: 0;
      margin-top: 2px;
    }
  }
</style>

---
/**
 * The post page's sticky rail (docs/projects/redesign/design-export/README.md §4).
 *
 * Three blocks separated by hairlines: the date and read time, the in-page
 * contents built from the article's own h2s, and four actions.
 *
 * The contents links are plain anchors — the spec is explicit that the landing
 * position comes from `scroll-margin-top` on the headings, not from JS. The one
 * script here is the copy button, which cannot be anything else.
 *
 * NOT SHIPPED: the spec's provenance panel at the foot of the article. Cut by
 * Matt on 2026-08-20 along with the /writing "Steward is holding one draft"
 * panel; both would have to be driven from real review state.
 *
 * SHOWN IN BOTH APPEARANCES since 2026-08-29. Its four actions are the only
 * copy of them on the page now that the legacy ArticleActions section is
 * deleted, so it can no longer be hidden in retro. Retro restyles this same
 * markup under `html[data-appearance='retro'] [data-module='article']` in
 * retro.css; that prefix is what outweighs the Astro-scoped selectors below,
 * whose `[data-astro-cid-…]` counts as a class.
 */
import { formatSiteDate } from '../../lib/format-date.mjs';
import { chatGptUrl, claudeUrl } from '../../lib/article-actions.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  date: Date;
  readingLabel: string;
  headings: Heading[];
  markdownUrl: string;
  canonicalUrl: string;
}

const { date, readingLabel, headings, markdownUrl, canonicalUrl } = Astro.props;

// h2 only. h3s would make the rail a nested outline, and the design's rail is a
// flat list of the article's sections.
const contents = headings.filter(heading => heading.depth === 2);
---

<aside class="post-rail" aria-labelledby="post-rail-title">
  <h2 id="post-rail-title" class="sr-only">About this post</h2>

  <div class="rail-block rail-meta">
    <time datetime={date.toISOString()}>{formatSiteDate(date)}</time>
    <span>{readingLabel}</span>
  </div>

  {contents.length > 0 && (
    <nav class="rail-block rail-contents" aria-label="On this page">
      {contents.map(heading => (
        <a href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </nav>
  )}

  <div class="rail-block rail-actions">
    <a href={markdownUrl} class="rail-action">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 3v5h5"></path>
      </svg>
      <span>view markdown</span>
    </a>

    {/*
      Disabled in the markup and armed by the script below, so a visitor with no
      JS is never offered a control that cannot work. The status paragraph is the
      failure path: the label swap alone is invisible to a screen reader that has
      moved on from the button.
    */}
    <button
      type="button"
      class="rail-action"
      disabled
      data-rail-copy
      data-markdown-url={markdownUrl}
      aria-describedby="rail-copy-status"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M15 5H5a2 2 0 0 0-2 2v10"></path>
      </svg>
      <span data-rail-copy-label>copy markdown</span>
    </button>

    <a href={chatGptUrl(canonicalUrl)} class="rail-action" target="_blank" rel="noopener noreferrer">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M21 12a8 8 0 0 1-8 8H8l-5 3 1.5-5A8 8 0 1 1 21 12z"></path>
      </svg>
      <span>ask chatgpt<span class="sr-only"> (opens in a new tab)</span></span>
    </a>

    <a href={claudeUrl(canonicalUrl)} class="rail-action" target="_blank" rel="noopener noreferrer">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3v18"></path>
        <path d="M4.5 7.5l15 9"></path>
        <path d="M19.5 7.5l-15 9"></path>
      </svg>
      <span>ask claude<span class="sr-only"> (opens in a new tab)</span></span>
    </a>

    <p id="rail-copy-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</aside>

<script>
  /**
   * The copy button. It fetches the post's markdown sibling rather than scraping
   * the rendered article, so what lands on the clipboard is the same bytes an
   * agent gets from `Accept: text/markdown` — the point of the action.
   *
   * Re-armed on `astro:page-load` because the ClientRouter swaps documents
   * without re-running module scripts, and guarded by a dataset flag so a second
   * run does not bind a second click listener to the same button.
   */
  const CONFIRM_MS = 1800;

  function initializePostRail() {
    document.querySelectorAll<HTMLButtonElement>('[data-rail-copy]').forEach(button => {
      if (button.dataset.railCopyReady === 'true') return;

      const statusId = button.getAttribute('aria-describedby');
      const status = statusId ? document.getElementById(statusId) : null;
      const markdownUrl = button.dataset.markdownUrl;
      if (!status || !markdownUrl) return;

      button.dataset.railCopyReady = 'true';
      button.disabled = false;

      const label = button.querySelector<HTMLElement>('[data-rail-copy-label]');
      const defaultLabel = label?.textContent ?? 'copy markdown';
      let resetTimer: number | undefined;

      const setTemporaryLabel = (text: string) => {
        if (!label) return;
        if (resetTimer !== undefined) window.clearTimeout(resetTimer);
        label.textContent = text;
        resetTimer = window.setTimeout(() => {
          label.textContent = defaultLabel;
          resetTimer = undefined;
        }, CONFIRM_MS);
      };

      button.addEventListener('click', async () => {
        status.textContent = '';

        try {
          const response = await fetch(markdownUrl, { headers: { Accept: 'text/markdown' } });
          const contentType = response.headers.get('content-type') ?? '';

          if (!response.ok || !contentType.toLowerCase().startsWith('text/markdown')) {
            throw new Error('Markdown endpoint returned an unexpected response.');
          }
          if (!navigator.clipboard?.writeText) {
            throw new Error('Clipboard API is unavailable.');
          }

          await navigator.clipboard.writeText(await response.text());
          setTemporaryLabel('copied ✓');
          status.textContent = 'Markdown copied.';
        } catch {
          setTemporaryLabel('copy failed');
          status.textContent = 'Could not copy Markdown. Open view markdown and copy it manually.';
        }
      });
    });
  }

  initializePostRail();
  document.addEventListener('astro:page-load', initializePostRail);
</script>

<style>
  .post-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    /* A pinned block taller than the window is a block whose bottom you cannot
       reach: at a 560px window height the rail's last two actions sat below the
       fold and stayed there, because sticky does not release until the article
       ends. Measured on the served build. Capping it makes the overflow scroll
       inside the rail instead.

       No `tabindex` on the container, deliberately. axe's scrollable-region
       rule asks for one only when a scroll container has no focusable children;
       this one is nothing but links and a button, and focusing any of them
       scrolls it into view — so the keyboard reaches everything without a tab
       stop on a wrapper. `dvh` first for the mobile toolbar, `vh` behind it. */
    max-height: calc(100vh - 120px);
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .rail-block {
    display: flex;
    flex-direction: column;
  }

  .rail-block + .rail-block {
    border-top: 1px solid var(--rule);
    padding-top: 20px;
  }

  .rail-meta {
    gap: 8px;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .rail-contents { gap: 10px; }

  .rail-contents a {
    font-size: 17px;
    line-height: 1.4;
    color: var(--ink-5);
    text-wrap: pretty;
  }

  .rail-contents a:hover { color: var(--writing); }

  .rail-actions { gap: 14px; }

  .rail-action {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono-plex);
    font-size: 16px;
    color: var(--agents);
    /* The button has to be told; the anchors inherit it. */
    background: none;
    border: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
    transition: color 240ms ease;
  }

  .rail-action:hover:not(:disabled) { color: var(--agents-hover); }

  .rail-action:disabled {
    opacity: .55;
    cursor: not-allowed;
  }

  .rail-action svg { flex: none; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Below the two-column breakpoint the rail is no longer a rail: it sits above
     the article as a block of metadata. `position: static` is the important half
     — a sticky element in a single-column flow pins a tall block over the text
     as you scroll past it, which is exactly the failure the short-viewport check
     in the handoff is asking about. */
  @media (max-width: 900px) {
    .post-rail {
      position: static;
      gap: 20px;
      /* Nothing to cap in a single column: the rail is a block of metadata above
         the article and scrolls with it. */
      max-height: none;
      overflow: visible;
    }

    .rail-contents {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 4px 24px;
    }

    /* 44px tap targets on every small link, per the mobile spec. */
    .rail-contents a,
    .rail-action {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>

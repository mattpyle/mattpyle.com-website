---
/**
 * The fix entry's rail: facts, the pull requests that made the change, and the way to the
 * markdown twin. The writing post's rail (PostRail.astro) at a smaller scope, with its class
 * names, so retro dresses it from the rules the post rail already has.
 *
 * What differs from the post rail: no byline, read time, contents list or other actions. The
 * facts are a `dl` whose visible `dt` words name each value, and there is no status fact. Each
 * pull request link carries the GitHub mark, and its title sits under it.
 */
import { FIX_AREA_LABEL, FIX_DATE_LABEL, TYPE_LABEL, fixDate, prUrl, type Fix } from '../../lib/fix-log';

interface Props {
  verified: Date;
  type: Fix['data']['type'];
  changes: Fix['data']['changes'];
  markdownUrl: string;
}

const { verified, type, changes, markdownUrl } = Astro.props;
---

<aside class="post-rail fix-rail" aria-labelledby="fix-rail-title">
  <h2 id="fix-rail-title" class="sr-only">About this fix</h2>

  <dl class="rail-block rail-meta">
    <div class="fact"><dt>{FIX_DATE_LABEL}</dt><dd><time datetime={verified.toISOString()}>{fixDate(verified)}</time></dd></div>
    <div class="fact"><dt>{FIX_AREA_LABEL}</dt><dd class="fact-area">{TYPE_LABEL[type]}</dd></div>
  </dl>

  <div class="rail-block rail-changes">
    {changes.map((change) => (
      <a href={prUrl(change.number)} class="change">
        <span class="rail-action">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <span>PR {change.number}</span>
        </span>
        <span class="change-title">{change.title}</span>
      </a>
    ))}
  </div>

  <div class="rail-block rail-actions">
    <a href={markdownUrl} class="rail-action">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 3v5h5"></path>
      </svg>
      <span>view markdown</span>
    </a>
  </div>
</aside>

<style>
  .post-rail {
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
  }

  .rail-block {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .rail-block + .rail-block {
    border-top: 1px solid var(--rule);
    padding-top: 20px;
  }

  .rail-meta {
    gap: 8px;
    font-family: var(--font-mono-plex);
    font-size: 17px;
    color: var(--ink-6);
  }

  .fact { display: flex; flex-wrap: wrap; gap: 10px; }
  .fact dd { margin: 0; }
  .fact-area { color: var(--changelog); }

  .rail-changes { gap: 16px; }

  .change { display: flex; flex-direction: column; gap: 4px; min-width: 0; }

  .change-title {
    padding-left: 27px;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-5);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .rail-action {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono-plex);
    font-size: 16px;
    color: var(--agents);
    transition: color 240ms ease;
  }

  .change:hover .rail-action,
  a.rail-action:hover { color: var(--agents-hover); }

  .rail-action svg { flex: none; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .rail-meta { flex-direction: row; flex-wrap: wrap; gap: 4px 24px; }
  }

  @media (max-width: 720px) {
    .post-rail { gap: 20px; }
    .rail-meta { font-size: 16px; }
    .change-title { font-size: 15px; }
    a.rail-action { min-height: 44px; }
  }
</style>

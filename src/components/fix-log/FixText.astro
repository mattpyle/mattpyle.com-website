---
/**
 * One side of a changed text, shown as the thing itself: the lines of a file, the words a
 * screen reader spoke, or the gap where something was missing.
 *
 * Before and after use this one frame. The name above the frame and the position (before
 * left, after right) tell them apart, never colour, and nothing is struck through. On the
 * after side, a line the fix added is set in full ink and bold.
 */
import type { Fix } from '../../lib/fix-log';

type Specimen = NonNullable<Fix['data']['text']>['before'];

interface Props {
  specimen: Specimen;
  name: 'Before' | 'After';
}

const { specimen, name } = Astro.props;
---

<figure class="fix-text">
  <figcaption class="fix-text-name">{name}</figcaption>
  <div class="fix-text-frame">
    <span class="fix-text-file">{specimen.label}</span>
    {specimen.kind === 'lines' && (
      <pre class="fix-text-lines" tabindex="0"><code>{specimen.lines.map((line) => (
        <span class:list={['fix-text-line', name === 'After' && line.mark === 'added' && 'fix-text-line--added']}>{line.text}</span>
      ))}</code></pre>
    )}
    {specimen.kind === 'spoken' && (
      <p class="fix-text-spoken">{specimen.words.map((w, i) => <span>“{w}”{i < specimen.words.length - 1 ? ', ' : ''}</span>)}</p>
    )}
    {specimen.kind === 'missing' && <p class="fix-text-missing">{specimen.text}</p>}
  </div>
</figure>

<style>
  .fix-text { margin: 0; min-width: 0; display: flex; flex-direction: column; }

  .fix-text-name {
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .fix-text-frame {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 20px 20px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    min-width: 0;
  }

  .fix-text-file {
    align-self: flex-start;
    max-width: 100%;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--track);
    font-family: var(--font-mono-plex);
    font-size: 15px;
    color: var(--ink-4);
    overflow-wrap: anywhere;
  }

  .fix-text-lines {
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono-plex);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-4);
  }

  .fix-text-lines code { display: flex; flex-direction: column; font: inherit; }
  .fix-text-line { white-space: pre-wrap; overflow-wrap: anywhere; }
  .fix-text-line--added { color: var(--ink); font-weight: 600; }

  .fix-text-spoken {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .fix-text-missing {
    margin: 0;
    padding: 16px;
    border: 1px dashed var(--ink-6);
    border-radius: 4px;
    font-size: 16px;
    text-align: center;
    color: var(--ink-5);
  }

  @media (max-width: 720px) {
    .fix-text-name { font-size: 16px; margin-bottom: 6px; }
    .fix-text-frame { padding: 14px; }
    .fix-text-spoken { font-size: 18px; }
  }
</style>

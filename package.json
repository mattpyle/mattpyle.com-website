{
  "name": "mattpyle-com",
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "agents/steward"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/generate-og-images.mjs && node scripts/generate-a2a-digest.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/generate-og-images.mjs && node scripts/generate-a2a-digest.mjs",
    "build": "astro build && node scripts/emit-markdown-siblings.mjs && node scripts/assert-no-drafts.mjs && node scripts/validate-sitemap.mjs && node scripts/validate-article-actions.mjs && node scripts/validate-csp-hashes.mjs && node scripts/validate-a2a-card.mjs && node scripts/validate-markdown-siblings.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "a11y": "npm run build && playwright test",
    "a11y:run": "playwright test",
    "a11y:axe": "axe",
    "spellcheck": "cspell --no-progress \"src/content/**/*.md\"",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:steward": "npm test --workspace @mattpyle/steward",
    "check:steward": "npm run typecheck --workspace @mattpyle/steward",
    "validate:sitemap": "node scripts/validate-sitemap.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.5",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/cli": "^4.12.1",
    "@axe-core/playwright": "^4.12.1",
    "@mixmark-io/domino": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "cspell": "^10.0.1",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.2.0",
    "fontkit": "^2.0.4",
    "serve": "^14.2.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.10",
    "wawoff2": "^2.0.1"
  }
}
